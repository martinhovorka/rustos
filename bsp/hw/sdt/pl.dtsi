			xlnx,pmp-read-only = <0x0>;
		};
	};
	clock: clocks {
		#address-cells = <1>;
		#size-cells = <0>;
		clk_cpu_0: clk_cpu@0 {
			compatible = "fixed-clock";
			reg = <0>;
			clock-frequency = <75000000>;
			clock-output-names = "clk_cpu";
			#clock-cells = <0>;
		};
		clk_bus_0: clk_bus_0@1 {
			compatible = "fixed-clock";
			reg = <1>;
			clock-frequency = <75000000>;
			clock-output-names = "clk_bus_0";
			#clock-cells = <0>;
		};
	};
	amba_pl: amba_pl {
		ranges;
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		mbv_axi_interrupt_controller: interrupt-controller@41200000 {
			#interrupt-cells = <2>;
			xlnx,sense-of-irq-edge-type = "Rising";
			xlnx,edk-special = "INTR_CTRL";
			xlnx,kind-of-intr = <0x30c>;
			xlnx,kind-of-edge = <0xffffffff>;
			xlnx,irq-is-level = <1>;
			xlnx,has-ivr = <1>;
			compatible = "xlnx,axi-intc-4.1" , "xlnx,xps-intc-1.00.a";
			xlnx,disable-synchronizers = <1>;
			xlnx,kind-of-lvl = <0xffffffff>;
			xlnx,ivar-reset-value = <0x10>;
			xlnx,irq-active = <0x1>;
			xlnx,en-cascade-mode = <0>;
			xlnx,ip-name = "axi_intc";
			xlnx,has-ilr = <0>;
			reg = <0x41200000 0x10000>;
			xlnx,addr-width = <0x20>;
			xlnx,s-axi-aclk-freq-mhz = <75>;
			xlnx,num-sw-intr = <0>;
			xlnx,irq-connection = <0>;
			xlnx,num-intr-inputs = <0xb>;
			xlnx,has-sie = <1>;
			xlnx,enable-async = <0>;
			xlnx,has-cie = <1>;
			xlnx,num-sync-ff = <2>;
			xlnx,edk-iptype = "PERIPHERAL";
			xlnx,mb-clk-not-connected = <1>;
			xlnx,has-ipr = <1>;
			xlnx,sense-of-irq-level-type = "Active_High";
			xlnx,cascade-master = <0>;
			xlnx,processor-clk-freq-mhz = <75>;
			status = "okay";
			xlnx,is-fast = <0x1>;
			xlnx,has-fast = <1>;
			xlnx,ivar-rst-val = <0x10>;
			interrupt-controller;
			xlnx,async-intr = <0xfffff900>;
			xlnx,name = "mbv_axi_interrupt_controller";
		};
		mbv_axi_ethernetlite: ethernet@40e00000 {
			interrupts = < 8 0 >;
			xlnx,select-xpm = <1>;
			compatible = "xlnx,axi-ethernetlite-3.0" , "xlnx,axi-ethernetlite-3.0" , "xlnx,xps-ethernetlite-1.00.a";
			xlnx,duplex = <1>;
			xlnx,include-mdio = <1>;
			xlnx,enable-constraints = <1>;
			interrupt-parent = <&mbv_axi_interrupt_controller>;
			xlnx,rx-ping-pong = <1>;
			xlnx,ip-name = "axi_ethernetlite";
			xlnx,tx-ping-pong = <1>;
			reg = <0x40e00000 0x10000>;
			xlnx,mii-board-interface = "eth_mii";
			xlnx,mdio-board-interface = "eth_mdio_mdc";
			xlnx,edk-iptype = "PERIPHERAL";
			xlnx,include-global-buffers = <1>;
			local-mac-address = [ 00 0a 23 00 00 00 ];
			status = "okay";
			xlnx,include-internal-loopback = <0>;
			xlnx,use-board-flow;
			xlnx,use-internal = <0>;
			interrupt-names = "ip2intc_irpt";
			xlnx,name = "mbv_axi_ethernetlite";
			xlnx,axi-aclk-freq-mhz = <75>;
			xlnx,s-axi-id-width = <1>;
			mbv_axi_ethernetlite_mdio: mdio {
				#address-cells = <1>;
				#size-cells = <0>;
			};
		};
		mbv_axi_gpio_dip_switches: gpio@40030000 {
			#interrupt-cells = <2>;
			interrupts = < 7 2 >;
			xlnx,gpio-board-interface = "dip_switches_4bits";
			compatible = "xlnx,axi-gpio-2.0" , "xlnx,xps-gpio-1.00.a";
			xlnx,all-outputs = <0>;
			#gpio-cells = <2>;
			xlnx,gpio-width = <4>;
			clock-frequency = <75000000>;
			interrupt-parent = <&mbv_axi_interrupt_controller>;
			xlnx,dout-default = <0x0>;
			xlnx,is-dual = <0>;
			xlnx,ip-name = "axi_gpio";
			xlnx,tri-default-2 = <0xffffffff>;
			reg = <0x40030000 0x10000>;
			xlnx,all-inputs-2 = <0>;
			clocks = <&clk_bus_0>;
			xlnx,all-outputs-2 = <0>;
			gpio-controller;
			xlnx,interrupt-present = <1>;
			xlnx,gpio2-board-interface = "Custom";
			xlnx,edk-iptype = "PERIPHERAL";
			xlnx,dout-default-2 = <0x0>;
			status = "okay";
			xlnx,gpio2-width = <32>;
			clock-names = "s_axi_aclk";
			xlnx,use-board-flow;
			interrupt-controller;
			interrupt-names = "ip2intc_irpt";
			xlnx,tri-default = <0xffffffff>;
			xlnx,name = "mbv_axi_gpio_dip_switches";
			xlnx,all-inputs = <1>;
		};
		mbv_axi_gpio_iic_pullups: gpio@40060000 {
			xlnx,gpio-board-interface = "i2c_pullups";
			compatible = "xlnx,axi-gpio-2.0" , "xlnx,xps-gpio-1.00.a";
			xlnx,all-outputs = <1>;
			#gpio-cells = <2>;
			xlnx,gpio-width = <2>;
			clock-frequency = <75000000>;
			xlnx,dout-default = <0x0>;
			xlnx,is-dual = <0>;
			xlnx,ip-name = "axi_gpio";
			xlnx,tri-default-2 = <0xffffffff>;
			reg = <0x40060000 0x10000>;
			xlnx,all-inputs-2 = <0>;
			clocks = <&clk_bus_0>;
			xlnx,all-outputs-2 = <0>;
			gpio-controller;
			xlnx,interrupt-present = <0>;
			xlnx,gpio2-board-interface = "Custom";
			xlnx,edk-iptype = "PERIPHERAL";
			xlnx,dout-default-2 = <0x0>;
			status = "okay";
			xlnx,gpio2-width = <32>;
			clock-names = "s_axi_aclk";
			xlnx,use-board-flow;
			xlnx,tri-default = <0xffffffff>;
			xlnx,name = "mbv_axi_gpio_iic_pullups";
			xlnx,all-inputs = <0>;
		};
		mbv_axi_gpio_led_4_bits: gpio@40040000 {
			xlnx,gpio-board-interface = "led_4bits";
			compatible = "xlnx,axi-gpio-2.0" , "xlnx,xps-gpio-1.00.a";
			xlnx,all-outputs = <1>;
