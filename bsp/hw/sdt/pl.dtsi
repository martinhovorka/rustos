			xlnx,all-inputs = <0>;
		};
		mbv_axi_gpio_push_buttons: gpio@40020000 {
			#interrupt-cells = <2>;
			interrupts = < 6 2 >;
			xlnx,gpio-board-interface = "push_buttons_4bits";
			compatible = "xlnx,axi-gpio-2.0" , "xlnx,xps-gpio-1.00.a";
			xlnx,all-outputs = <0>;
