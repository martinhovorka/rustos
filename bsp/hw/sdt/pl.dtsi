		mbv_axi_gpio_shield_pins_0_19: gpio@40000000 {
			#interrupt-cells = <2>;
			interrupts = < 4 2 >;
			xlnx,gpio-board-interface = "shield_dp0_dp19";
			compatible = "xlnx,axi-gpio-2.0" , "xlnx,xps-gpio-1.00.a";
			xlnx,all-outputs = <0>;
			#gpio-cells = <2>;
			xlnx,gpio-width = <20>;
			clock-frequency = <75000000>;
			interrupt-parent = <&mbv_axi_interrupt_controller>;
			xlnx,dout-default = <0x0>;
			xlnx,is-dual = <0>;
