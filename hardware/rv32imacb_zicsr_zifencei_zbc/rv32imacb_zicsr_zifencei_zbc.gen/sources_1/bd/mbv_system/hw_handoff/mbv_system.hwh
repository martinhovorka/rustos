    <MODULE COREREVISION="37" FULLNAME="/mbv_axi_gpio_dip_switches" HWVERSION="2.0" INSTANCE="mbv_axi_gpio_dip_switches" IPTYPE="PERIPHERAL" IS_ENABLE="1" MODCLASS="PERIPHERAL" MODTYPE="axi_gpio" VLNV="xilinx.com:ip:axi_gpio:2.0">
