  <MODULES>
    <MODULE COREREVISION="36" FULLNAME="/mbv_axi_ethernetlite" HWVERSION="3.0" INSTANCE="mbv_axi_ethernetlite" IPTYPE="PERIPHERAL" IS_ENABLE="1" MODCLASS="PERIPHERAL" MODTYPE="axi_ethernetlite" VLNV="xilinx.com:ip:axi_ethernetlite:3.0">
