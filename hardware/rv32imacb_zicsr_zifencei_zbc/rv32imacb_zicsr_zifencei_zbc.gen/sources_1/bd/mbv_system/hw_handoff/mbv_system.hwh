        <PARAMETER NAME="PARITY" VALUE="No_Parity"/>
        <PARAMETER NAME="UARTLITE_BOARD_INTERFACE" VALUE="usb_uart"/>
        <PARAMETER NAME="USE_BOARD_FLOW" VALUE="true"/>
