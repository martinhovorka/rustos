        </PORT>
        <PORT DIR="O" NAME="phy_mdio_o" SIGIS="undef" SIGNAME="mbv_axi_ethernetlite_phy_mdio_o">
          <CONNECTIONS>
            <CONNECTION INSTANCE="mbv_system_imp" PORT="eth_mdio_mdc_mdio_o"/>
