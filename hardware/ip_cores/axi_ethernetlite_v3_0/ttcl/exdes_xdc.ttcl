##create_clock -name clk_p -period 5.0 [get_ports clk_p]

################################ Waivers #################################
create_waiver -type CDC -id {CDC-10} -user "axi_ethernetlite" -desc "The CDC-10 warning is waived because it is safe to ignore"\
 -tags "11999" -from [get_pins -of [get_cells -hier -filter {name =~ CLK_GEN/inst/*}] -filter {name =~ *CLKOUT*}] -to [get_pins -of [get_cells -hier -filter {name =~ */EMAC_I/CDC_TX_CLK/syncstages_ff_reg*}] -filter {name =~ *D}]

create_waiver -type CDC -id {CDC-11} -user "axi_ethernetlite" -desc "The CDC-10 warning is waived because it is safe to ignore"\
 -tags "11999" -from [get_pins -of [get_cells -hier -filter {name =~ CLK_GEN/inst/*}] -filter {name =~ *CLKOUT*}] -to [get_pins -of [get_cells -hier -filter {name =~ */EMAC_I/CDC_TX_CLK/syncstages_ff_reg*}] -filter {name =~ *D}]

create_waiver -type CDC -id {CDC-10} -user "axi_ethernetlite" -desc "This is sustaining IP so there is no core level change hence waived" -tags "11999" -from [get_pins -of [get_cells -hier -filter {name =~ */XEMAC_I/EMAC_I/COLLISION_SYNC_2}] -filter {name =~ *C}] -to [get_pins -of [get_cells -hier -filter {name =~ */U0/CDC_PHY_TX_DATA_OUT/syncstages_ff_reg[0][*]}] -filter {name =~ *D}]

create_waiver -type CDC -id {CDC-10} -user "axi_ethernetlite" -desc "This is sustaining IP so there is no core level change hence waived" -tags "11999" -from [get_pins -of [get_cells -hier -filter {name =~ */XEMAC_I/EMAC_I/COLLISION_SYNC_2}] -filter {name =~ *C}] -to [get_pins -of [get_cells -hier -filter {name =~ */U0/CDC_PHY_TX_EN_O/syncstages_ff_reg[0]}] -filter {name =~ *D}]


