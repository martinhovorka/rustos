<: set axi_p [get_property PARAM_VALUE.C_S_AXI_PROTOCOL] :>
<: if {$axi_p == "AXI4"} { :> 
<: set deliver true :>
<: } else { :>
<: set deliver false :>
<: } :>
<: if {!$deliver} {ttcl_return;} :>
<: set ComponentName [getComponentNameString] :>
<: set en_mdio [get_property MODELPARAM_VALUE.C_INCLUDE_MDIO] :>
<: set en_bufg [get_property MODELPARAM_VALUE.C_INCLUDE_GLOBAL_BUFFERS] :>
<: set en_loop [get_property PARAM_VALUE.C_INCLUDE_INTERNAL_LOOPBACK] :>
<: set id_wid [get_property PARAM_VALUE.C_S_AXI_ID_WIDTH] :>
<: if {$id_wid != 0} { :>
<: set id_w [expr {$id_wid - 1}] :>
<: if {$id_wid <= 6} { :>
<: set id_atg [expr {$id_wid - 1}] :>
<: } else { :>
<: set id_atg 5 :>
<: } :>
<: } else { :>
<: set id_w $id_wid :>
<: set id_atg $id_wid :>
<: } :>
<: if {$id_wid >= 7} { :>
<: set mat_wid [expr {$id_wid - 7}]:>
<: } :>
<: setOutputDirectory [ttcl_string_concat $ComponentName "/example_design"] :>
<: setFileName [ttcl_string_concat $ComponentName "_exdes"] :>
<: set wd [ file dirname [ get_property xml_file_name [ current_ipbom ] ] ] :>
<: setFileExtension ".vhd" :>
