<: ;#------------------------ :>
<: ;#specific core variables :>
<: ;#------------------------ :>
<: ;#Overall selections :>
<: ;#----------------------- :>
<:proc dec2bin_wid {i {width {}}} { :>
<:    set ares {}  :>
<:    if {$i<0} { :>
<:       set sign - :>
<:        set i [expr {abs($i)}] :>
<:    } else { :>
<:        set sign {} :>
<:    } :>
<:    while {$i>0} { :>
<:        set ares [expr {$i%2}]$ares :>
<:        set i [expr {$i/2}] :>
<:    } :>
<:    if {$ares == {}} {set ares 0} :>
<:    if {$width != {}} { :>
<:        append d [string repeat 0 $width] $ares :>
<:        set ares [string range $d [string length $ares] end] :>
<:    } :>
<:    return $sign$ares :>
<:} :>

<: set c_xdevicefamily [getProjectFamily] :>
<: set c_family [getProjectFamily] :>
<: set DEVICE [getProjectDevice] :>
<: set PACKAGE [getProjectPackage] :>
<: set SPEEDGRADE [getProjectSpeedGrade] :>
<: ;#virtex7 edit --ACTION: o: aa100109:  defaults to V6 for now :>
<: set is_pele [expr {( [string equal -nocase $c_family "zynq"] || [string equal -nocase $c_family "azynq"] || [string equal -nocase $c_family "qzynq"] )?true:false}]  :>
<: set is_v7 [expr {( [string equal -nocase $c_family "virtex7"] || [string equal -nocase $c_family "kintex7"] || [string equal -nocase $c_family "spartan7"] || [string equal -nocase $c_family "aspartan7"]|| [string equal -nocase $c_family "virtex7l"] || [string equal -nocase $c_family "kintex7l"] || [string equal -nocase $c_family "artix7"] || [string equal -nocase $c_family "artix7l"] || [string equal -nocase $c_family "qvirtex7"] || [string equal -nocase $c_family "qkintex7"] || [string equal -nocase $c_family "qvirtex7l"] || [string equal -nocase $c_family "qkintex7l"] || [string equal -nocase $c_family "qartix7"] || [string equal -nocase $c_family "aartix7"] || [string equal -nocase $c_family "akintex7"] || $is_pele)?true:false}]  :>
<: set is_v8 [expr {( [string equal -nocase $c_family "virtexu"] || [string equal -nocase $c_family "virtexuplus"] || [string equal -nocase $c_family "virtexuplusHBM"] || [string equal -nocase $c_family "virtexuplus58g"] || [string equal -nocase $c_family "kintexuplus"] || [string equal -nocase $c_family "artixuplus"] || [string equal -nocase $c_family "zynquplus"]  || [string equal -nocase $c_family "spartanuplus"] )?true:false}]  :>
<: set is_k8 [expr {( [string equal -nocase $c_family "kintexu"] )?true:false}]  :>
