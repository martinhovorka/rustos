<: set divide2 [getStringValue "C_DIVIDE2_AUTO"] :>
<: set divide3 [getStringValue "C_DIVIDE3_AUTO"] :>
<: set divide4 [getStringValue "C_DIVIDE4_AUTO"] :>
<: set divide5 [getStringValue "C_DIVIDE5_AUTO"] :>
<: set divide6 [getStringValue "C_DIVIDE6_AUTO"] :>
<: set divide7 [getStringValue "C_DIVIDE7_AUTO"] :>
