<: ;#Clock Monitor Parameters :>
<: ;#----------------------- :>
<: set C_ENABLE_CLOCK_MONITOR [getStringValue "C_ENABLE_CLOCK_MONITOR"] :>
<: set C_PRECISION [getStringValue "C_PRECISION"] :>
<: set C_REF_CLK_FREQ [getStringValue "C_REF_CLK_FREQ"] :>
<: set REF_CLK_PERIOD [expr { 1000/$C_REF_CLK_FREQ }  ] :>
<: set C_Enable_PLL0 [getStringValue "C_Enable_PLL0"] :>
<: set C_Enable_PLL1 [getStringValue "C_Enable_PLL1"] :>
<: set C_ENABLE_USER_CLOCK0 [getStringValue "C_ENABLE_USER_CLOCK0"] :>
<: set C_ENABLE_USER_CLOCK1 [getStringValue "C_ENABLE_USER_CLOCK1"] :>
<: set C_ENABLE_USER_CLOCK2 [getStringValue "C_ENABLE_USER_CLOCK2"] :>
<: set C_ENABLE_USER_CLOCK3 [getStringValue "C_ENABLE_USER_CLOCK3"] :>
<: set C_USER_CLK_FREQ0 [getStringValue "C_USER_CLK_FREQ0"] :>
<: set C_USER_CLK0_PERIOD [expr { 1000/$C_USER_CLK_FREQ0 }  ] :>
<: set C_USER_CLK_FREQ1 [getStringValue "C_USER_CLK_FREQ1"] :>
<: set C_USER_CLK1_PERIOD [expr { 1000/$C_USER_CLK_FREQ1 }  ] :>
<: set C_USER_CLK_FREQ2 [getStringValue "C_USER_CLK_FREQ2"] :>
<: set C_USER_CLK2_PERIOD [expr { 1000/$C_USER_CLK_FREQ2 }  ] :>
<: set C_USER_CLK_FREQ3 [getStringValue "C_USER_CLK_FREQ3"] :>
<: set C_USER_CLK3_PERIOD [expr { 1000/$C_USER_CLK_FREQ3 }  ] :>
<: if { $C_USER_CLK_FREQ0 > $C_USER_CLK_FREQ1 }  {  :>
<: set max_user_clk_01 $C_USER_CLK_FREQ0  :>
<: } else  { :>
<: set max_user_clk_01 $C_USER_CLK_FREQ1  :>
<: } :>
<: if { $C_USER_CLK_FREQ2 > $C_USER_CLK_FREQ3 }  {  :>
<: set max_user_clk_12 $C_USER_CLK_FREQ2  :>
<: } else  { :>
<: set max_user_clk_12 $C_USER_CLK_FREQ3  :>
<: } :>
<: if { $max_user_clk_01 > $max_user_clk_12 }  {  :>
<: set max_user_clk_value $max_user_clk_01  :>
<: } else  { :>
<: set max_user_clk_value $max_user_clk_12  :>
<: } :>
<: set calc_value [expr { $max_user_clk_value * 320.0/$C_REF_CLK_FREQ/$C_PRECISION }  ] :>
<: set calc_value_log [expr {log($calc_value)/log(2) } ] :>
<: set C_COUNTER1_WIDTH_ceil [expr { ceil($calc_value_log) + 2 }  ] :>
<: set C_COUNTER1_WIDTH_int [expr { int($C_COUNTER1_WIDTH_ceil) }  ] :>
<: if { $C_COUNTER1_WIDTH_int > 5 }  {  :>
<: set C_COUNTER1_WIDTH $C_COUNTER1_WIDTH_int  :>
<: } else  { :>
<: set C_COUNTER1_WIDTH 5  :>
<: } :>
<: set calc_value1_st [expr { $C_USER_CLK_FREQ0 * 320.0/$C_REF_CLK_FREQ/$C_PRECISION }  ] :>
<: set calc_value_log1_st [expr {log($calc_value1_st)/log(2) } ] :>
<: set C_COUNTER1_WIDTH_ceil_st [expr { ceil($calc_value_log1_st) + 2 }  ] :>
<: set C_COUNTER1_WIDTH_int_st [expr { int($C_COUNTER1_WIDTH_ceil_st) }  ] :>
<: if { $C_COUNTER1_WIDTH_int_st > 5 }  {  :>
<: set C_COUNTER1_WIDTH_STOP $C_COUNTER1_WIDTH_int_st  :>
<: } else  { :>
<: set C_COUNTER1_WIDTH_STOP 5  :>
<: } :>
<: set calc_value2_st [expr { $C_USER_CLK_FREQ1 * 320.0/$C_REF_CLK_FREQ/$C_PRECISION }  ] :>
<: set calc_value_log2_st [expr {log($calc_value2_st)/log(2) } ] :>
<: set C_COUNTER2_WIDTH_ceil_st [expr { ceil($calc_value_log2_st) + 2 }  ] :>
<: set C_COUNTER2_WIDTH_int_st [expr { int($C_COUNTER2_WIDTH_ceil_st) }  ] :>
<: if { $C_COUNTER2_WIDTH_int_st > 5 }  {  :>
<: set C_COUNTER2_WIDTH_STOP $C_COUNTER2_WIDTH_int_st  :>
<: } else  { :>
<: set C_COUNTER2_WIDTH_STOP 5  :>
<: } :>
<: set calc_value3_st [expr { $C_USER_CLK_FREQ2 * 320.0/$C_REF_CLK_FREQ/$C_PRECISION }  ] :>
<: set calc_value_log3_st [expr {log($calc_value3_st)/log(2) } ] :>
<: set C_COUNTER3_WIDTH_ceil_st [expr { ceil($calc_value_log3_st) + 2 }  ] :>
<: set C_COUNTER3_WIDTH_int_st [expr { int($C_COUNTER3_WIDTH_ceil_st) }  ] :>
<: if { $C_COUNTER3_WIDTH_int_st > 5 }  {  :>
<: set C_COUNTER3_WIDTH_STOP $C_COUNTER3_WIDTH_int_st  :>
<: } else  { :>
<: set C_COUNTER3_WIDTH_STOP 5  :>
<: } :>
<: set calc_value4_st [expr { $C_USER_CLK_FREQ3 * 320.0/$C_REF_CLK_FREQ/$C_PRECISION }  ] :>
<: set calc_value_log4_st [expr {log($calc_value4_st)/log(2) } ] :>
<: set C_COUNTER4_WIDTH_ceil_st [expr { ceil($calc_value_log4_st) + 2 }  ] :>
<: set C_COUNTER4_WIDTH_int_st [expr { int($C_COUNTER4_WIDTH_ceil_st) }  ] :>
<: if { $C_COUNTER4_WIDTH_int_st > 5 }  {  :>
<: set C_COUNTER4_WIDTH_STOP $C_COUNTER4_WIDTH_int_st  :>
<: } else  { :>
<: set C_COUNTER4_WIDTH_STOP 5  :>
<: } :>
<: set C_COUNTER2_WIDTH 15 :>
<: set C_COUNTER1_WIDTH_STOP 6  :>
<: set C_COUNTER2_WIDTH_STOP 6  :>
<: set C_COUNTER3_WIDTH_STOP 6  :>
<: set C_COUNTER4_WIDTH_STOP 6  :>
<: set C_COUNTER1_value [expr {pow(2,$C_COUNTER1_WIDTH)}  ] :>
<: set C_COUNTER1_value_st [expr {pow(2,$C_COUNTER1_WIDTH_STOP)}  ] :>
<: set C_COUNTER2_value_st [expr {pow(2,$C_COUNTER2_WIDTH_STOP)}  ] :>
<: set C_COUNTER3_value_st [expr {pow(2,$C_COUNTER3_WIDTH_STOP)}  ] :>
<: set C_COUNTER4_value_st [expr {pow(2,$C_COUNTER4_WIDTH_STOP)}  ] :>
<: set C_COUNTER2_value [expr {pow(2,$C_COUNTER2_WIDTH)}  ] :>
<: set Count_clk0 [expr { 1.0 * $C_REF_CLK_FREQ * $C_COUNTER1_value/$C_USER_CLK_FREQ0 }  ] :>
<: set Count_clk0_st [expr { 1.0 * $C_REF_CLK_FREQ * $C_COUNTER1_value_st/$C_USER_CLK_FREQ0 }  ] :>
<: set Count_clk0_stop [expr { int($Count_clk0_st * 4 )}  ] :>
<: set Count_clk0_by2 [expr {$Count_clk0/2 }  ] :>
<: set Count_clk0_by2_plus1 [dec2bin_wid [expr {round($Count_clk0_by2 + 1  )} ] $C_COUNTER2_WIDTH] :>
<: set Count_clk0_by2_minus1 [dec2bin_wid [expr {round($Count_clk0_by2 - 1 )} ] $C_COUNTER2_WIDTH] :>
<: set Count_clk1 [expr { 1.0 * $C_REF_CLK_FREQ * $C_COUNTER1_value/$C_USER_CLK_FREQ1 }  ] :>
<: set Count_clk1_st [expr { 1.0 * $C_REF_CLK_FREQ * $C_COUNTER2_value_st/$C_USER_CLK_FREQ1 }  ] :>
<: set Count_clk1_stop [expr { int($Count_clk1_st * 4) }  ] :>
<: set Count_clk1_by2 [expr { $Count_clk1/2}  ] :>
<: set Count_clk1_by2_plus1 [dec2bin_wid [expr {round($Count_clk1_by2 + 1  )} ] $C_COUNTER2_WIDTH] :>
<: set Count_clk1_by2_minus1 [dec2bin_wid [expr {round($Count_clk1_by2 - 1 )} ] $C_COUNTER2_WIDTH] :>
<: set Count_clk2 [expr { 1.0 * $C_REF_CLK_FREQ * $C_COUNTER1_value/$C_USER_CLK_FREQ2 }  ] :>
<: set Count_clk2_st [expr { 1.0 * $C_REF_CLK_FREQ * $C_COUNTER3_value_st/$C_USER_CLK_FREQ2 }  ] :>
<: set Count_clk2_stop [expr {int( $Count_clk2_st * 4 )}  ] :>
<: set Count_clk2_by2 [expr { $Count_clk2/2 }  ] :>
<: set Count_clk2_by2_plus1 [dec2bin_wid [expr {round($Count_clk2_by2 + 1  )} ] $C_COUNTER2_WIDTH] :>
<: set Count_clk2_by2_minus1 [dec2bin_wid [expr {round($Count_clk2_by2 - 1 )} ] $C_COUNTER2_WIDTH] :>
<: set Count_clk3 [expr { 1.0 * $C_REF_CLK_FREQ * $C_COUNTER1_value/$C_USER_CLK_FREQ3 }  ] :>
<: set Count_clk3_st [expr { 1.0 * $C_REF_CLK_FREQ * $C_COUNTER4_value_st/$C_USER_CLK_FREQ3 }  ] :>
<: set Count_clk3_stop [expr { int($Count_clk3_st * 4 )}  ] :>
<: set Count_clk3_by2 [expr { $Count_clk3/2 }  ] :>
<: set Count_clk3_by2_plus1 [dec2bin_wid [expr {round($Count_clk3_by2 + 1  )} ] $C_COUNTER2_WIDTH] :>
<: set Count_clk3_by2_minus1 [dec2bin_wid [expr {round($Count_clk3_by2 - 1 )} ] $C_COUNTER2_WIDTH] :>
<: ;#----------------------- :>
<: ;#Clocking features :>
<: ;#----------------------- :>
<: set use_phase_alignment [expr {( [getBooleanValue "C_USE_PHASE_ALIGNMENT"])?true:false}]  :>
<: set use_min_o_jitter [expr {( [getBooleanValue "C_USE_MIN_O_JITTER"])?true:false}]  :>
<: set use_max_i_jitter [expr {( [getBooleanValue "C_USE_MAX_I_JITTER"])?true:false}]  :>
<: set use_dyn_reprog [expr {( [getBooleanValue "C_USE_DYN_RECONFIG"])?true:false}]  :>
<: set use_dyn_phase_shift [expr {( [getBooleanValue "C_USE_DYN_PHASE_SHIFT"])?true:false}]  :>
<: set use_inclk_switchover [expr {( [getBooleanValue "C_USE_INCLK_SWITCHOVER"])?true:false}]  :>
<: set use_spread_spectrum [expr {( [getBooleanValue "C_USE_SPREAD_SPECTRUM"])?true:false}]  :>
<: set use_clk_valid [expr {( [getBooleanValue "C_USE_CLK_VALID"])?true:false}]  :>
<: set use_fast_sim [expr {( [getBooleanValue "C_USE_FAST_SIMULATION"])?true:false}]  :>
<: set optimize_structure_en [expr {( [getBooleanValue "C_OPTIMIZE_CLOCKING_STRUCTURE_EN"])?true:false}]  :>
<: ;#----------------------- :>
<: ;#Optional ports :>
<: ;#----------------------- :>
<: set mmcm_compensation [getStringValue "C_MMCM_COMPENSATION"] :>
<: set use_reset [expr {( [getBooleanValue "C_USE_RESET"])?true:false}]  :>
<: set reset_active_high [expr {( [getBooleanValue "C_RESET_LOW"])?false:true}]  :>
<: set use_locked [expr {( [getBooleanValue "C_USE_LOCKED"])?true:false}]  :>
<: set use_inclk_stopped [expr {( [getBooleanValue "C_USE_INCLK_STOPPED"])?true:false}]  :>
<: set use_clkfb_stopped [expr {( [getBooleanValue "C_USE_CLKFB_STOPPED"])?true:false}]  :>
<: set use_power_down [expr {( [getBooleanValue "C_USE_POWER_DOWN"])?true:false}]  :>
<: set use_status [expr {( [getBooleanValue "C_USE_STATUS"])?true:false}]  :>
<: set use_freeze [expr {( [getBooleanValue "C_USE_FREEZE"])?true:false}]  :>
<: set CLOCK_MGR_TYPE [getStringValue "C_CLOCK_MGR_TYPE"] :>
<: set has_cddc [expr {( [getBooleanValue "C_HAS_CDDC"])?true:false}]  :>
<: ;#----------------------- :>
<: ;#Input clocks :>
<: ;#----------------------- :>
<: set feedback_source [getStringValue "C_FEEDBACK_SOURCE"] :>
<: set ext_feedback [expr {( $use_phase_alignment  && (![string equal -nocase $feedback_source "FDBK_AUTO"])  && (![string equal -nocase $feedback_source "FDBK_AUTO_OFFCHIP"]))?true:false}]  :>
<: set feedback_type [getStringValue "C_CLKFB_IN_SIGNALING"] :>
<: ;#auto mode external feedback :>
<: ;#ACTION: o: aa091026:  have to edit this to pick variable from gui :>
<: set auto_ext_feedback [expr {( $use_phase_alignment  && [string equal -nocase $feedback_source "FDBK_AUTO_OFFCHIP"])?true:false}]  :>
<: set auto_sing_feedback [expr {( $auto_ext_feedback  && [string equal -nocase $feedback_type "SINGLE"])?true:false}]  :>
<: set auto_diff_feedback [expr {( $auto_ext_feedback  && [string equal -nocase $feedback_type "DIFF"])?true:false}]  :>
<: set clkin1_buf [getStringValue "C_PRIM_SOURCE"] :>
<: set clkin2_buf [getStringValue "C_SECONDARY_SOURCE"] :>
<: set clkin1_diff [expr {( [string equal -nocase $clkin1_buf "Differential_clock_capable_pin"] || [string equal -nocase $clkin1_buf "Differential_non_clock_pin"])?true:false}]  :>
<: set clkin2_diff [expr {( [string equal -nocase $clkin2_buf "Differential_clock_capable_pin"] || [string equal -nocase $clkin2_buf "Differential_non_clock_pin"])?true:false}]  :>
<: set clkin1_nonclkpin [expr {( [string equal -nocase $clkin1_buf "Single_ended_non_clock_pin"] || [string equal -nocase $clkin1_buf "Differential_non_clock_pin"])?true:false}]  :>
<: set clkin2_nonclkpin [expr {( [string equal -nocase $clkin2_buf "Single_ended_non_clock_pin"] || [string equal -nocase $clkin2_buf "Differential_non_clock_pin"])?true:false}]  :>
<: set clkin1_buf_no_buf [expr {( [string equal -nocase $clkin1_buf "No_buffer"])?true:false}]  :>
<: set exdes_buffer_clkin1 [expr {( false)?true:false}]  :>
<: if { [string equal -nocase $PRIMTYPE_SEL "PLL_BASE"]}  {  :>
<: if { [string equal -nocase $feedback_source "FDBK_AUTO_OFFCHIP"] || [string equal -nocase $feedback_source "FDBK_OFFCHIP"]}  {  :>
<: set exdes_buffer_clkin1 [expr {( false)?true:false}]  :>
<: } else  { :>
<: set exdes_buffer_clkin1 [expr {( $clkin1_buf_no_buf)?true:false}]  :>
<: } :>
<: } else  { :>
<: set exdes_buffer_clkin1 [expr {( $clkin1_buf_no_buf)?true:false}]  :>
<: } :>
<: set exdes_buffer_clkin2 [expr {( $use_inclk_switchover  && [string equal -nocase $clkin2_buf "No_buffer"])?true:false}]  :>
<: set exdes_buffer_clkfbin [expr {( $ext_feedback  && [string equal -nocase $feedback_source "FDBK_OFFCHIP"]  && [string equal -nocase $feedback_type "SINGLE"])?true:false}]  :>
<: set exdes_connectfb false  :>
<: set ext_feedback_xdc_constr [expr {( $use_phase_alignment  && (![string equal -nocase $feedback_source "FDBK_AUTO"])  && (![string equal -nocase $feedback_source "FDBK_ONCHIP"]))?true:false}]  :>
<: ;#----------------------- :>
<: ;#Safe clock Startup      :>
<: ;#----------------------- :>
<: set safe_clk_startup [expr {( [getBooleanValue "C_USE_SAFE_CLOCK_STARTUP"])?true:false}]  :>
<: set clock_sequencing [expr {( [getBooleanValue "C_USE_CLOCK_SEQUENCING"])?true:false}]  :>
<: set clkout1_seq_number [getIntValue "C_CLKOUT1_SEQUENCE_NUMBER"]  :>
<: set clkout2_seq_number [getIntValue "C_CLKOUT2_SEQUENCE_NUMBER"]  :>
<: set clkout3_seq_number [getIntValue "C_CLKOUT3_SEQUENCE_NUMBER"]  :>
<: set clkout4_seq_number [getIntValue "C_CLKOUT4_SEQUENCE_NUMBER"]  :>
<: set clkout5_seq_number [getIntValue "C_CLKOUT5_SEQUENCE_NUMBER"]  :>
<: set clkout6_seq_number [getIntValue "C_CLKOUT6_SEQUENCE_NUMBER"]  :>
<: set clkout7_seq_number [getIntValue "C_CLKOUT7_SEQUENCE_NUMBER"]  :>
<: set max_seq_number [expr [::tcl::mathfunc::max $clkout1_seq_number $clkout2_seq_number $clkout3_seq_number $clkout4_seq_number $clkout5_seq_number $clkout6_seq_number $clkout7_seq_number]]  :>
<: ;#----------------------- :>
<: ;#Output clocks topology :>
<: ;#----------------------- :>
<: set enable_clkoutphy [expr {( [getBooleanValue "C_ENABLE_CLKOUTPHY"])?true:false}]  :>
<: set num_out_clks [getIntValue "C_NUM_OUT_CLKS"] :>
<: set clkout1_buf [getStringValue "C_CLKOUT1_DRIVES"] :>
<: set clkout2_buf [getStringValue "C_CLKOUT2_DRIVES"] :>
<: set clkout3_buf [getStringValue "C_CLKOUT3_DRIVES"] :>
<: set clkout4_buf [getStringValue "C_CLKOUT4_DRIVES"] :>
<: set clkout5_buf [getStringValue "C_CLKOUT5_DRIVES"] :>
<: set clkout6_buf [getStringValue "C_CLKOUT6_DRIVES"] :>
<: set clkout7_buf [getStringValue "C_CLKOUT7_DRIVES"] :>
<: set clkout1_buf_param [get_property PARAM_VALUE.CLKOUT1_DRIVES] :>
<: set clkout2_buf_param [get_property PARAM_VALUE.CLKOUT2_DRIVES] :>
<: set clkout3_buf_param [get_property PARAM_VALUE.CLKOUT3_DRIVES] :>
<: set clkout4_buf_param [get_property PARAM_VALUE.CLKOUT4_DRIVES] :>
<: set clkout5_buf_param [get_property PARAM_VALUE.CLKOUT5_DRIVES] :>
<: set clkout6_buf_param [get_property PARAM_VALUE.CLKOUT6_DRIVES] :>
<: set clkout7_buf_param [get_property PARAM_VALUE.CLKOUT7_DRIVES] :>
<: ;#----------------------- :>
<: ;#Derived variables for easy ending (defined in reverse port order) :>
<: ;#----------------------- :>
<: set has_control [expr {( $use_reset || $use_locked || $use_inclk_stopped || $use_power_down || $use_status || $use_clkfb_stopped)?true:false}]  :>
<: set locked_last [expr {( !$has_cddc)?false:false}]  :>
<: set clkfb_stopped_last [expr {( $locked_last  && !$use_locked)?false:false}]  :>
<: set inclk_stopped_last [expr {( $clkfb_stopped_last  && !$use_clkfb_stopped)?false:false}]  :>
<: set status_last [expr {( $inclk_stopped_last  && !$use_inclk_stopped)?false:false}]  :>
<: set freeze_last [expr {( $status_last  && !$use_status)?false:false}]  :>
<: set power_down_last [expr {( $freeze_last  && !$use_freeze)?false:false}]  :>
<: set reset_last [expr {( $power_down_last  && !$use_power_down)?false:false}]  :>
<: set dyn_phase_shift_last [expr {( $reset_last  && !$use_reset)?false:false}]  :>
<: set dyn_reprog_last [expr {( $dyn_phase_shift_last  && !$use_dyn_phase_shift)?false:false}]  :>
<: set clkfbout_last [expr {( $dyn_reprog_last  && !$use_dyn_reprog)?false:false}]  :>
<: set clkout7_last [expr {( $clkfbout_last  && (!$ext_feedback)  && (!$auto_ext_feedback))?false:false}]  :>
<: set clkout6_last [expr {( $clkout7_last  && ( $num_out_clks< 7) )?false:false}]  :>
<: set clkout5_last [expr {( $clkout6_last  && ( $num_out_clks< 6) )?false:false}]  :>
<: set clkout4_last [expr {( $clkout5_last  && ( $num_out_clks< 5) )?false:false}]  :>
<: set clkout3_last [expr {( $clkout4_last  && ( $num_out_clks< 4) )?false:false}]  :>
<: set clkout2_last [expr {( $clkout3_last  && ( $num_out_clks< 3) )?false:false}]  :>
<: set clkout1_last [expr {( $clkout2_last  && ( $num_out_clks< 2) )?false:false}]  :>
<: set clkfbout_last_nodyn [expr {( $reset_last  && !$use_reset)?false:false}]  :>
<: set clkout_last_nodyn [expr {( $clkfbout_last_nodyn  && (!$ext_feedback)  && (!$auto_ext_feedback))?false:false}]  :>
<: set clkout_last [expr {( $clkout7_last)?false:false}]  :>
<: ;#----------------------- :>
<: ;#AXI4 Lite selection :>
<: ;#----------------------- :>
<: set c_has_AXI [expr [getIntValue "C_INTERFACE_SELECTION"] == 1] :>
