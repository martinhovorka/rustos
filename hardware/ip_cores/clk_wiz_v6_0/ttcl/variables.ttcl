<: set C_CLKOUT0_2 [getStringValue "C_CLKOUT0_2"] :>
<: set C_CLKOUT1_1 [getStringValue "C_CLKOUT1_1"] :>
<: set C_CLKOUT1_2 [getStringValue "C_CLKOUT1_2"] :>
<: set C_CLKOUT2_1 [getStringValue "C_CLKOUT2_1"] :>
<: set C_CLKOUT2_2 [getStringValue "C_CLKOUT2_2"] :>
<: set C_CLKOUT3_1 [getStringValue "C_CLKOUT3_1"] :>
<: set C_CLKOUT3_2 [getStringValue "C_CLKOUT3_2"] :>
<: set C_CLKOUT4_1 [getStringValue "C_CLKOUT4_1"] :>
<: set C_CLKOUT4_2 [getStringValue "C_CLKOUT4_2"] :>
<: set C_CLKOUT5_1 [getStringValue "C_CLKOUT5_1"] :>
<: set C_CLKOUT5_2 [getStringValue "C_CLKOUT5_2"] :>
<: set C_CLKOUT6_1 [getStringValue "C_CLKOUT6_1"] :>
<: set C_CLKOUT6_2 [getStringValue "C_CLKOUT6_2"] :>
<: set C_DIVCLK [getStringValue "C_DIVCLK"] :>
