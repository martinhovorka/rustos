<: set pll_notes [getStringValue "C_PLL_NOTES"] :>
<: set pll_bandwidth [getStringValue "C_PLL_BANDWIDTH"] :>
<: set pll_clk_feedback [getStringValue "C_PLL_CLK_FEEDBACK"] :>
<: set is_clk0_fb [expr {(( [string equal -nocase $pll_clk_feedback "CLKOUT0"]) )?true:false}]  :>
<: set pll_clkfbout_mult [getIntValue "C_PLL_CLKFBOUT_MULT"] :>
<: set pll_clkin_period [getStringValue "C_PLL_CLKIN_PERIOD"] :>
<: set pll_compensation [getStringValue "C_PLL_COMPENSATION"] :>
