<: set outclk_sum_row2 [getStringValue "C_OUTCLK_SUM_ROW2"] :>
<: set outclk_sum_row3 [getStringValue "C_OUTCLK_SUM_ROW3"] :>
<: set outclk_sum_row4 [getStringValue "C_OUTCLK_SUM_ROW4"] :>
<: set outclk_sum_row5 [getStringValue "C_OUTCLK_SUM_ROW5"] :>
<: set outclk_sum_row6 [getStringValue "C_OUTCLK_SUM_ROW6"] :>
<: set outclk_sum_row7 [getStringValue "C_OUTCLK_SUM_ROW7"] :>
