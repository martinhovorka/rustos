<: set pll_ref_jitter [getStringValue "C_PLL_REF_JITTER"] :>
<: ;# :>
<: ;# :>
<: ;#pll output attributes :>
<: ;#--------------------------------------------------- :>
<: set pll_clkout0_divide [getIntValue "C_PLL_CLKOUT0_DIVIDE"] :>
<: set pll_clkout1_divide [getIntValue "C_PLL_CLKOUT1_DIVIDE"] :>
<: set pll_clkout2_divide [getIntValue "C_PLL_CLKOUT2_DIVIDE"] :>
<: set pll_clkout3_divide [getIntValue "C_PLL_CLKOUT3_DIVIDE"] :>
<: set pll_clkout4_divide [getIntValue "C_PLL_CLKOUT4_DIVIDE"] :>
<: set pll_clkout5_divide [getIntValue "C_PLL_CLKOUT5_DIVIDE"] :>
<: set pll_clkout0_duty_cycle [getStringValue "C_PLL_CLKOUT0_DUTY_CYCLE"] :>
<: set pll_clkout1_duty_cycle [getStringValue "C_PLL_CLKOUT1_DUTY_CYCLE"] :>
<: set pll_clkout2_duty_cycle [getStringValue "C_PLL_CLKOUT2_DUTY_CYCLE"] :>
<: set pll_clkout3_duty_cycle [getStringValue "C_PLL_CLKOUT3_DUTY_CYCLE"] :>
<: set pll_clkout4_duty_cycle [getStringValue "C_PLL_CLKOUT4_DUTY_CYCLE"] :>
<: set pll_clkout5_duty_cycle [getStringValue "C_PLL_CLKOUT5_DUTY_CYCLE"] :>
<: set pll_clkfbout_phase [getStringValue "C_PLL_CLKFBOUT_PHASE"] :>
<: set pll_clkout0_phase [getStringValue "C_PLL_CLKOUT0_PHASE"] :>
<: set pll_clkout1_phase [getStringValue "C_PLL_CLKOUT1_PHASE"] :>
<: set pll_clkout2_phase [getStringValue "C_PLL_CLKOUT2_PHASE"] :>
<: set pll_clkout3_phase [getStringValue "C_PLL_CLKOUT3_PHASE"] :>
<: set pll_clkout4_phase [getStringValue "C_PLL_CLKOUT4_PHASE"] :>
<: set pll_clkout5_phase [getStringValue "C_PLL_CLKOUT5_PHASE"] :>
<: set override_pll [expr {( [getBooleanValue "C_OVERRIDE_PLL"])?true:false}]  :>
<: set clkoutphy_mode [getStringValue "C_CLKOUTPHY_MODE"] :>
<: ;# :>
<: ;# :>
<: ;#boolean use_clkout1_bar                  = getBooleanValue("C_USE_CLKOUT1_BAR") :>
<: ;#boolean use_clkout2_bar                  = getBooleanValue("C_USE_CLKOUT2_BAR") :>
<: ;#boolean use_clkout3_bar                  = getBooleanValue("C_USE_CLKOUT3_BAR") :>
<: ;#boolean use_clkout4_bar                  = getBooleanValue("C_USE_CLKOUT4_BAR") :>
<: set use_clkout1_bar [expr {( false)?true:false}]  :>
<: set use_clkout2_bar [expr {( false)?true:false}]  :>
<: set use_clkout3_bar [expr {( false)?true:false}]  :>
<: set use_clkout4_bar [expr {( false)?true:false}]  :>
<: ;#decided in the PRT that bar clock uses the same buffer :>
<: set clkout1b_buf [getStringValue "C_CLKOUT1_DRIVES"] :>
<: set clkout2b_buf [getStringValue "C_CLKOUT2_DRIVES"] :>
<: set clkout3b_buf [getStringValue "C_CLKOUT3_DRIVES"] :>
<: set clkout4b_buf [getStringValue "C_CLKOUT4_DRIVES"] :>
<: set clkout1b_ce_used [expr {(( [string equal -nocase $clkout1b_buf "BUFGCE"] || [string equal -nocase $clkout1b_buf "BUFHCE"] || [string equal -nocase $clkout1b_buf "BUFR"]) )?true:false}]  :>
<: set clkout2b_ce_used [expr {((( [string equal -nocase $clkout2b_buf "BUFGCE"] || [string equal -nocase $clkout2b_buf "BUFHCE"] || [string equal -nocase $clkout2b_buf "BUFR"])  && $num_out_clks> 1) )?true:false}]  :>
<: set clkout3b_ce_used [expr {((( [string equal -nocase $clkout3b_buf "BUFGCE"] || [string equal -nocase $clkout3b_buf "BUFHCE"] || [string equal -nocase $clkout3b_buf "BUFR"])  && $num_out_clks> 2) )?true:false}]  :>
<: set clkout4b_ce_used [expr {((( [string equal -nocase $clkout4b_buf "BUFGCE"] || [string equal -nocase $clkout4b_buf "BUFHCE"] || [string equal -nocase $clkout4b_buf "BUFR"])  && $num_out_clks> 3) )?true:false}]  :>
<: set num_bar_clks 0 :>
<: if { $use_clkout1_bar}  {  :>
<: set num_bar_clks [ttcl_add $num_bar_clks 1] :>
<: } :>
<: if { $use_clkout2_bar}  {  :>
<: set num_bar_clks [ttcl_add $num_bar_clks 1] :>
<: } :>
<: if { $use_clkout3_bar}  {  :>
<: set num_bar_clks [ttcl_add $num_bar_clks 1] :>
<: } :>
<: if { $use_clkout4_bar}  {  :>
<: set num_bar_clks [ttcl_add $num_bar_clks 1] :>
<: } :>
<: ;# :>
<: ;# :>
<: ;#----------------------------------------------------- :>
<: ;#Language specific parameters for common files :>
<: ;#----------------------------------------------------- :>
<: set is_verilog [expr {( [isVerilogOutputRequired])?true:false}]  :>
<: set is_vhdl [expr {( [isVHDLOutputRequired])?true:false}]  :>
<: set command "" :>
<: set ext "" :>
<: set comment "" :>
<: set glbl_arg "" :>
<: set library "" :>
<: set library_sim "" :>
<: if { $is_verilog}  {  :>
<: set command "verilog" :>
<: set ext "v" :>
<: set comment "//" :>
<: set glbl_arg "work.glbl" :>
<: set library "unisims_ver" :>
<: set library_sim "simprims_ver" :>
<: } else  { :>
<: set command "vhdl" :>
<: set ext "vhd" :>
<: set comment "--" :>
<: set library "unisim" :>
<: set library_sim "simprim" :>
<: } :>
<: ;#Generic parameters remerged from PRIMITIVE specific :>
<: ;#----------------------------------------------------- :>
<: set clkin1_period "" :>
<: set clkin2_period "" :>
<: set clkin1_jitter "" :>
<: set clkin2_jitter "" :>
<: set clkin1_jitter_ps [getStringValue "C_CLKIN1_JITTER_PS"] :>
<: set clkin2_jitter_ps [getStringValue "C_CLKIN2_JITTER_PS"] :>
<: set clkin1_jitter_ps_l [::tcl::mathfunc::double [::tcl::mathfunc::double $clkin1_jitter_ps]] :>
<: set clkin1_jitter_ns [expr { $clkin1_jitter_ps_l / 1000} ] :>
<: set clkin1_jitter_ns_rounded [format "%4.3f"  $clkin1_jitter_ns] :>
<: set clkin2_jitter_ps_l [::tcl::mathfunc::double [::tcl::mathfunc::double $clkin2_jitter_ps]] :>
<: set clkin2_jitter_ns [expr { $clkin2_jitter_ps_l / 1000} ] :>
<: set clkin2_jitter_ns_rounded [format "%4.3f"  $clkin2_jitter_ns] :>
<: set prim_inst "" :>
<: set notes "" :>
<: set status_low 0 :>
<: set manual_override [expr {( false)?true:false}]  :>
<: set is_plle2 [expr {( false)?true:false}]  :>
<: set is_plle3 [expr {( false)?true:false}]  :>
<: if { [string equal -nocase $PRIMITIVE "PLL"]}  {  :>
<: set clkin1_period $mmcm_clkin1_period :>
<: set clkin2_period $mmcm_clkin2_period :>
<: set clkin1_jitter $mmcm_ref_jitter1 :>
<: set clkin2_jitter $mmcm_ref_jitter2 :>
<: set notes $mmcm_notes :>
<: set manual_override [expr {( $override_mmcm)?true:false}]  :>
<: if { $is_v8 || $is_k8 }  {  :>
<: set is_plle3 [expr {( true)?true:false}]  :>
<: set prim_inst "plle3_adv_inst" :>
<: } else  { :>
<: set is_plle2 [expr {( true)?true:false}]  :>
<: set prim_inst "plle2_adv_inst" :>
<: } :>
<: } else  { :>
<: set clkin1_period $mmcm_clkin1_period :>
<: set clkin2_period $mmcm_clkin2_period :>
<: set clkin1_jitter $mmcm_ref_jitter1 :>
<: set clkin2_jitter $mmcm_ref_jitter2 :>
<: set prim_inst "mmcm_adv_inst" :>
<: set notes $mmcm_notes :>
<: set manual_override [expr {( $override_mmcm)?true:false}]  :>
<: } :>
<: if { !$use_inclk_switchover }  {  :>
<: set per_based_vco [expr 1000*$mmcm_clkfbout_mult_1/($mmcm_divclk_divide*$clkin1_period)] :>
<: set per_based_vco [format "%3.3f"  $per_based_vco] :>
<: set clk_in1_freq [get_property PARAM_VALUE.PRIM_IN_FREQ ] :>
<: set freq_based_vco [expr $clk_in1_freq*$mmcm_clkfbout_mult_1/$mmcm_divclk_divide] :>
<: set freq_based_vco [format "%3.3f"  $freq_based_vco] :>
<: set round_issue [expr $freq_based_vco - $per_based_vco] :>
<: if { $freq_based_vco == 600.000 && $round_issue != 0.000}  {  :>
<: } :>
<: } else  { :>
<: set per_based_vco [expr 1000*$mmcm_clkfbout_mult_1/($mmcm_divclk_divide*$clkin1_period)] :>
<: set per_based_vco [format "%3.3f"  $per_based_vco] :>
<: set clk_in1_freq [get_property PARAM_VALUE.PRIM_IN_FREQ ] :>
<: set freq_based_vco [expr $clk_in1_freq*$mmcm_clkfbout_mult_1/$mmcm_divclk_divide] :>
<: set freq_based_vco [format "%3.3f"  $freq_based_vco] :>
<: set round_issue [expr $freq_based_vco - $per_based_vco] :>
<: if { $freq_based_vco == 600.000 && $round_issue != 0.000}  {  :>
<: } :>
<: set per_based_vco [expr 1000*$mmcm_clkfbout_mult_1/($mmcm_divclk_divide*$clkin2_period)] :>
<: set per_based_vco [format "%3.3f"  $per_based_vco] :>
<: set clk_in2_freq [get_property PARAM_VALUE.SECONDARY_IN_FREQ] :>
<: set freq_based_vco [expr $clk_in2_freq*$mmcm_clkfbout_mult_1/$mmcm_divclk_divide] :>
<: set freq_based_vco [format "%3.3f"  $freq_based_vco] :>
<: set round_issue [expr $freq_based_vco - $per_based_vco] :>
<: if { $freq_based_vco == 600.000 && $round_issue != 0.000}  {  :>
<: } :>
<: } :>
