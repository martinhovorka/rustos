<: set pllbufgcediv1 [getStringValue "C_PLLBUFGCEDIV1"] :>
<: set pllbufgcediv2 [getStringValue "C_PLLBUFGCEDIV2"] :>
<: set pllbufgcediv3 [getStringValue "C_PLLBUFGCEDIV3"] :>
<: set pllbufgcediv4 [getStringValue "C_PLLBUFGCEDIV4"] :>
<: set mmcmbufgcediv [getStringValue "C_MMCMBUFGCEDIV"] :>
<: set mmcmbufgcediv1 [getStringValue "C_MMCMBUFGCEDIV1"] :>
<: set mmcmbufgcediv2 [getStringValue "C_MMCMBUFGCEDIV2"] :>
<: set mmcmbufgcediv3 [getStringValue "C_MMCMBUFGCEDIV3"] :>
<: set mmcmbufgcediv4 [getStringValue "C_MMCMBUFGCEDIV4"] :>
<: set mmcmbufgcediv5 [getStringValue "C_MMCMBUFGCEDIV5"] :>
<: set mmcmbufgcediv6 [getStringValue "C_MMCMBUFGCEDIV6"] :>
<: set mmcmbufgcediv7 [getStringValue "C_MMCMBUFGCEDIV7"] :>
<: set list_pllbufg "" :>
<: if {$pllbufgcediv1 == "false"} { :>
<: lappend list_pllbufg "1"  :>
<: } :>
<: if {$pllbufgcediv2 == "false"} { :>
<: lappend list_pllbufg "2"  :>
<: } :>
<: if {$pllbufgcediv3 == "false"} { :>
<: lappend list_pllbufg "3"  :>
<: } :>
<: if {$pllbufgcediv4 == "false"} { :>
<: lappend list_pllbufg "4"  :>
<: } :>
<: set pllbufg1 [lindex $list_pllbufg 0]  :>
<: set pllbufg2 [lindex $list_pllbufg 1]  :>
<: set pllbufg2_1 [expr $pllbufg2 - 1]  :>
<: set length [llength $list_pllbufg]   :>
<: if  { $length >= 2} { :>
<: set list_pllbufg2 true  :>
<: } else  { :>
<: set list_pllbufg2 false  :>
<: } :>
