<: set phaseshift_mode [getStringValue "C_PHASESHIFT_MODE"] :>
<: ;#------------------------------------------- :>
<: ;#Connectivity settings :>
<: ;#------------------------------------------- :>
<: set clk0_unused [expr {( true)?true:false}]  :>
<: set clk90_unused [expr {( true)?true:false}]  :>
<: set clk180_unused [expr {( true)?true:false}]  :>
<: set clk270_unused [expr {( true)?true:false}]  :>
<: set clk2x_unused [expr {( true)?true:false}]  :>
<: set clk2x180_unused [expr {( true)?true:false}]  :>
<: set clkfx_unused [expr {( true)?true:false}]  :>
<: set clkfx180_unused [expr {( true)?true:false}]  :>
<: set clkdv_unused [expr {( true)?true:false}]  :>
<: set clkfxdv_unused [expr {( true)?true:false}]  :>
<: ;#by default set all portname vars to be PLL/MMCM 1:1 mapping :>
<: set clkout1_portname "clkout0" :>
<: set clkout2_portname "clkout1" :>
<: set clkout3_portname "clkout2" :>
<: set clkout4_portname "clkout3" :>
<: set clkout5_portname "clkout4" :>
<: set clkout6_portname "clkout5" :>
<: set clkout7_portname "clkout6" :>
<: if { [string equal -nocase $PRIMTYPE_SEL "DCM_SP"]}  {  :>
<: } elseif  { [string equal -nocase $PRIMTYPE_SEL "DCM_CLKGEN"]}  { :>
<: } :>
<: if { [string equal -nocase $clkout1_portname "clk0"] ||( [string equal -nocase $clkout2_portname "clk0"]  && $num_out_clks> 1)  ||( [string equal -nocase $clkout3_portname "clk0"]  && $num_out_clks> 2)  ||( [string equal -nocase $clkout4_portname "clk0"]  && $num_out_clks> 3)  ||( [string equal -nocase $clkout5_portname "clk0"]  && $num_out_clks> 4)  ||( [string equal -nocase $clkout6_portname "clk0"]  && $num_out_clks> 5) }  {  :>
<: set clk0_unused [expr {( false)?true:false}]  :>
<: } :>
<: if { [string equal -nocase $clkout1_portname "clk90"] ||( [string equal -nocase $clkout2_portname "clk90"]  && $num_out_clks> 1)  ||( [string equal -nocase $clkout3_portname "clk90"]  && $num_out_clks> 2)  ||( [string equal -nocase $clkout4_portname "clk90"]  && $num_out_clks> 3)  ||( [string equal -nocase $clkout5_portname "clk90"]  && $num_out_clks> 4)  ||( [string equal -nocase $clkout6_portname "clk90"]  && $num_out_clks> 5) }  {  :>
<: set clk90_unused [expr {( false)?true:false}]  :>
<: } :>
<: if { [string equal -nocase $clkout1_portname "clk180"] ||( [string equal -nocase $clkout2_portname "clk180"]  && $num_out_clks> 1)  ||( [string equal -nocase $clkout3_portname "clk180"]  && $num_out_clks> 2)  ||( [string equal -nocase $clkout4_portname "clk180"]  && $num_out_clks> 3)  ||( [string equal -nocase $clkout5_portname "clk180"]  && $num_out_clks> 4)  ||( [string equal -nocase $clkout6_portname "clk180"]  && $num_out_clks> 5) }  {  :>
<: set clk180_unused [expr {( false)?true:false}]  :>
<: } :>
<: if { [string equal -nocase $clkout1_portname "clk270"] ||( [string equal -nocase $clkout2_portname "clk270"]  && $num_out_clks> 1)  ||( [string equal -nocase $clkout3_portname "clk270"]  && $num_out_clks> 2)  ||( [string equal -nocase $clkout4_portname "clk270"]  && $num_out_clks> 3)  ||( [string equal -nocase $clkout5_portname "clk270"]  && $num_out_clks> 4)  ||( [string equal -nocase $clkout6_portname "clk270"]  && $num_out_clks> 5) }  {  :>
<: set clk270_unused [expr {( false)?true:false}]  :>
<: } :>
<: if { [string equal -nocase $clkout1_portname "clk2x"] ||( [string equal -nocase $clkout2_portname "clk2x"]  && $num_out_clks> 1)  ||( [string equal -nocase $clkout3_portname "clk2x"]  && $num_out_clks> 2)  ||( [string equal -nocase $clkout4_portname "clk2x"]  && $num_out_clks> 3)  ||( [string equal -nocase $clkout5_portname "clk2x"]  && $num_out_clks> 4)  ||( [string equal -nocase $clkout6_portname "clk2x"]  && $num_out_clks> 5) }  {  :>
<: set clk2x_unused [expr {( false)?true:false}]  :>
<: } :>
<: if { [string equal -nocase $clkout1_portname "clk2x180"] ||( [string equal -nocase $clkout2_portname "clk2x180"]  && $num_out_clks> 1)  ||( [string equal -nocase $clkout3_portname "clk2x180"]  && $num_out_clks> 2)  ||( [string equal -nocase $clkout4_portname "clk2x180"]  && $num_out_clks> 3)  ||( [string equal -nocase $clkout5_portname "clk2x180"]  && $num_out_clks> 4)  ||( [string equal -nocase $clkout6_portname "clk2x180"]  && $num_out_clks> 5) }  {  :>
<: set clk2x180_unused [expr {( false)?true:false}]  :>
<: } :>
<: if { [string equal -nocase $clkout1_portname "clkfx"] ||( [string equal -nocase $clkout2_portname "clkfx"]  && $num_out_clks> 1)  ||( [string equal -nocase $clkout3_portname "clkfx"]  && $num_out_clks> 2)  ||( [string equal -nocase $clkout4_portname "clkfx"]  && $num_out_clks> 3)  ||( [string equal -nocase $clkout5_portname "clkfx"]  && $num_out_clks> 4)  ||( [string equal -nocase $clkout6_portname "clkfx"]  && $num_out_clks> 5) }  {  :>
<: set clkfx_unused [expr {( false)?true:false}]  :>
<: } :>
<: if { [string equal -nocase $clkout1_portname "clkfx180"] ||( [string equal -nocase $clkout2_portname "clkfx180"]  && $num_out_clks> 1)  ||( [string equal -nocase $clkout3_portname "clkfx180"]  && $num_out_clks> 2)  ||( [string equal -nocase $clkout4_portname "clkfx180"]  && $num_out_clks> 3)  ||( [string equal -nocase $clkout5_portname "clkfx180"]  && $num_out_clks> 4)  ||( [string equal -nocase $clkout6_portname "clkfx180"]  && $num_out_clks> 5) }  {  :>
<: set clkfx180_unused [expr {( false)?true:false}]  :>
<: } :>
<: if { [string equal -nocase $clkout1_portname "clkdv"] ||( [string equal -nocase $clkout2_portname "clkdv"]  && $num_out_clks> 1)  ||( [string equal -nocase $clkout3_portname "clkdv"]  && $num_out_clks> 2)  ||( [string equal -nocase $clkout4_portname "clkdv"]  && $num_out_clks> 3)  ||( [string equal -nocase $clkout5_portname "clkdv"]  && $num_out_clks> 4)  ||( [string equal -nocase $clkout6_portname "clkdv"]  && $num_out_clks> 5) }  {  :>
<: set clkdv_unused [expr {( false)?true:false}]  :>
<: } :>
<: if { [string equal -nocase $clkout1_portname "clkfxdv"] ||( [string equal -nocase $clkout2_portname "clkfxdv"]  && $num_out_clks> 1)  ||( [string equal -nocase $clkout3_portname "clkfxdv"]  && $num_out_clks> 2)  ||( [string equal -nocase $clkout4_portname "clkfxdv"]  && $num_out_clks> 3)  ||( [string equal -nocase $clkout5_portname "clkfxdv"]  && $num_out_clks> 4)  ||( [string equal -nocase $clkout6_portname "clkfxdv"]  && $num_out_clks> 5) }  {  :>
<: set clkfxdv_unused [expr {( false)?true:false}]  :>
<: } :>
<: proc EvalSubstituting {parameters procedure {numlevels 1}} { :>
<:      set paramlist {} :>
<:      if {[string index $numlevels 0]!="#"} { :>
<:          set numlevels [expr $numlevels+1] :>
<:      } :>
<:      foreach parameter $parameters { :>
<:          upvar 1 $parameter $parameter\_value :>
<:          tcl::lappend paramlist \$$parameter [set $parameter\_value] :>
<:      } :>
<:     uplevel $numlevels [string map $paramlist $procedure] :>
<:  }  :>
<: ;#-------------------------------------- :>
<: ;#evaluate if CE ports are required :>
<: ;#-------------------------------------- :>
<: set clkout1_ce_used [expr {(( [string equal -nocase $clkout1_buf "BUFGCE"] || [string equal -nocase $clkout1_buf "BUFHCE"] || [string equal -nocase $clkout1_buf_param "Buffer_with_CE"] || [string equal -nocase $clkout1_buf "BUFR"] || [string equal -nocase $clkout1_buf_param "BUFGCE_DIV"]) )?true:false}]  :>
<: set clkout2_ce_used [expr {((( [string equal -nocase $clkout2_buf "BUFGCE"] || [string equal -nocase $clkout2_buf "BUFHCE"] || [string equal -nocase $clkout2_buf "BUFR"] || [string equal -nocase $clkout2_buf_param "Buffer_with_CE"] || [string equal -nocase $clkout2_buf_param "BUFGCE_DIV"])  && $num_out_clks> 1) )?true:false}]  :>
<: set clkout3_ce_used [expr {((( [string equal -nocase $clkout3_buf "BUFGCE"] || [string equal -nocase $clkout3_buf "BUFHCE"] || [string equal -nocase $clkout3_buf_param "Buffer_with_CE"] || [string equal -nocase $clkout3_buf "BUFR"] || [string equal -nocase $clkout3_buf_param "BUFGCE_DIV"])  && $num_out_clks> 2) )?true:false}]  :>
<: set clkout4_ce_used [expr {((( [string equal -nocase $clkout4_buf "BUFGCE"] || [string equal -nocase $clkout4_buf "BUFHCE"] || [string equal -nocase $clkout4_buf_param "Buffer_with_CE"] || [string equal -nocase $clkout4_buf "BUFR"] || [string equal -nocase $clkout4_buf_param "BUFGCE_DIV"])  && $num_out_clks> 3) )?true:false}]  :>
<: set clkout5_ce_used [expr {((( [string equal -nocase $clkout5_buf "BUFGCE"] || [string equal -nocase $clkout5_buf "BUFHCE"] || [string equal -nocase $clkout5_buf_param "Buffer_with_CE"] || [string equal -nocase $clkout5_buf "BUFR"] || [string equal -nocase $clkout5_buf_param "BUFGCE_DIV"])  && $num_out_clks> 4) )?true:false}]  :>
<: set clkout6_ce_used [expr {((( [string equal -nocase $clkout6_buf "BUFGCE"] || [string equal -nocase $clkout6_buf "BUFHCE"] || [string equal -nocase $clkout6_buf_param "Buffer_with_CE"] || [string equal -nocase $clkout6_buf "BUFR"] || [string equal -nocase $clkout6_buf_param "BUFGCE_DIV"])  && $num_out_clks> 5) )?true:false}]  :>
<: set clkout7_ce_used [expr {((( [string equal -nocase $clkout7_buf "BUFGCE"] || [string equal -nocase $clkout7_buf "BUFHCE"] || [string equal -nocase $clkout7_buf_param "Buffer_with_CE"] || [string equal -nocase $clkout7_buf "BUFR"] || [string equal -nocase $clkout7_buf_param "BUFGCE_DIV"])  && $num_out_clks> 6) )?true:false}]  :>
<: set clkout1_clr_used [expr {( [string equal -nocase $clkout1_buf "BUFR"] || [string equal -nocase $clkout1_buf_param "BUFGCE_DIV"])?true:false}]  :>
<: set clkout2_clr_used [expr {(( ([string equal -nocase $clkout2_buf "BUFR"] || [string equal -nocase $clkout2_buf_param "BUFGCE_DIV"]) && $num_out_clks> 1) )?true:false}]  :>
<: set clkout3_clr_used [expr {(( ([string equal -nocase $clkout3_buf "BUFR"] || [string equal -nocase $clkout3_buf_param "BUFGCE_DIV"]) && $num_out_clks> 2) )?true:false}]  :>
<: set clkout4_clr_used [expr {(( ([string equal -nocase $clkout4_buf "BUFR"] || [string equal -nocase $clkout4_buf_param "BUFGCE_DIV"]) && $num_out_clks> 3) )?true:false}]  :>
<: set clkout5_clr_used [expr {(( ([string equal -nocase $clkout5_buf "BUFR"] || [string equal -nocase $clkout5_buf_param "BUFGCE_DIV"]) && $num_out_clks> 4) )?true:false}]  :>
<: set clkout6_clr_used [expr {(( ([string equal -nocase $clkout6_buf "BUFR"] || [string equal -nocase $clkout6_buf_param "BUFGCE_DIV"]) && $num_out_clks> 5) )?true:false}]  :>
<: set clkout7_clr_used [expr {(( ([string equal -nocase $clkout7_buf "BUFR"] || [string equal -nocase $clkout7_buf_param "BUFGCE_DIV"]) && $num_out_clks> 6) )?true:false}]  :>
<: if { $is_v8 || $is_k8 }  {  :>
<: set bufr_div_attr_use false  :>
<: } else { :>
<: set bufr_div_attr_use [expr {(( $clkout1_clr_used || $clkout2_clr_used || $clkout3_clr_used || $clkout4_clr_used || $clkout5_clr_used || $clkout6_clr_used || $clkout7_clr_used) ) ?true:false}]  :>
<: } :>
<: set clkout1_bufr_last [expr {( $clkout1_clr_used && (!$clkout2_clr_used) && (!$clkout3_clr_used) && (!$clkout4_clr_used) && (!$clkout5_clr_used) && (!$clkout6_clr_used) && (!$clkout7_clr_used))?true:false}]  :>
<: set clkout2_bufr_last [expr {( $clkout2_clr_used && (!$clkout3_clr_used) && (!$clkout4_clr_used) && (!$clkout5_clr_used) && (!$clkout6_clr_used) && (!$clkout7_clr_used))?true:false}]  :>
<: set clkout3_bufr_last [expr {( $clkout3_clr_used && (!$clkout4_clr_used) && (!$clkout5_clr_used) && (!$clkout6_clr_used) && (!$clkout7_clr_used))?true:false}]  :>
<: set clkout4_bufr_last [expr {( $clkout4_clr_used && (!$clkout5_clr_used) && (!$clkout6_clr_used) && (!$clkout7_clr_used))?true:false}]  :>
<: set clkout5_bufr_last [expr {( $clkout5_clr_used && (!$clkout6_clr_used) && (!$clkout7_clr_used))?true:false}]  :>
<: set clkout6_bufr_last [expr {( $clkout6_clr_used && (!$clkout7_clr_used))?true:false}]  :>
<: set clkout7_bufr_last [expr {( $clkout7_clr_used)?true:false}]  :>
<: ;# :>
<: ;#-------------------------------------- :>
<: ;#check the feedback buffer type :>
<: ;#-------------------------------------- :>
<: set clkfb_buf $clkout1_buf :>
<: if { [string equal -nocase $clkfb_buf "BUFGCE"] || [string equal -nocase $clkfb_buf "BUFHCE"] || [string equal -nocase $clkfb_buf "BUFGCE_DIV"] }  {  :>
<: set clkfb_buf "BUFG";;#overide to bufg :>
<: } :>
<: ;# :>
<: ;#-------------------------------------- :>
<: ;#MMCM variables :>
<: ;#-------------------------------------- :>
<: ;#mmcm input attributes :>
<: set mmcm_notes [getStringValue "C_MMCM_NOTES"] :>
<: set mmcm_bandwidth [getStringValue "C_MMCM_BANDWIDTH"] :>
<: set mmcm_clkfbout_mult_f [getStringValue "C_MMCM_CLKFBOUT_MULT_F"] :>
<: set mmcm_clkfbout_mult_1 [::tcl::mathfunc::double [::tcl::mathfunc::double $mmcm_clkfbout_mult_f]] :>
<: set mmcm_clkfbout_mult [::tcl::mathfunc::int $mmcm_clkfbout_mult_1] :>
<: set mmcm_clkin1_period [getStringValue "C_MMCM_CLKIN1_PERIOD"] :>
<: set mmcm_clkin2_period [getStringValue "C_MMCM_CLKIN2_PERIOD"] :>
<: set mmcm_clkout4_cascade [getStringValue "C_MMCM_CLKOUT4_CASCADE"] :>
<: set mmcm_clock_hold [getStringValue "C_MMCM_CLOCK_HOLD"] :>
<: set mmcm_divclk_divide [getIntValue "C_MMCM_DIVCLK_DIVIDE"] :>
<: set mmcm_ref_jitter1 [getStringValue "C_MMCM_REF_JITTER1"] :>
<: set mmcm_ref_jitter2 [getStringValue "C_MMCM_REF_JITTER2"] :>
<: set mmcm_startup_wait [getStringValue "C_MMCM_STARTUP_WAIT"] :>
<: set mmcm_clkfb_period [ expr $mmcm_clkin1_period*$mmcm_divclk_divide] :>
<: set mmcm_ss_mode [getStringValue "C_SS_MODE"] :>
<: set mmcm_ss_mod_period [getIntValue "C_SS_MOD_PERIOD"] :>
<: set mmcm_ss_en [expr {( [getBooleanValue "C_USE_SPREAD_SPECTRUM"])?TRUE:FALSE}]  :>
<: ;#mmcm output attributes :>
<: set mmcm_clkout0_divide_f [getStringValue "C_MMCM_CLKOUT0_DIVIDE_F"] :>
<: set mmcm_clkout0_divide_1 [::tcl::mathfunc::double [::tcl::mathfunc::double $mmcm_clkout0_divide_f]] :>
<: set mmcm_clkout0_divide [::tcl::mathfunc::int $mmcm_clkout0_divide_1] :>
<: set mmcm_clkout1_divide [getIntValue "C_MMCM_CLKOUT1_DIVIDE"] :>
<: set mmcm_clkout2_divide [getIntValue "C_MMCM_CLKOUT2_DIVIDE"] :>
<: set mmcm_clkout3_divide [getIntValue "C_MMCM_CLKOUT3_DIVIDE"] :>
<: set mmcm_clkout4_divide [getIntValue "C_MMCM_CLKOUT4_DIVIDE"] :>
<: set mmcm_clkout5_divide [getIntValue "C_MMCM_CLKOUT5_DIVIDE"] :>
<: set mmcm_clkout6_divide [getIntValue "C_MMCM_CLKOUT6_DIVIDE"] :>
<: if { $mmcmbufgcediv2 == "true" || $pllbufgcediv2 == "true" }  {  :>
<: set mmcm_clkout1_divide_tb [expr $mmcm_clkout0_divide_f * $divide2] :>
<: } else  { :>
<: set mmcm_clkout1_divide_tb [getIntValue "C_MMCM_CLKOUT1_DIVIDE"] :>
<: } :>
<: if { $mmcmbufgcediv3 == "true" || $pllbufgcediv3 == "true" }  {  :>
<: set mmcm_clkout2_divide_tb [expr $mmcm_clkout0_divide_f * $divide3] :>
<: } else  { :>
<: set mmcm_clkout2_divide_tb [getIntValue "C_MMCM_CLKOUT2_DIVIDE"] :>
<: } :>
<: if { $mmcmbufgcediv4 == "true" || $pllbufgcediv4 == "true" }  {  :>
<: set mmcm_clkout3_divide_tb [expr $mmcm_clkout0_divide_f * $divide4] :>
<: } else  { :>
<: set mmcm_clkout3_divide_tb [getIntValue "C_MMCM_CLKOUT3_DIVIDE"] :>
<: } :>
<: if { $mmcmbufgcediv5 == "true"}  {  :>
<: set mmcm_clkout4_divide_tb [expr $mmcm_clkout0_divide_f * $divide5] :>
<: } else  { :>
<: set mmcm_clkout4_divide_tb [getIntValue "C_MMCM_CLKOUT4_DIVIDE"] :>
<: } :>
<: if { $mmcmbufgcediv6 == "true"}  {  :>
<: set mmcm_clkout5_divide_tb [expr $mmcm_clkout0_divide_f * $divide6] :>
<: } else  { :>
<: set mmcm_clkout5_divide_tb [getIntValue "C_MMCM_CLKOUT5_DIVIDE"] :>
<: } :>
<: if { $mmcmbufgcediv7 == "true"}  {  :>
<: set mmcm_clkout6_divide_tb [expr $mmcm_clkout0_divide_f * $divide7] :>
<: } else  { :>
<: set mmcm_clkout6_divide_tb [getIntValue "C_MMCM_CLKOUT6_DIVIDE"] :>
<: } :>
<: set mmcm_clkout0_duty_cycle [getStringValue "C_MMCM_CLKOUT0_DUTY_CYCLE"] :>
<: set mmcm_clkout1_duty_cycle [getStringValue "C_MMCM_CLKOUT1_DUTY_CYCLE"] :>
<: set mmcm_clkout2_duty_cycle [getStringValue "C_MMCM_CLKOUT2_DUTY_CYCLE"] :>
<: set mmcm_clkout3_duty_cycle [getStringValue "C_MMCM_CLKOUT3_DUTY_CYCLE"] :>
<: set mmcm_clkout4_duty_cycle [getStringValue "C_MMCM_CLKOUT4_DUTY_CYCLE"] :>
<: set mmcm_clkout5_duty_cycle [getStringValue "C_MMCM_CLKOUT5_DUTY_CYCLE"] :>
<: set mmcm_clkout6_duty_cycle [getStringValue "C_MMCM_CLKOUT6_DUTY_CYCLE"] :>
<: set mmcm_clkfbout_phase [getStringValue "C_MMCM_CLKFBOUT_PHASE"] :>
<: set mmcm_clkout0_phase [getStringValue "C_MMCM_CLKOUT0_PHASE"] :>
<: set mmcm_clkout1_phase [getStringValue "C_MMCM_CLKOUT1_PHASE"] :>
<: set mmcm_clkout2_phase [getStringValue "C_MMCM_CLKOUT2_PHASE"] :>
<: set mmcm_clkout3_phase [getStringValue "C_MMCM_CLKOUT3_PHASE"] :>
<: set mmcm_clkout4_phase [getStringValue "C_MMCM_CLKOUT4_PHASE"] :>
<: set mmcm_clkout5_phase [getStringValue "C_MMCM_CLKOUT5_PHASE"] :>
<: set mmcm_clkout6_phase [getStringValue "C_MMCM_CLKOUT6_PHASE"] :>
<: set mmcm_clkfbout_use_fine_ps [getStringValue "C_MMCM_CLKFBOUT_USE_FINE_PS"] :>
<: set mmcm_clkout0_use_fine_ps [getStringValue "C_MMCM_CLKOUT0_USE_FINE_PS"] :>
<: set mmcm_clkout1_use_fine_ps [getStringValue "C_MMCM_CLKOUT1_USE_FINE_PS"] :>
<: set mmcm_clkout2_use_fine_ps [getStringValue "C_MMCM_CLKOUT2_USE_FINE_PS"] :>
<: set mmcm_clkout3_use_fine_ps [getStringValue "C_MMCM_CLKOUT3_USE_FINE_PS"] :>
<: set mmcm_clkout4_use_fine_ps [getStringValue "C_MMCM_CLKOUT4_USE_FINE_PS"] :>
<: set mmcm_clkout5_use_fine_ps [getStringValue "C_MMCM_CLKOUT5_USE_FINE_PS"] :>
<: set mmcm_clkout6_use_fine_ps [getStringValue "C_MMCM_CLKOUT6_USE_FINE_PS"] :>
<: set override_mmcm [expr {( [getBooleanValue "C_OVERRIDE_MMCM"])?true:false}]  :>
