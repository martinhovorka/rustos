<: set C_CLKFBOUT_2 [getStringValue "C_CLKFBOUT_2"] :>
<: set C_Lock_1 [getStringValue "C_LOCK_1"] :>
<: set C_Lock_2 [getStringValue "C_LOCK_2"] :>
<: set C_Lock_3 [getStringValue "C_LOCK_3"] :>
