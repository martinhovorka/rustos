<: ;#----------------------- :>
<: ;#AXI4Lite DRP conversions :>
<: ;#----------------------- :>
<: set addZeros [list "00000000" "0000000" "000000" "00000" "0000" "000" "00" "0" ""] :>
<: set addZeros2 [list "00" "0" ""] :>
<: set addZeros3 [list "00" "0" ""] :>
<: if { !($is_plle2 || $is_plle3) }  {  :>
<: set int_mult_factor [expr int($mmcm_clkfbout_mult_f)]   :>
<: } else  { :>
<: set int_mult_factor $mmcm_clkfbout_mult   :>
<: } :>
<: set hex_mult_factor [dec2hex $int_mult_factor] :>
<: set hex_mult_factor [ttcl_string_concat [ttcl_string_concat "" [lindex $addZeros2 [string length $hex_mult_factor]] $hex_mult_factor]] :>
<: set frac_en_clkfbout_mid [expr ($mmcm_clkfbout_mult_f - [expr int($mmcm_clkfbout_mult_f)])] :>
<: if { $frac_en_clkfbout_mid == 0 }  {  :>
<: set frac_en_clkfbout 0 :>
<: set frac_mult_factor [expr int([expr ($mmcm_clkfbout_mult_f - [expr int($mmcm_clkfbout_mult_f)])*1000])] :>
<: } else  { :>
<: set frac_en_clkfbout 1 :>
<: set frac_mult_factor [expr int([expr ($mmcm_clkfbout_mult_f - [expr int($mmcm_clkfbout_mult_f)])*1000 + 1024])] :>
<: } :>
<: set hex_frac_mult_factor [dec2hex $frac_mult_factor] :>
<: set hex_frac_mult_factor [ttcl_string_concat [ttcl_string_concat "" [lindex $addZeros3 [string length $hex_frac_mult_factor]] $hex_frac_mult_factor]] :>
<: set int_clkfbout_phase [expr int($mmcm_clkfbout_phase * 1000)]   :>
<: set hex_clkfbout_phase [dec2hex $int_clkfbout_phase] :>
<: set hex_clkfbout_phase [ttcl_string_concat [ttcl_string_concat "" [lindex $addZeros [string length $hex_clkfbout_phase]] $hex_clkfbout_phase]] :>
<: set hex_divclk_divide [dec2hex $mmcm_divclk_divide] :>
<: set hex_divclk_divide [ttcl_string_concat [ttcl_string_concat "" [lindex $addZeros2 [string length $hex_divclk_divide]] $hex_divclk_divide]] :>
<: if { !($is_plle2 || $is_plle3) }  {  :>
<: set int_clkout0_div_factor [expr int($mmcm_clkout0_divide_f)]   :>
<: } else  { :>
<: set int_clkout0_div_factor $mmcm_clkout0_divide   :>
<: } :>
<: set hex_clkout0_div_factor [dec2hex $int_clkout0_div_factor] :>
<: set hex_clkout0_div_factor [ttcl_string_concat [ttcl_string_concat "" [lindex $addZeros2 [string length $hex_clkout0_div_factor]] $hex_clkout0_div_factor]] :>
<: set frac_en_clkout0_mid [expr ($mmcm_clkout0_divide_f - [expr int($mmcm_clkout0_divide_f)])] :>
<: if { $frac_en_clkout0_mid == 0 }  {  :>
<: set frac_en_clkout0 0 :>
<: set frac_clkout0_div_factor [expr int([expr ($mmcm_clkout0_divide_f - [expr int($mmcm_clkout0_divide_f)])*1000])] :>
<: } else  { :>
<: set frac_en_clkout0 1 :>
<: set frac_clkout0_div_factor [expr int([expr ($mmcm_clkout0_divide_f - [expr int($mmcm_clkout0_divide_f)])*1000 + 1024])] :>
<: } :>
<: set hex_frac_clkout0_div_factor [dec2hex $frac_clkout0_div_factor] :>
<: set hex_frac_clkout0_div_factor [ttcl_string_concat [ttcl_string_concat "" [lindex $addZeros3 [string length $hex_frac_clkout0_div_factor]] $hex_frac_clkout0_div_factor]] :>
<: set int_clkout0_duty_cycle [expr int($mmcm_clkout0_duty_cycle*100000)]   :>
<: set hex_clkout0_duty_cycle [dec2hex $int_clkout0_duty_cycle] :>
<: set hex_clkout0_duty_cycle [ttcl_string_concat [ttcl_string_concat "" [lindex $addZeros [string length $hex_clkout0_duty_cycle]] $hex_clkout0_duty_cycle]] :>
<: set int_clkout0_phase [expr int($mmcm_clkout0_phase * 1000)]   :>
<: set hex_clkout0_phase [format %.8x [expr {$int_clkout0_phase & 0xFFFFFFFF}]] :>
<: set hex_clkout0_phase [ttcl_string_concat [ttcl_string_concat "" [lindex $addZeros [string length $hex_clkout0_phase]] $hex_clkout0_phase]] :>
<: if { $num_out_clks> 1}  {  :>
<: set int_clkout1_duty_cycle [expr int($mmcm_clkout1_duty_cycle*100000)]   :>
<: set int_clkout1_phase [expr int($mmcm_clkout1_phase * 1000)]   :>
<: set hex_clkout1_divide [dec2hex $mmcm_clkout1_divide] :>
<: set hex_clkout1_divide [ttcl_string_concat [ttcl_string_concat "" [lindex $addZeros2 [string length $hex_clkout1_divide]] $hex_clkout1_divide]] :>
<: } else  { :>
<: set int_clkout1_duty_cycle 50000 :>
<: set int_clkout1_phase 0  :>
<: set hex_clkout1_divide "01" :>
<: } :>
<: if { $num_out_clks> 2}  {  :>
<: set int_clkout2_duty_cycle [expr int($mmcm_clkout2_duty_cycle*100000)]   :>
<: set int_clkout2_phase [expr int($mmcm_clkout2_phase * 1000)]   :>
<: set hex_clkout2_divide [dec2hex $mmcm_clkout2_divide] :>
<: set hex_clkout2_divide [ttcl_string_concat [ttcl_string_concat "" [lindex $addZeros2 [string length $hex_clkout2_divide]] $hex_clkout2_divide]] :>
<: } else  { :>
<: set int_clkout2_duty_cycle 50000 :>
<: set int_clkout2_phase 0  :>
<: set hex_clkout2_divide "01" :>
<: } :>
<: if { $num_out_clks> 3}  {  :>
<: set int_clkout3_duty_cycle [expr int($mmcm_clkout3_duty_cycle*100000)]   :>
<: set int_clkout3_phase [expr int($mmcm_clkout3_phase * 1000)]   :>
<: set hex_clkout3_divide [dec2hex $mmcm_clkout3_divide] :>
<: set hex_clkout3_divide [ttcl_string_concat [ttcl_string_concat "" [lindex $addZeros2 [string length $hex_clkout3_divide]] $hex_clkout3_divide]] :>
<: } else  { :>
<: set int_clkout3_duty_cycle 50000 :>
<: set int_clkout3_phase 0  :>
<: set hex_clkout3_divide "01" :>
<: } :>
<: if { $num_out_clks> 4}  {  :>
<: set int_clkout4_duty_cycle [expr int($mmcm_clkout4_duty_cycle*100000)]   :>
<: set int_clkout4_phase [expr int($mmcm_clkout4_phase * 1000)]   :>
<: set hex_clkout4_divide [dec2hex $mmcm_clkout4_divide] :>
<: set hex_clkout4_divide [ttcl_string_concat [ttcl_string_concat "" [lindex $addZeros2 [string length $hex_clkout4_divide]] $hex_clkout4_divide]] :>
<: } else  { :>
<: set int_clkout4_duty_cycle 50000 :>
<: set int_clkout4_phase 0  :>
<: set hex_clkout4_divide "01" :>
<: } :>
<: if { $num_out_clks> 5}  {  :>
<: set int_clkout5_duty_cycle [expr int($mmcm_clkout5_duty_cycle*100000)]   :>
<: set int_clkout5_phase [expr int($mmcm_clkout5_phase * 1000)]   :>
<: set hex_clkout5_divide [dec2hex $mmcm_clkout5_divide] :>
<: set hex_clkout5_divide [ttcl_string_concat [ttcl_string_concat "" [lindex $addZeros2 [string length $hex_clkout5_divide]] $hex_clkout5_divide]] :>
<: } else  { :>
<: set int_clkout5_duty_cycle 50000 :>
<: set int_clkout5_phase 0  :>
<: set hex_clkout5_divide "01" :>
<: } :>
<: if { $num_out_clks> 6}  {  :>
<: set int_clkout6_duty_cycle [expr int($mmcm_clkout6_duty_cycle*100000)]   :>
<: set int_clkout6_phase [expr int($mmcm_clkout6_phase * 1000)]   :>
<: set hex_clkout6_divide [dec2hex $mmcm_clkout6_divide] :>
<: set hex_clkout6_divide [ttcl_string_concat [ttcl_string_concat "" [lindex $addZeros2 [string length $hex_clkout6_divide]] $hex_clkout6_divide]] :>
<: } else  { :>
<: set int_clkout6_duty_cycle 50000 :>
<: set int_clkout6_phase 0  :>
<: set hex_clkout6_divide "01" :>
<: } :>
<: set hex_clkout1_duty_cycle [dec2hex $int_clkout1_duty_cycle] :>
<: set hex_clkout1_duty_cycle [ttcl_string_concat [ttcl_string_concat "" [lindex $addZeros [string length $hex_clkout1_duty_cycle]] $hex_clkout1_duty_cycle]] :>
<: set hex_clkout1_phase [format %.8x [expr {$int_clkout1_phase & 0xFFFFFFFF}]] :>
<: set hex_clkout1_phase [ttcl_string_concat [ttcl_string_concat "" [lindex $addZeros [string length $hex_clkout1_phase]] $hex_clkout1_phase]] :>
<: set hex_clkout2_duty_cycle [dec2hex $int_clkout2_duty_cycle] :>
<: set hex_clkout2_duty_cycle [ttcl_string_concat [ttcl_string_concat "" [lindex $addZeros [string length $hex_clkout2_duty_cycle]] $hex_clkout2_duty_cycle]] :>
<: set hex_clkout2_phase [format %.8x [expr {$int_clkout2_phase & 0xFFFFFFFF}]] :>
<: set hex_clkout2_phase [ttcl_string_concat [ttcl_string_concat "" [lindex $addZeros [string length $hex_clkout2_phase]] $hex_clkout2_phase]] :>
<: set hex_clkout3_duty_cycle [dec2hex $int_clkout3_duty_cycle] :>
<: set hex_clkout3_duty_cycle [ttcl_string_concat [ttcl_string_concat "" [lindex $addZeros [string length $hex_clkout3_duty_cycle]] $hex_clkout3_duty_cycle]] :>
<: set hex_clkout3_phase [format %.8x [expr {$int_clkout3_phase & 0xFFFFFFFF}]] :>
<: set hex_clkout3_phase [ttcl_string_concat [ttcl_string_concat "" [lindex $addZeros [string length $hex_clkout3_phase]] $hex_clkout3_phase]] :>
<: set hex_clkout4_duty_cycle [dec2hex $int_clkout4_duty_cycle] :>
<: set hex_clkout4_duty_cycle [ttcl_string_concat [ttcl_string_concat "" [lindex $addZeros [string length $hex_clkout4_duty_cycle]] $hex_clkout4_duty_cycle]] :>
<: set hex_clkout4_phase [format %.8x [expr {$int_clkout4_phase & 0xFFFFFFFF}]] :>
<: set hex_clkout4_phase [ttcl_string_concat [ttcl_string_concat "" [lindex $addZeros [string length $hex_clkout4_phase]] $hex_clkout4_phase]] :>
<: set hex_clkout5_duty_cycle [dec2hex $int_clkout5_duty_cycle] :>
<: set hex_clkout5_duty_cycle [ttcl_string_concat [ttcl_string_concat "" [lindex $addZeros [string length $hex_clkout5_duty_cycle]] $hex_clkout5_duty_cycle]] :>
<: set hex_clkout5_phase [format %.8x [expr {$int_clkout5_phase & 0xFFFFFFFF}]] :>
<: set hex_clkout5_phase [ttcl_string_concat [ttcl_string_concat "" [lindex $addZeros [string length $hex_clkout5_phase]] $hex_clkout5_phase]] :>
<: set hex_clkout6_duty_cycle [dec2hex $int_clkout6_duty_cycle] :>
<: set hex_clkout6_duty_cycle [ttcl_string_concat [ttcl_string_concat "" [lindex $addZeros [string length $hex_clkout6_duty_cycle]] $hex_clkout6_duty_cycle]] :>
<: set hex_clkout6_phase [format %.8x [expr {$int_clkout6_phase & 0xFFFFFFF}]] :>
<: set hex_clkout6_phase [ttcl_string_concat [ttcl_string_concat "" [lindex $addZeros [string length $hex_clkout6_phase]] $hex_clkout6_phase]] :>
<: ;#------------------------------- :>
<: ;#Include "hidden" test features :>
<: ;#------------------------------- :>
<: set sv_test_str [getSystemProperty "SV_TEST" "NULL"] :>
<: ;#boolean sv_test     = sv_test_str.equalsIgnoreCase("1") :>
<: set sv_test [expr {( false)?true:false}]  :>
<: set u_score "_" :>
<: set up "_p" :>
<: set un "_n" :>
<: set uce "_ce" :>
<: set uclr "_clr" :>
<: set reconfig_adv [get_property PARAM_VALUE.PHASE_DUTY_CONFIG] :>
<: ;#----------------------- :>
<: ;#Matched routing     :>
<: ;#----------------------- :>
<: set clkout1_matched [getIntValue "C_CLKOUT1_MATCHED_ROUTING"]  :>
<: set clkout2_matched [getIntValue "C_CLKOUT2_MATCHED_ROUTING"]  :>
<: set clkout3_matched [getIntValue "C_CLKOUT3_MATCHED_ROUTING"]  :>
<: set clkout4_matched [getIntValue "C_CLKOUT4_MATCHED_ROUTING"]  :>
<: set clkout5_matched [getIntValue "C_CLKOUT5_MATCHED_ROUTING"]  :>
<: set clkout6_matched [getIntValue "C_CLKOUT6_MATCHED_ROUTING"]  :>
<: set clkout7_matched [getIntValue "C_CLKOUT7_MATCHED_ROUTING"]  :>
<: set list_matched "" :>
<: if {$clkout1_matched == "true"} { :>
<: lappend list_matched "$out1_port"  :>
<: } :>
<: if {$clkout2_matched == "true"} { :>
<: lappend list_matched "$out2_port"  :>
<: } :>
<: if {$clkout3_matched == "true"} { :>
<: lappend list_matched "$out3_port"  :>
<: } :>
<: if {$clkout4_matched == "true"} { :>
<: lappend list_matched "$out4_port"  :>
<: } :>
<: if {$clkout5_matched == "true"} { :>
<: lappend list_matched "$out5_port"  :>
<: } :>
<: if {$clkout6_matched == "true"} { :>
<: lappend list_matched "$out6_port"  :>
<: } :>
<: if {$clkout7_matched == "true"} { :>
<: lappend list_matched "$out7_port"  :>
<: } :>
<: set length_matched [llength $list_matched]   :>
<: if  {$length_matched <= 1} { :>
<: set matched false  :>
<: } else  { :>
<: set matched true  :>
<: } :>
