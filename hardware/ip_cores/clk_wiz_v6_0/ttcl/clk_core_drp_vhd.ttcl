<: if {![expr [getIntValue "C_INTERFACE_SELECTION"] == 1]} {ttcl_return} :>
<: set ComponentName [getComponentNameString] :>
<: setOutputDirectory "./" :>
<: setFileName [ttcl_add $ComponentName "_clk_wiz_drp"] :>
<: setFileExtension ".vhd" :>
<#: ttcl/variables.ttcl :>
