<: } elseif { $clkout4_seq_number == [expr $clkout6_seq_number + 1]} { :>
        seq_reg4 <= seq_reg4(6 downto 0) & seq_reg6(7);
<: } elseif { $clkout4_seq_number == [expr $clkout7_seq_number + 1]} { :>
        seq_reg4 <= seq_reg4(6 downto 0) & seq_reg7(7);
<: } :>
     end if;
  end process;
<: } :>
<: if { $num_out_clks>= 5}  {  :>

  clkout5_buf : <=: clkout5_buf :>
  port map
   (O   => <=: out5_port :>,
    CE  => seq_reg5(7),
    I   => <: print $out5_port$u_score$ComponentName :>);

<: if { ($is_v8 || $is_k8) } { :>
  clkout5_buf_en : BUFGCE
  port map
   (O   => <: print $out5_port$u_score$ComponentName :>_en_clk,
