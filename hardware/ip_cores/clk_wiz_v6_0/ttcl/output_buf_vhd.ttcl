    I   => <: print $out5_port$u_score$ComponentName :>);
<: } else  { :>
  clkout5_buf_en : BUFH
  port map
   (O   => <: print $out5_port$u_score$ComponentName :>_en_clk,
    I   => <: print $out5_port$u_score$ComponentName :>);
<: } :>
   
  process(<: print $out5_port$u_score$ComponentName :>_en_clk)
  begin
     if <: print $out5_port$u_score$ComponentName :>_en_clk'event and <: print $out5_port$u_score$ComponentName :>_en_clk = '1' then
<: if { $clkout5_seq_number == 1}  {  :>
        seq_reg5 <= seq_reg5(6 downto 0) & <=: locked_port :>_int;
<: } elseif { $clkout5_seq_number == [expr $clkout1_seq_number + 1]} { :>
