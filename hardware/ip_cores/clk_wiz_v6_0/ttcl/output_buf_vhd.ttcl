<: } elseif { $clkout5_seq_number == [expr $clkout2_seq_number + 1]} { :>
        seq_reg5 <= seq_reg5(6 downto 0) & seq_reg2(7);
<: } elseif { $clkout5_seq_number == [expr $clkout3_seq_number + 1]} { :>
        seq_reg5 <= seq_reg5(6 downto 0) & seq_reg3(7);
<: } elseif { $clkout5_seq_number == [expr $clkout4_seq_number + 1]} { :>
        seq_reg5 <= seq_reg5(6 downto 0) & seq_reg4(7);
<: } elseif { $clkout5_seq_number == [expr $clkout6_seq_number + 1]} { :>
        seq_reg5 <= seq_reg5(6 downto 0) & seq_reg6(7);
<: } elseif { $clkout5_seq_number == [expr $clkout7_seq_number + 1]} { :>
        seq_reg5 <= seq_reg5(6 downto 0) & seq_reg7(7);
<: } :>
     end if;
  end process;
