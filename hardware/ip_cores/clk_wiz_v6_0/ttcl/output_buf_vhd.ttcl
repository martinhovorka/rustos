  begin
     if <: print $out4_port$u_score$ComponentName :>_en_clk'event and <: print $out4_port$u_score$ComponentName :>_en_clk = '1' then
<: if { $clkout4_seq_number == 1}  {  :>
        seq_reg4 <= seq_reg4(6 downto 0) & <=: locked_port :>_int;
<: } elseif { $clkout4_seq_number == [expr $clkout1_seq_number + 1]} { :>
