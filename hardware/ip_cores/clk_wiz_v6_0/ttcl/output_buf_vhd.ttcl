<: if { $num_out_clks>= 6}  {  :>

  clkout6_buf : <=: clkout6_buf :>
  port map
   (O   => <=: out6_port :>,
    CE  => seq_reg6(7),
    I   => <: print $out6_port$u_score$ComponentName :>);

<: if { ($is_v8 || $is_k8) } { :>
  clkout6_buf_en : BUFGCE
  port map
   (O   => <: print $out6_port$u_score$ComponentName :>_en_clk,
    CE  => '1',
    I   => <: print $out6_port$u_score$ComponentName :>);
<: } else  { :>
  clkout6_buf_en : BUFH
  port map
   (O   => <: print $out6_port$u_score$ComponentName :>_en_clk,
    I   => <: print $out6_port$u_score$ComponentName :>);
<: } :>
   
  process(<: print $out6_port$u_score$ComponentName :>_en_clk)
  begin
     if <: print $out6_port$u_score$ComponentName :>_en_clk'event and <: print $out6_port$u_score$ComponentName :>_en_clk = '1' then
<: if { $clkout6_seq_number == 1}  {  :>
        seq_reg6 <= seq_reg6(6 downto 0) & <=: locked_port :>_int;
<: } elseif { $clkout6_seq_number == [expr $clkout1_seq_number + 1]} { :>
        seq_reg6 <= seq_reg6(6 downto 0) & seq_reg1(7);
<: } elseif { $clkout6_seq_number == [expr $clkout2_seq_number + 1]} { :>
        seq_reg6 <= seq_reg6(6 downto 0) & seq_reg2(7);
<: } elseif { $clkout6_seq_number == [expr $clkout3_seq_number + 1]} { :>
        seq_reg6 <= seq_reg6(6 downto 0) & seq_reg3(7);
<: } elseif { $clkout6_seq_number == [expr $clkout4_seq_number + 1]} { :>
        seq_reg6 <= seq_reg6(6 downto 0) & seq_reg4(7);
<: } elseif { $clkout6_seq_number == [expr $clkout5_seq_number + 1]} { :>
        seq_reg6 <= seq_reg6(6 downto 0) & seq_reg5(7);
<: } elseif { $clkout6_seq_number == [expr $clkout7_seq_number + 1]} { :>
        seq_reg6 <= seq_reg7(6 downto 0) & seq_reg7(7);
<: } :>
     end if;
  end process;
<: } :>
<: if { $num_out_clks>= 7}  {  :>

  clkout7_buf : <=: clkout7_buf :>
  port map
   (O   => <=: out7_port :>,
    CE  => seq_reg7(7),
    I   => <: print $out7_port$u_score$ComponentName :>);

<: if { ($is_v8 || $is_k8) } { :>
  clkout7_buf_en : BUFGCE
  port map
   (O   => <: print $out7_port$u_score$ComponentName :>_en_clk,
    CE  => '1',
    I   => <: print $out7_port$u_score$ComponentName :>);
<: } else  { :>
  clkout7_buf_en : BUFH
  port map
   (O   => <: print $out7_port$u_score$ComponentName :>_en_clk,
    I   => <: print $out7_port$u_score$ComponentName :>);
<: } :>
   
  process(<: print $out7_port$u_score$ComponentName :>_en_clk)
  begin
     if <: print $out7_port$u_score$ComponentName :>_en_clk'event and <: print $out7_port$u_score$ComponentName :>_en_clk = '1' then
<: if { $clkout7_seq_number == 1}  {  :>
        seq_reg7 <= seq_reg7(6 downto 0) & <=: locked_port :>_int;
<: } elseif { $clkout7_seq_number == [expr $clkout1_seq_number + 1]} { :>
        seq_reg7 <= seq_reg7(6 downto 0) & seq_reg1(7);
<: } elseif { $clkout7_seq_number == [expr $clkout2_seq_number + 1]} { :>
        seq_reg7 <= seq_reg7(6 downto 0) & seq_reg2(7);
<: } elseif { $clkout7_seq_number == [expr $clkout3_seq_number + 1]} { :>
        seq_reg7 <= seq_reg7(6 downto 0) & seq_reg3(7);
<: } elseif { $clkout7_seq_number == [expr $clkout4_seq_number + 1]} { :>
        seq_reg7 <= seq_reg7(6 downto 0) & seq_reg4(7);
<: } elseif { $clkout7_seq_number == [expr $clkout5_seq_number + 1]} { :>
        seq_reg7 <= seq_reg7(6 downto 0) & seq_reg5(7);
<: } elseif { $clkout7_seq_number == [expr $clkout6_seq_number + 1]} { :>
        seq_reg7 <= seq_reg7(6 downto 0) & seq_reg6(7);
<: } :>
     end if;
  end process;
<: } :>
   
<: } :>
<#: ttcl/bar_clk_out_vhd.ttcl :>
