<: } :>

<: if { $C_ENABLE_USER_CLOCK3 } { :>
xpm_cdc_single_rst_U3: xpm_cdc_single
  generic map (
     DEST_SYNC_FF   => 4, -- integer; range: 2-10
     SIM_ASSERT_CHK => 0, -- integer; 0=disable simulation messages, 1=enable simulation messages
     SRC_INPUT_REG  => 1  -- integer; 0=do not register input, 1=register input
  )
  port map (
     src_clk  => Ref_Clk,  -- optional; required when SRC_INPUT_REG = 1
     src_in   => Reset,
     dest_clk => User_Clk3,
     dest_out => Reset_u3
  );
Division_by_32_Clk3: process(User_Clk3)
 begin
  if rising_edge(User_Clk3) then
    if(Reset_u3 = RESET_ACTIVE) then
      clk_div_Clk3 <= (others => '0');
      clk_div_Clk3_st <= (others => '0');
      clk_div_32_Clk3 <= clk_div_Clk3(COUNTER1_WIDTH-1);
      clk_div_32_Clk3_st <= clk_div_Clk3_st(COUNTER4_WIDTH_STOP-1);
   else 
      clk_div_Clk3 <= clk_div_Clk3 + '1';
      clk_div_Clk3_st <= clk_div_Clk3_st + '1';
      clk_div_32_Clk3 <= clk_div_Clk3(COUNTER1_WIDTH-1);
      clk_div_32_Clk3_st <= clk_div_Clk3_st(COUNTER4_WIDTH_STOP-1);
   end if;
  end if;
 end process Division_by_32_Clk3;
 
xpm_cdc_single_inst3: xpm_cdc_single
  generic map (
     DEST_SYNC_FF   => 4, -- integer; range: 2-10
     SIM_ASSERT_CHK => 0, -- integer; 0=disable simulation messages, 1=enable simulation messages
     SRC_INPUT_REG  => 1  -- integer; 0=do not register input, 1=register input
  )
  port map (
     src_clk  => User_Clk3,  -- optional; required when SRC_INPUT_REG = 1
     src_in   => clk_div_32_Clk3,
     dest_clk => Ref_Clk,
     dest_out => clk_div_32_Clk3_out
  );

 
Synchronization_Clk3: process(Ref_Clk)
 begin
 if rising_edge(Ref_Clk) then
    if(Reset = RESET_ACTIVE) then
     clk_div_32_d1_Clk3 <= '0';
     clk_div_32_d2_Clk3 <= '0';
     clk_div_32_d3_Clk3 <= '0';
    else
     clk_div_32_d1_Clk3 <= clk_div_32_Clk3_out;
     clk_div_32_d2_Clk3 <= clk_div_32_d1_Clk3;
     clk_div_32_d3_Clk3 <= clk_div_32_d2_Clk3;
    end if;
end if;
 end process Synchronization_Clk3;
 
clk_div_32_xor_clk3 <=  clk_div_32_d2_Clk3 xor clk_div_32_d3_Clk3;
xpm_cdc_single_inst3_st: xpm_cdc_single
  generic map (
     DEST_SYNC_FF   => 4, -- integer; range: 2-10
     SIM_ASSERT_CHK => 0, -- integer; 0=disable simulation messages, 1=enable simulation messages
     SRC_INPUT_REG  => 1  -- integer; 0=do not register input, 1=register input
  )
  port map (
     src_clk  => User_Clk3,  -- optional; required when SRC_INPUT_REG = 1
     src_in   => clk_div_32_Clk3_st,
     dest_clk => Ref_Clk,
     dest_out => clk_div_32_Clk3_out_st
  );

 
Synchronization_Clk3_st: process(Ref_Clk)
 begin
 if rising_edge(Ref_Clk) then
    if(Reset = RESET_ACTIVE) then
     clk_div_32_d1_Clk3_st <= '0';
     clk_div_32_d2_Clk3_st <= '0';
     clk_div_32_d3_Clk3_st <= '0';
    else
     clk_div_32_d1_Clk3_st <= clk_div_32_Clk3_out_st;
     clk_div_32_d2_Clk3_st <= clk_div_32_d1_Clk3_st;
     clk_div_32_d3_Clk3_st <= clk_div_32_d2_Clk3_st;
    end if;
end if;
 end process Synchronization_Clk3_st;
 
clk_div_32_xor_clk3_st <=  clk_div_32_d2_Clk3_st xor clk_div_32_d3_Clk3_st;

Counter_2_Proc_Clk3: process(Ref_Clk)
begin
 if rising_edge(Ref_Clk) then
  if(Reset = RESET_ACTIVE) then
     count_neg_Clk3 <= ( others => '0');
     count_pos_Clk3 <= ( others => '0');
  else
   if (clk_div_32_d2_Clk3 = '1') then
     count_pos_Clk3 <= count_pos_Clk3 + '1';
     count_neg_Clk3 <= ( others => '0');
   else 
     count_neg_Clk3 <= count_neg_Clk3 + '1';
     count_pos_Clk3 <= ( others => '0');
   end if;
  end if;
 end if;
end process Counter_2_Proc_Clk3;

Reg_Count_Proc_Clk3: process(Ref_Clk)
begin
 if rising_edge(Ref_Clk) then
   if(Reset = RESET_ACTIVE) then
     count_neg_final_Clk3 <= "<: print $Count_clk3_by2_plus1 :>";
     count_pos_final_Clk3 <= "<: print $Count_clk3_by2_plus1 :>";
   else
   if ( clk_div_32_xor_clk3 = '1'  ) then
    if ( clk_div_32_d2_Clk3 = '1'  ) then
     count_neg_final_Clk3 <= count_neg_Clk3;
   else 
     count_pos_final_Clk3 <= count_pos_Clk3;
   end if;
   end if;
 end if;
 end if;
end process Reg_Count_Proc_Clk3;

Count_Proc_Clk3: process(Ref_Clk)
begin
 if rising_edge(Ref_Clk) then
    if (( clk_div_32_xor_clk3_st = '1' ) or (Reset = RESET_ACTIVE) ) then
     Count_up_down3 <= 0;
   else 
     Count_up_down3 <= Count_up_down3 + 1;
   end if;
 end if;
end process Count_Proc_Clk3;

Count_xor_Clk3: process(Ref_Clk)
begin
 if rising_edge(Ref_Clk) then
    if ((Reset = RESET_ACTIVE) ) then
     count3_xor <= '0';
   else 
        if (clk_div_32_xor_clk_all_st = '1') then
     count3_xor <= '1';
        else
     count3_xor <= count3_xor;
        end if;
   end if;
 end if;
end process Count_xor_Clk3;


Glitch_less_Proc_Clk3: process(Ref_Clk)
begin
 if rising_edge(Ref_Clk) then
   if(Reset = RESET_ACTIVE) then
     glitch3_lesser <= '1';
   else
   if ( count_pos_final_Clk3 <= (count_neg_final_Clk3 + 20)) then
     glitch3_lesser <= '1';
   else 
     glitch3_lesser <= '0';
   end if;
 end if;
 end if;
end process Glitch_less_Proc_Clk3;

Glitch_grt_Proc_Clk3: process(Ref_Clk)
begin
 if rising_edge(Ref_Clk) then
   if(Reset = RESET_ACTIVE) then
     glitch3_greater <= '1';
   else
   if ( count_pos_final_Clk3 >= (count_neg_final_Clk3 - 10)) then
     glitch3_greater <= '1';
   else 
     glitch3_greater <= '0';
   end if;
 end if;
 end if;
end process Glitch_grt_Proc_Clk3;

Glitch_Detect_Proc_Clk3: process(Ref_Clk)
begin
 if rising_edge(Ref_Clk) then
   if(Reset = RESET_ACTIVE) then
     clk_glitch_sig_Clk3 <= '0';
   else
   if ( glitch3_greater = '1'  and glitch3_lesser = '1' ) then
     clk_glitch_sig_Clk3 <= '0';
   else 
     clk_glitch_sig_Clk3 <= '1';
   end if;
 end if;
 end if;
end process Glitch_Detect_Proc_Clk3;

-- Interrupt_Proc_Clk3: process(Ref_Clk)
-- begin
 -- if rising_edge(Ref_Clk) then
   -- if (count_pos_final_Clk3 > 10) then
     -- clk_OOR_sig_Clk3 <= '0';
   -- else 
     -- clk_OOR_sig_Clk3 <= '1';
   -- end if;
 -- end if;
-- end process Interrupt_Proc_Clk3;

Lesser_Proc_Clk3: process(Ref_Clk)
begin
 if rising_edge(Ref_Clk) then
   if(Reset = RESET_ACTIVE) then
     clk_less_sig_Clk3 <= '0';
   else
   if ((count_pos_final_Clk3 >  "<: print $Count_clk3_by2_plus1 :>") and (count_neg_final_Clk3 >  "<: print $Count_clk3_by2_plus1 :>")) then
     clk_less_sig_Clk3 <= '1';
   else 
     clk_less_sig_Clk3 <= '0';
   end if;
 end if;
 end if;
end process Lesser_Proc_Clk3;

Greater_Proc_Clk3: process(Ref_Clk)
begin
 if rising_edge(Ref_Clk) then
   if(Reset = RESET_ACTIVE) then
     clk_greater_sig_Clk3 <= '0';
   else
   if ((count_pos_final_Clk3 <  "<: print $Count_clk3_by2_minus1 :>") and (count_neg_final_Clk3 <  "<: print $Count_clk3_by2_minus1 :>")) then
     clk_greater_sig_Clk3 <= '1';
   else 
     clk_greater_sig_Clk3 <= '0';
   end if;
 end if;
 end if;
end process Greater_Proc_Clk3;


Stop_less_Proc_Clk3: process(Ref_Clk)
begin
 if rising_edge(Ref_Clk) then
   if(Reset = RESET_ACTIVE) then
     stop3_lesser <= '0';
   else
   if (Count_up_down3 < - 50) then
     stop3_lesser <= '1';
   else 
     stop3_lesser <= '0';
   end if;
 end if;
 end if;
end process Stop_less_Proc_Clk3;

Stop_grt_Proc_Clk3: process(Ref_Clk)
begin
 if rising_edge(Ref_Clk) then
   if(Reset = RESET_ACTIVE) then
     stop3_greater <= '0';
   else
   if (Count_up_down3 > <: print $Count_clk3_stop :>) then
     stop3_greater <= '1';
   else 
     stop3_greater <= '0';
   end if;
 end if;
 end if;
end process Stop_grt_Proc_Clk3;

proc_Clk_stop_CLk3: process(Ref_Clk)
begin
 if rising_edge(Ref_Clk) then
   if(Reset = RESET_ACTIVE) then
    clk_stop_clk3 <= '0';
   else
    if ( (stop3_greater = '1') or (stop3_lesser = '1') ) then
     clk_stop_clk3 <= '1';
    else 
     clk_stop_clk3 <= '0';
    end if;
   end if;
 end if;
end process proc_Clk_stop_CLk3;

Clk_Stop(3) <= clk_stop_clk3 ;
Clk_Greater(3) <= clk_greater_sig_Clk3;
Clk_Lesser(3) <= clk_less_sig_Clk3;
Clk_OOR(3) <= clk_greater_sig_Clk3 or clk_less_sig_Clk3;
Clock_Glitch(3) <= clk_glitch_sig_Clk3;
<: } else { :>
Clk_OOR(3) <= '0';
Clk_stop(3) <= '0';
Clk_Greater(3) <= '0';
Clk_Lesser(3) <= '0';
Clock_Glitch(3) <= '0';
<: } :>

end xilinx;
