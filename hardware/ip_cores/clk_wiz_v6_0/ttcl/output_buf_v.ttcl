<: if { ($mmcm_compensation != "INTERNAL") } { :>
<: if  { $auto_ext_feedback }  { :>
  wire clkfb_bufg_out;
  wire clkfb_oddr_out;
  // Instantiate bufg on fbout
  BUFG clkfbout_bufg
   (.O  (clkfb_bufg_out),
    .I  (clkfbout_<=: ComponentName :>));

  // Forward the feedback clock off-chip
<: if { $is_v8 || $is_k8 }  {  :>
  ODDRE1 
  clkfbout_oddr
    (.Q  (clkfb_oddr_out),
     .C  (clkfb_bufg_out),
     .D1 (1'b1),
     .D2 (1'b0),
     .SR (1'b0));
<: } else { :>
  ODDR clkfbout_oddr
   (.Q  (clkfb_oddr_out),
    .C  (clkfb_bufg_out),
    .CE (1'b1),
    .D1 (1'b1),
    .D2 (1'b0),
    .R  (1'b0),
    .S  (1'b0));
<: } :>
<: ;#back to the standard PLL/MMCM requirements for feedback :>

<: if { $safe_clk_startup}  {  :>
  BUFG  clkf_buf
   (.O (clkfbout_buf_<=: ComponentName :>),
    .I (clkfbout_<=: ComponentName :>));
<: } :>
<: } elseif  { [string equal -nocase $clkout1_buf "No_buffer"]}  { :>
<: if { $ext_feedback}  {  :>
  assign <=: fbout_port :> = clkfbout_<=: ComponentName :>;
<: if { $safe_clk_startup}  {  :>

  BUFG  clkf_buf
   (.O (clkfbout_buf_<=: ComponentName :>),
    .I (clkfbout_<=: ComponentName :>));
<: } :>
<: } elseif  { $use_phase_alignment}  { :>
  assign clkfbout_buf_<=: ComponentName :> = clkfbout_<=: ComponentName :>;
<: } :>
<: } else  { :>
<: if { $ext_feedback}  {  :>
<: if { $is_clk0_fb}  {  :>
  assign <=: fbout_port :> = clkout0;

<: if { $safe_clk_startup}  {  :>
  BUFG  clkf_buf
   (.O (clkfbout_buf_<=: ComponentName :>),
    .I (clkfbout_<=: ComponentName :>));
<: } :>
<: } else  { :>
  assign <=: fbout_port :> = clkfbout_<=: ComponentName :>;

<: if { $safe_clk_startup}  {  :>
  BUFG  clkf_buf
   (.O (clkfbout_buf_<=: ComponentName :>),
    .I (clkfbout_<=: ComponentName :>));
<: } :>
<: } :>
<: } elseif  { $use_phase_alignment}  { :>
<: if { $is_clk0_fb}  {  :>

<: } else  { :>

  <=: clkfb_buf :> clkf_buf
   (.O (clkfbout_buf_<=: ComponentName :>),
    .I (clkfbout_<=: ComponentName :>));
<: } :>
<: } :>
<: } :>

<: if  { (($safe_clk_startup) && !$use_phase_alignment) || (!$use_phase_alignment && $mmcm_compensation == "BUF_IN")}  { :>
  BUFG clkf_buf
   (.O (clkfbout_buf_<=: ComponentName :>),
    .I (clkfbout_<=: ComponentName :>));
<: } :>

<: if { $auto_diff_feedback}  {  :>
  // Differential output clock buffer
  OBUFDS clkfbout_bufds
   (.O  (<=: fbout_p_port :>),
    .OB (<=: fbout_n_port :>),
    .I  (clkfb_oddr_out));
<: } elseif  { $auto_sing_feedback}  { :>
  assign <=: fbout_port :> = clkfb_oddr_out;
<: } :>

<: } :>

<: if { ($mmcm_compensation == "INTERNAL") } { :>
  assign clkfbout_buf_<=: ComponentName :> = clkfbout_<=: ComponentName :>;
<: } :>


<: if { !$safe_clk_startup}  {  :>
<: if { [string equal -nocase $clkout1_buf "No_buffer"]}  {  :>
  assign <=: out1_port :> = <: print $out1_port$u_score$ComponentName :>;
<: } else  { :>
<: if { [string equal -nocase $clkout1_buf "BUFR"] || [string equal -nocase $clkout1_buf "BUFGCE_DIV"]}  {  :>
  <=: clkout1_buf :> 
<: if { [string equal -nocase $clkout1_buf "BUFR"] }  {  :>
  #(.BUFR_DIVIDE(CLK_OUT1_BUFR_DIV)) clkout1_buf
<: } else  { :>
 #(
      .BUFGCE_DIVIDE(1),      // 1-8
      // Programmable Inversion Attributes: Specifies built-in programmable inversion on specific pins
      .IS_CE_INVERTED(1'b0),  // Optional inversion for CE
      .IS_CLR_INVERTED(1'b0), // Optional inversion for CLR
      .IS_I_INVERTED(1'b0)    // Optional inversion for I
   )
  clkout1_buf
<: } :>
<: } else  { :>
  <=: clkout1_buf :> clkout1_buf
<: } :>
<: if { $is_clk0_fb}  {  :>
   (.O   (clk_out1_int),
<: } else  { :>
   (.O   (<=: out1_port :>),
<: } :>
<: if { [string equal -nocase $clkout1_buf "BUFR"] || [string equal -nocase $clkout1_buf "BUFGCE_DIV"]}  {  :>
<: if { $clkout1_ce_used && !$safe_clk_startup}  {  :>
    .CE  (<=: out1_port :>_ce),   // 1-bit input: Buffer enable
<: } else  { :>
    .CE  (1'b1),   // 1-bit input: Buffer enable
<: } :>
<: if { $clkout1_clr_used && !$safe_clk_startup}  {  :>
    .CLR (<=: out1_port :>_clr),
<: } else  { :>
    .CLR (1'b0),
<: } :>
<: } elseif  { $clkout1_ce_used}  { :>
    .CE  (<=: out1_port :>_ce),
<: } :>
    .I   (<: print $out1_port$u_score$ComponentName :>));
<: } :>

<: if { $is_clk0_fb}  {  :>
    assign <=: out1_port :> = clk_out1_int; 
<: if { $use_phase_alignment && (!$ext_feedback) && (!$auto_ext_feedback)}  {  :>
    assign clk0_fb_in = clk_out1_int;
<: } :>
<: } :>
<: if { $num_out_clks>= 2}  {  :>

<: if { [string equal -nocase $clkout2_buf "No_buffer"]}  {  :>
  assign <=: out2_port :> = <: print $out2_port$u_score$ComponentName :>;
<: } else  {;#BUFG/BUFR/BUFH :>
<: if { [string equal -nocase $clkout2_buf "BUFR"] || [string equal -nocase $clkout2_buf "BUFGCE_DIV"]}  {  :>
  <=: clkout2_buf :> 
<: if { [string equal -nocase $clkout2_buf "BUFR"] }  {  :>
  #(.BUFR_DIVIDE(CLK_OUT2_BUFR_DIV)) clkout2_buf
<: } else  { :>
 #(
      .BUFGCE_DIVIDE(1),      // 1-8
      // Programmable Inversion Attributes: Specifies built-in programmable inversion on specific pins
      .IS_CE_INVERTED(1'b0),  // Optional inversion for CE
      .IS_CLR_INVERTED(1'b0), // Optional inversion for CLR
      .IS_I_INVERTED(1'b0)    // Optional inversion for I
   )
  clkout2_buf
<: } :>
<: } else  { :>
  <=: clkout2_buf :> clkout2_buf
<: } :>
   (.O   (<=: out2_port :>),
<: if { [string equal -nocase $clkout2_buf "BUFR"] || [string equal -nocase $clkout2_buf "BUFGCE_DIV"]}  {  :>
<: if { $clkout2_ce_used && !$safe_clk_startup}  {  :>
    .CE  (<=: out2_port :>_ce),   // 1-bit input: Buffer enable
<: } else  { :>
    .CE  (1'b1),   // 1-bit input: Buffer enable
<: } :>
<: if { $clkout2_clr_used && !$safe_clk_startup}  {  :>
    .CLR (<=: out2_port :>_clr),
<: } else  { :>
    .CLR (1'b0),
<: } :>
<: } elseif  { $clkout2_ce_used}  { :>
    .CE  (<=: out2_port :>_ce),
<: } :>
    .I   (<: print $out2_port$u_score$ComponentName :>));
<: } :>
<: } :>
<: if { ($num_out_clks>= 3) && (!$mmcm_ss_en)}  {  :>

<: if { [string equal -nocase $clkout3_buf "No_buffer"]}  {  :>
  assign <=: out3_port :> = <: print $out3_port$u_score$ComponentName :>;
<: } else  {;#BUFG/BUFR/BUFH :>
<: if { [string equal -nocase $clkout3_buf "BUFR"] || [string equal -nocase $clkout3_buf "BUFGCE_DIV"]}  {  :>
  <=: clkout3_buf :> 
<: if { [string equal -nocase $clkout3_buf "BUFR"] }  {  :>
  #(.BUFR_DIVIDE(CLK_OUT3_BUFR_DIV)) clkout3_buf
<: } else  { :>
 #(
      .BUFGCE_DIVIDE(1),      // 1-8
      // Programmable Inversion Attributes: Specifies built-in programmable inversion on specific pins
      .IS_CE_INVERTED(1'b0),  // Optional inversion for CE
      .IS_CLR_INVERTED(1'b0), // Optional inversion for CLR
      .IS_I_INVERTED(1'b0)    // Optional inversion for I
   )
  clkout3_buf
<: } :>
<: } else  { :>
  <=: clkout3_buf :> clkout3_buf
<: } :>
   (.O   (<=: out3_port :>),
<: if { [string equal -nocase $clkout3_buf "BUFR"] || [string equal -nocase $clkout3_buf "BUFGCE_DIV"]}  {  :>
<: if { $clkout3_ce_used && !$safe_clk_startup}  {  :>
    .CE  (<=: out3_port :>_ce),   // 1-bit input: Buffer enable
<: } else  { :>
    .CE  (1'b1),   // 1-bit input: Buffer enable
<: } :>
<: if { $clkout3_clr_used && !$safe_clk_startup}  {  :>
    .CLR (<=: out3_port :>_clr),
<: } else  { :>
    .CLR (1'b0),
<: } :>
<: } elseif  { $clkout3_ce_used}  { :>
    .CE  (<=: out3_port :>_ce),
<: } :>
    .I   (<: print $out3_port$u_score$ComponentName :>));
<: } :>
<: } :>
<: if { ($num_out_clks>= 4) && (!$mmcm_ss_en)}  {  :>

<: if { [string equal -nocase $clkout4_buf "No_buffer"]}  {  :>
  assign <=: out4_port :> = <: print $out4_port$u_score$ComponentName :>;
<: } else  {;#BUFG/BUFR/BUFH :>
<: if { [string equal -nocase $clkout4_buf "BUFR"] || [string equal -nocase $clkout4_buf "BUFGCE_DIV"]}  {  :>
  <=: clkout4_buf :>
<: if { [string equal -nocase $clkout4_buf "BUFR"] }  {  :>
  #(.BUFR_DIVIDE(CLK_OUT4_BUFR_DIV)) clkout4_buf
<: } else  { :>
 #(
      .BUFGCE_DIVIDE(1),      // 1-8
      // Programmable Inversion Attributes: Specifies built-in programmable inversion on specific pins
      .IS_CE_INVERTED(1'b0),  // Optional inversion for CE
      .IS_CLR_INVERTED(1'b0), // Optional inversion for CLR
      .IS_I_INVERTED(1'b0)    // Optional inversion for I
   )
  clkout4_buf
<: } :>
<: } else  { :>
  <=: clkout4_buf :> clkout4_buf
<: } :>
   (.O   (<=: out4_port :>),
<: if { [string equal -nocase $clkout4_buf "BUFR"] || [string equal -nocase $clkout4_buf "BUFGCE_DIV"]}  {  :>
<: if { $clkout4_ce_used && !$safe_clk_startup}  {  :>
    .CE  (<=: out4_port :>_ce),   // 1-bit input: Buffer enable
<: } else  { :>
    .CE  (1'b1),   // 1-bit input: Buffer enable
<: } :>
<: if { $clkout4_clr_used && !$safe_clk_startup}  {  :>
    .CLR (<=: out4_port :>_clr),
<: } else  { :>
    .CLR (1'b0),
<: } :>
<: } elseif  { $clkout4_ce_used}  { :>
    .CE  (<=: out4_port :>_ce),
<: } :>
    .I   (<: print $out4_port$u_score$ComponentName :>));
<: } :>
<: } :>
<: if { $num_out_clks>= 5}  {  :>

<: if { [string equal -nocase $clkout5_buf "No_buffer"]}  {  :>
  assign <=: out5_port :> = <: print $out5_port$u_score$ComponentName :>;
<: } elseif  { [string equal -nocase $clkout5_buf "Clock_pin"]}  { :>
<: } else  {;#BUFG/BUFR/BUFH :>
<: if { [string equal -nocase $clkout5_buf "BUFR"] || [string equal -nocase $clkout5_buf "BUFGCE_DIV"]}  {  :>
  <=: clkout5_buf :>
<: if { [string equal -nocase $clkout5_buf "BUFR"] }  {  :>
  #(.BUFR_DIVIDE(CLK_OUT5_BUFR_DIV)) clkout5_buf
<: } else  { :>
 #(
      .BUFGCE_DIVIDE(1),      // 1-8
      // Programmable Inversion Attributes: Specifies built-in programmable inversion on specific pins
      .IS_CE_INVERTED(1'b0),  // Optional inversion for CE
      .IS_CLR_INVERTED(1'b0), // Optional inversion for CLR
      .IS_I_INVERTED(1'b0)    // Optional inversion for I
   )
  clkout5_buf
<: } :>
<: } else  { :>
  <=: clkout5_buf :> clkout5_buf
<: } :>
   (.O   (<=: out5_port :>),
<: if { [string equal -nocase $clkout5_buf "BUFR"] || [string equal -nocase $clkout5_buf "BUFGCE_DIV"]}  {  :>
<: if { $clkout5_ce_used && !$safe_clk_startup}  {  :>
    .CE  (<=: out5_port :>_ce),   // 1-bit input: Buffer enable
<: } else  { :>
    .CE  (1'b1),   // 1-bit input: Buffer enable
<: } :>
<: if { $clkout5_clr_used && !$safe_clk_startup}  {  :>
