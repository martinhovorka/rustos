<: } :>
<: if { $clkout7_clr_used && !$safe_clk_startup}  {  :>
    .CLR (<=: out7_port :>_clr),
<: } else  { :>
    .CLR (1'b0),
<: } :>
<: } elseif  { $clkout7_ce_used}  { :>
    .CE  (<=: out7_port :>_ce),
<: } :>
    .I   (<: print $out7_port$u_score$ComponentName :>));
<: } :>
<: } :>
<: } else  { :>

  <=: clkout1_buf :> clkout1_buf
<: if { $is_clk0_fb}  {  :>
   (.O   (clk_out1_int),
<: } else  { :>
   (.O   (<=: out1_port :>),
<: } :>
    .CE  (seq_reg1[7]),
    .I   (<: print $out1_port$u_score$ComponentName :>));

<: if { ($is_v8 || $is_k8) } { :>
  BUFGCE clkout1_buf_en
   (.O   (<: print $out1_port$u_score$ComponentName :>_en_clk),
    .CE  (1'b1),
    .I   (<: print $out1_port$u_score$ComponentName :>));
<: } else  { :>
  BUFH clkout1_buf_en
   (.O   (<: print $out1_port$u_score$ComponentName :>_en_clk),
    .I   (<: print $out1_port$u_score$ComponentName :>));
<: } :>
  always @(posedge <: print $out1_port$u_score$ComponentName :>_en_clk<: if { $use_reset } { :> or posedge reset_high) begin
    if(reset_high == 1'b1) begin
	    seq_reg1 <= 8'h00;
    end
    else begin<: } else { :>)<: } :>
<: if { $clkout1_seq_number == 1}  {  :>
        seq_reg1 <= {seq_reg1[6:0],<=: locked_port :>_int};
<: } elseif { $clkout1_seq_number == [expr $clkout2_seq_number + 1]} { :>
        seq_reg1 <= {seq_reg1[6:0],seq_reg2[7]};
<: } elseif { $clkout1_seq_number == [expr $clkout3_seq_number + 1]  && !$mmcm_ss_en} { :>
        seq_reg1 <= {seq_reg1[6:0],seq_reg3[7]};
<: } elseif { $clkout1_seq_number == [expr $clkout4_seq_number + 1]  && !$mmcm_ss_en} { :>
        seq_reg1 <= {seq_reg1[6:0],seq_reg4[7]};
<: } elseif { $clkout1_seq_number == [expr $clkout5_seq_number + 1]} { :>
        seq_reg1 <= {seq_reg1[6:0],seq_reg5[7]};
<: } elseif { $clkout1_seq_number == [expr $clkout6_seq_number + 1]} { :>
        seq_reg1 <= {seq_reg1[6:0],seq_reg6[7]};
<: } elseif { $clkout1_seq_number == [expr $clkout7_seq_number + 1]} { :>
        seq_reg1 <= {seq_reg1[6:0],seq_reg7[7]};
<: } :>
<: if { $use_reset } { :>  
    end
  end
<: } :>

<: if { $is_clk0_fb}  {  :>

    assign <=: out1_port :> = clk_out1_int; 
<: if { $use_phase_alignment && (!$ext_feedback) && (!$auto_ext_feedback)}  {  :>

    assign clk0_fb_in = clk_out1_int;
