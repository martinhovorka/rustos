<: if { $num_out_clks>= 7}  {  :>

<: if { [string equal -nocase $clkout7_buf "No_buffer"]}  {  :>
  assign <=: out7_port :> = <: print $out7_port$u_score$ComponentName :>;
<: } else  {;#BUFG/BUFR/BUFH :>
<: if { [string equal -nocase $clkout7_buf "BUFR"] || [string equal -nocase $clkout7_buf "BUFGCE_DIV"]}  {  :>
  <=: clkout7_buf :>
<: if { [string equal -nocase $clkout7_buf "BUFR"] }  {  :>
  #(.BUFR_DIVIDE(CLK_OUT7_BUFR_DIV)) clkout7_buf
<: } else  { :>
 #(
      .BUFGCE_DIVIDE(1),      // 1-8
      // Programmable Inversion Attributes: Specifies built-in programmable inversion on specific pins
      .IS_CE_INVERTED(1'b0),  // Optional inversion for CE
      .IS_CLR_INVERTED(1'b0), // Optional inversion for CLR
      .IS_I_INVERTED(1'b0)    // Optional inversion for I
   )
  clkout7_buf
<: } :>
<: } else  { :>
  <=: clkout7_buf :> clkout7_buf
<: } :>
   (.O   (<=: out7_port :>),
<: if { [string equal -nocase $clkout7_buf "BUFR"] || [string equal -nocase $clkout7_buf "BUFGCE_DIV"]}  {  :>
<: if { $clkout7_ce_used && !$safe_clk_startup}  {  :>
    .CE  (<=: out7_port :>_ce),   // 1-bit input: Buffer enable
<: } else  { :>
