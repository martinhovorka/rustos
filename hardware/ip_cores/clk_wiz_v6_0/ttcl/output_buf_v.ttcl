<: if { $num_out_clks>= 6}  {  :>

<: if { [string equal -nocase $clkout6_buf "No_buffer"]}  {  :>
  assign <=: out6_port :> = <: print $out6_port$u_score$ComponentName :>;
<: } else  {;#BUFG/BUFR/BUFH :>
<: if { [string equal -nocase $clkout6_buf "BUFR"] || [string equal -nocase $clkout6_buf "BUFGCE_DIV"]}  {  :>
  <=: clkout6_buf :>
<: if { [string equal -nocase $clkout6_buf "BUFR"] }  {  :>
  #(.BUFR_DIVIDE(CLK_OUT6_BUFR_DIV)) clkout6_buf
<: } else  { :>
 #(
      .BUFGCE_DIVIDE(1),      // 1-8
      // Programmable Inversion Attributes: Specifies built-in programmable inversion on specific pins
      .IS_CE_INVERTED(1'b0),  // Optional inversion for CE
      .IS_CLR_INVERTED(1'b0), // Optional inversion for CLR
      .IS_I_INVERTED(1'b0)    // Optional inversion for I
   )
  clkout6_buf
<: } :>
<: } else  { :>
  <=: clkout6_buf :> clkout6_buf
<: } :>
   (.O   (<=: out6_port :>),
<: if { [string equal -nocase $clkout6_buf "BUFR"] || [string equal -nocase $clkout6_buf "BUFGCE_DIV"]}  {  :>
<: if { $clkout6_ce_used && !$safe_clk_startup}  {  :>
    .CE  (<=: out6_port :>_ce),   // 1-bit input: Buffer enable
<: } else  { :>
    .CE  (1'b1),   // 1-bit input: Buffer enable
<: } :>
<: if { $clkout6_clr_used && !$safe_clk_startup}  {  :>
    .CLR (<=: out6_port :>_clr),
<: } else  { :>
    .CLR (1'b0),
<: } :>
<: } elseif  { $clkout6_ce_used}  { :>
    .CE  (<=: out6_port :>_ce),
<: } :>
    .I   (<: print $out6_port$u_score$ComponentName :>));
<: } :>
