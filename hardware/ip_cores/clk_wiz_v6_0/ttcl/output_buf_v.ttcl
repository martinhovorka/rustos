<: if { $num_out_clks>= 2}  {  :>

  <=: clkout2_buf :> clkout2_buf
   (.O   (<=: out2_port :>),
    .CE  (seq_reg2[7]),
    .I   (<: print $out2_port$u_score$ComponentName :>));
 
<: if { ($is_v8 || $is_k8) } { :>
  BUFGCE clkout2_buf_en
   (.O   (<: print $out2_port$u_score$ComponentName :>_en_clk),
    .CE  (1'b1),
    .I   (<: print $out2_port$u_score$ComponentName :>));
<: } else  { :>
  BUFH clkout2_buf_en
   (.O   (<: print $out2_port$u_score$ComponentName :>_en_clk),
    .I   (<: print $out2_port$u_score$ComponentName :>));
<: } :>
 
  always @(posedge <: print $out2_port$u_score$ComponentName :>_en_clk<: if { $use_reset } { :> or posedge reset_high) begin
    if(reset_high == 1'b1) begin
	  seq_reg2 <= 8'h00;
    end
    else begin<: } else { :>)<: } :>
<: if { $clkout2_seq_number == 1}  {  :>
        seq_reg2 <= {seq_reg2[6:0],<=: locked_port :>_int};
<: } elseif { $clkout2_seq_number == [expr $clkout1_seq_number + 1]} { :>
        seq_reg2 <= {seq_reg2[6:0],seq_reg1[7]};
<: } elseif { $clkout2_seq_number == [expr $clkout3_seq_number + 1] && !$mmcm_ss_en} { :>
        seq_reg2 <= {seq_reg2[6:0],seq_reg3[7]};
<: } elseif { $clkout2_seq_number == [expr $clkout4_seq_number + 1]  && !$mmcm_ss_en} { :>
        seq_reg2 <= {seq_reg2[6:0],seq_reg4[7]};
