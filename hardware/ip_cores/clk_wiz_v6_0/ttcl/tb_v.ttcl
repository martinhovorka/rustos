<: } :>
    test_phase = "wait lock";
<: if { $use_clk_valid}  {  :>
    `wait_lock;
<: } elseif  { $use_locked}  { :>
    `wait_lock;
<: } else  { :>
    #(PER1*50000);
<: } :>
