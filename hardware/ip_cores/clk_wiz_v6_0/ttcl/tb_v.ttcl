    for (ii = 1; ii <= <=: num_out_clks :>; ii = ii + 1) begin
      if (dut.counter[ii] < exp_count_min[ii]) begin
        $display("ERROR: %t: Count%1d is too small for <=: SECONDARY_PORT :>: %1d, should be: %1d",
          $time, ii, dut.counter[ii], exp_count_min[ii]);
        $finish;
      end
      if (dut.counter[ii] > exp_count_max[ii]) begin
        $display("ERROR: %t: Count%1d is too large for <=: SECONDARY_PORT :>: %1d, should be: %1d",
          $time, ii, dut.counter[ii], exp_count_max[ii]);
        $finish;
      end
    end
    $display("%t, <=: SECONDARY_PORT :> count values check out", $time);
