<: if {$use_inclk_switchover} { :>
  localparam ref_period3_clkin2 = (<=: mmcm_clkin2_period :>*<=: mmcm_divclk_divide :>*<=: mmcm_clkout2_divide_tb :>*1000/<=: mmcm_clkfbout_mult_f :>);
<: } :>
<: } else { :>
  localparam ref_period3_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*<=: mmcm_clkout2_divide_tb :>*1000/<=: mmcm_clkfbout_mult :>);
<: if {$use_inclk_switchover} { :>
  localparam ref_period3_clkin2 = (<=: mmcm_clkin2_period :>*<=: mmcm_divclk_divide :>*<=: mmcm_clkout2_divide_tb :>*1000/<=: mmcm_clkfbout_mult :>);
<: } :>
<: } :>
  time prev_rise3;
<:   } :>
<:   if {(!$mmcm_ss_en) && ($num_out_clks >= 4)} { :>
  real period4;
<: if {!$is_plle2} { :>
  localparam ref_period4_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*<=: mmcm_clkout3_divide_tb :>*1000/<=: mmcm_clkfbout_mult_f :>);
<: if {$use_inclk_switchover} { :>
  localparam ref_period4_clkin2 = (<=: mmcm_clkin2_period :>*<=: mmcm_divclk_divide :>*<=: mmcm_clkout3_divide_tb :>*1000/<=: mmcm_clkfbout_mult_f :>);
<: } :>
<: } else { :>
  localparam ref_period4_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*<=: mmcm_clkout3_divide_tb :>*1000/<=: mmcm_clkfbout_mult :>);
<: if {$use_inclk_switchover} { :>
  localparam ref_period4_clkin2 = (<=: mmcm_clkin2_period :>*<=: mmcm_divclk_divide :>*<=: mmcm_clkout3_divide_tb :>*1000/<=: mmcm_clkfbout_mult :>);
<: } :>
<: } :>
  time prev_rise4;
<:   } :>
<:   if {$num_out_clks >= 5} { :>
  real period5;
<: if {!$is_plle2} { :>
<:   if {$mmcm_clkout4_cascade} { :>
<:   if {$num_out_clks >= 7 } { :>
  localparam ref_period5_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*<=: mmcm_clkout4_divide_tb :>*<=: mmcm_clkout6_divide :>*1000/<=: mmcm_clkfbout_mult_f :>);
<: if {$use_inclk_switchover} { :>
  localparam ref_period5_clkin2 = (<=: mmcm_clkin2_period :>*<=: mmcm_divclk_divide :>*<=: mmcm_clkout4_divide_tb :>*<=: mmcm_clkout6_divide :>*1000/<=: mmcm_clkfbout_mult_f :>);
<: } :>
<: } :>
<: } else { :>
  localparam ref_period5_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*<=: mmcm_clkout4_divide_tb :>*1000/<=: mmcm_clkfbout_mult_f :>);
<: if {$use_inclk_switchover} { :>
  localparam ref_period5_clkin2 = (<=: mmcm_clkin2_period :>*<=: mmcm_divclk_divide :>*<=: mmcm_clkout4_divide_tb :>*1000/<=: mmcm_clkfbout_mult_f :>);
<: } :>
<: } :>
<: } else { :>
  localparam ref_period5_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*<=: mmcm_clkout4_divide_tb :>*1000/<=: mmcm_clkfbout_mult :>);
<: if {$use_inclk_switchover} { :>
  localparam ref_period5_clkin2 = (<=: mmcm_clkin2_period :>*<=: mmcm_divclk_divide :>*<=: mmcm_clkout4_divide_tb :>*1000/<=: mmcm_clkfbout_mult :>);
<: } :>
<: } :>
  time prev_rise5;
<:   } :>
<:   if {$num_out_clks >= 6} { :>
  real period6;
<: if {!$is_plle2} { :>
  localparam ref_period6_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*<=: mmcm_clkout5_divide_tb :>*1000/<=: mmcm_clkfbout_mult_f :>);
<: if {$use_inclk_switchover} { :>
  localparam ref_period6_clkin2 = (<=: mmcm_clkin2_period :>*<=: mmcm_divclk_divide :>*<=: mmcm_clkout5_divide_tb :>*1000/<=: mmcm_clkfbout_mult_f :>);
<: } :>
<: } else { :>
  localparam ref_period6_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*<=: mmcm_clkout5_divide_tb :>*1000/<=: mmcm_clkfbout_mult :>);
<: if {$use_inclk_switchover} { :>
  localparam ref_period6_clkin2 = (<=: mmcm_clkin2_period :>*<=: mmcm_divclk_divide :>*<=: mmcm_clkout5_divide_tb :>*1000/<=: mmcm_clkfbout_mult :>);
<: } :>
<: } :>
  time prev_rise6;
<:   } :>
<:   if {$num_out_clks >= 7} { :>
  real period7;
<: if {!$is_plle2} { :>
  localparam ref_period7_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*<=: mmcm_clkout6_divide_tb :>*1000/<=: mmcm_clkfbout_mult_f :>);
<: if {$use_inclk_switchover} { :>
  localparam ref_period7_clkin2 = (<=: mmcm_clkin2_period :>*<=: mmcm_divclk_divide :>*<=: mmcm_clkout6_divide_tb :>*1000/<=: mmcm_clkfbout_mult_f :>);
<: } :>
<: } else { :>
  localparam ref_period7_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*<=: mmcm_clkout6_divide_tb :>*1000/<=: mmcm_clkfbout_mult :>);
<: if {$use_inclk_switchover} { :>
  localparam ref_period7_clkin2 = (<=: mmcm_clkin2_period :>*<=: mmcm_divclk_divide :>*<=: mmcm_clkout6_divide_tb :>*1000/<=: mmcm_clkfbout_mult :>);
<: } :>
<: } :>
  time prev_rise7;
<:   } :>
<: if { $sv_test}  {  :>

  task check_range (input reg [8*12-1:0] clk,
                    input reg [8*12-1:0] name,
                    input real           offset,
                    input real           actual,
                    input real           req);
  begin
    if (actual < 0) begin
      $display("ERROR: problem calculating %s:%s (set to XXX)", clk, name);
      $finish;
    end
    if (actual < (req - req*offset)) begin
      $display("ERROR: %s:%s is too small %6.3f/%6.3f", clk, name, actual, req);
      $finish;
    end
    if (actual > (req + req*offset)) begin
      $display("ERROR: %s:%s is too large %6.3f/%6.3f", clk, name, actual, req);
      $finish;
    end
  end
  endtask

  // Did we fall into the right "notch" of possibilities?
  task check_notch (input reg [8*12-1:0] clk,
                    input reg [8*12-1:0] name,
                    input real           offset,
                    input real           actual,
                    input real           req);
  begin
    if (actual < 0) begin
      $display("ERROR: problem calculating %s:%s (set to XXX)", clk, name);
      $finish;
    end
    if (actual < (req - offset)) begin
      $display("ERROR: %s:%s is too small %6.3f/%6.3f", clk, name, actual, req);
      $finish;
    end
    if (actual > (req + offset)) begin
      $display("ERROR: %s:%s is too large %6.3f/%6.3f", clk, name, actual, req);
      $finish;
    end
  end
  endtask

  // Check the duty cycle ranges
  task duty_check (input integer high,
                   input integer low,
                   input integer num,
                   input real    expected,
                   input real    offset);

  real duty_percent;
  begin
    // cast into real, and get into a percent
    duty_percent = 100.0*high / (1.0*high+1.0*low);
    if (duty_percent > (expected +offset)) begin
      $display("ERROR: %t: Too much high time for clock %1d: %6.3f/%6.3f",
        $time, num, duty_percent, expected);
      $finish;
    end
    if (duty_percent < (expected -offset)) begin
      $display("ERROR: %t: Too much low time for clock %1d: %6.3f/%6.3f",
        $time, num, duty_percent, expected);
      $finish;
    end
    $display("Duty cycle checks out for clock %1d", num);
  end
  endtask

<: } :>

  // Input clock generation
  //------------------------------------
  always begin
    <=: PRIMARY_PORT :> = #PER1_1 ~<=: PRIMARY_PORT :>;
    <=: PRIMARY_PORT :> = #PER1_2 ~<=: PRIMARY_PORT :>;
  end
<: if { $use_inclk_switchover}  {  :>
  always begin
    <=: SECONDARY_PORT :> = #PER3_3 ~<=: SECONDARY_PORT :>;
    <=: SECONDARY_PORT :> = #PER2_2 ~<=: SECONDARY_PORT :>;
  end
<: } :>

<: if { $sv_test}  {  :>
  // Create a 0.5 ns clock to measure duty cycle
  reg oversample = 0;
  reg oversample_done = 0;
  initial begin
    // wait for a lock
    `wait_lock;
    // generate for 10000 periods;
    repeat (10000) begin
       oversample = #(ONE_NS/4) ~oversample;
    end
    oversample_done = 1'b 1;
  end

  // sample the high and low phases of the clocks
<: if { $num_out_clks== 1}  {  :>
  integer highs = 0;
  integer lows  = 0;
  always @(posedge oversample) begin
    if (dut.clk == 0) begin
      lows  = lows + 1;
    end else begin
      highs = highs + 1;
    end
  end

  // wait until measurement period to done to make the checks
  initial begin
    `wait_lock;
    #(105*PER1/2);
    duty_check(highs, lows, 1, clkout1_duty_cycle, duty_cycle_range);
  end
<: } else  { :>
  integer highs[1:7];
  integer lows[1:7];
  real duty_cycle[1:7];
  integer jj;
  initial begin
    for (jj = 1; jj <= 7; jj = jj + 1) begin
      highs[jj] = 0;
      lows[jj]  = 0;
    end
    duty_cycle[1] = clkout1_duty_cycle;
    duty_cycle[2] = clkout2_duty_cycle;
    duty_cycle[3] = clkout3_duty_cycle;
    duty_cycle[4] = clkout4_duty_cycle;
    duty_cycle[5] = clkout5_duty_cycle;
    duty_cycle[6] = clkout6_duty_cycle;
    duty_cycle[7] = clkout7_duty_cycle;
  end

  genvar jj_gen;
  generate for (jj_gen = 1; jj_gen <= <=: num_out_clks :>; jj_gen = jj_gen + 1) begin: duty
    always @(posedge oversample) begin
      if (dut.clk[jj_gen] == 0) begin
        lows[jj_gen]  = lows[jj_gen] + 1;
      end else begin
        highs[jj_gen] = highs[jj_gen] + 1;
      end
    end

    // wait until measurement period to done to make the checks
    initial begin
      `wait_lock;
      wait(oversample_done);
      duty_check(highs[jj_gen], lows[jj_gen], jj_gen, duty_cycle[jj_gen], duty_cycle_range);
    end
  end
  endgenerate
<: } :>

  // check that values are "good" for some value of good
  initial begin
    check_range("clkout1", "out_freq",   out_freq_offset,   clkout1_out_freq,   clkout1_requested_out_freq);
<: if { $use_phase_alignment}  {  :>
    check_notch("clkout1", "phase",      phase_offset,      clkout1_phase,      clkout1_requested_phase);
<: } :>
    check_notch("clkout1", "duty_cycle", duty_cycle_offset, clkout1_duty_cycle, clkout1_requested_duty_cycle);
<: if { $num_out_clks>= 2}  {  :>
    check_range("clkout2", "out_freq",   out_freq_offset,   clkout2_out_freq,   clkout2_requested_out_freq);
<: if { $use_phase_alignment}  {  :>
    check_notch("clkout2", "phase",      phase_offset,      clkout2_phase,      clkout2_requested_phase);
<: } :>
    check_notch("clkout2", "duty_cycle", duty_cycle_offset, clkout2_duty_cycle, clkout2_requested_duty_cycle);
<: } :>
<: if { (!$mmcm_ss_en) && ($num_out_clks>= 3)}  {  :>
