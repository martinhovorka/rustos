//Freq Check using the M & D values setting and actual Frequency generated
<:   if {$num_out_clks >= 1} { :>
  real period1;
<: if {!$is_plle2} { :>
  localparam ref_period1_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*<=: mmcm_clkout0_divide_f :>*1000/<=: mmcm_clkfbout_mult_f :>);
<: if {$use_inclk_switchover} { :>
  localparam ref_period1_clkin2 = (<=: mmcm_clkin2_period :>*<=: mmcm_divclk_divide :>*<=: mmcm_clkout0_divide_f :>*1000/<=: mmcm_clkfbout_mult_f :>);
<: } :>
<: } else { :>
  localparam ref_period1_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*<=: mmcm_clkout0_divide :>*1000/<=: mmcm_clkfbout_mult :>);
<: if {$use_inclk_switchover} { :>
  localparam ref_period1_clkin2 = (<=: mmcm_clkin2_period :>*<=: mmcm_divclk_divide :>*<=: mmcm_clkout0_divide :>*1000/<=: mmcm_clkfbout_mult :>);
