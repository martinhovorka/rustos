   s_axi_arvalid = 1'b1;
   #(60*ONE_NS);
   s_axi_arvalid = 1'b0;
   #(60*ONE_NS);        
<: } :>
end 

<: if { $axi_drp } { :>
initial 
begin
  $display ("Timing checks are not valid");
  s_axi_aresetn = 1'b0;
  #(100*PER_AXI);
  s_axi_aresetn = 1'b1;
  `wait_lock;
  $display ("Timing checks are valid");
  #(10*PER_AXI);
  `wait_lock;
  #(10*PER_AXI);
  $display ("Test Completed Successfully");
  $display ("Simulation Stopped");
  $finish;
end
<: } else { :>
<: if { $sv_test}  {  :>
  // Create a 0.5 ns clock to measure duty cycle
  reg oversample = 0;
  reg oversample_done = 0;
  initial begin
    // wait for a lock
    `wait_lock;
    // generate for 10000 periods;
    repeat (10000) begin
       oversample = #(ONE_NS/4) ~oversample;
    end
    oversample_done = 1'b 1;
  end

  // sample the high and low phases of the clocks
<: if { $num_out_clks== 1}  {  :>
  integer highs = 0;
  integer lows  = 0;
  always @(posedge oversample) begin
    if (dut.clk == 0) begin
      lows  = lows + 1;
    end else begin
      highs = highs + 1;
    end
  end

  // wait until measurement period to done to make the checks
  initial begin
    `wait_lock;
    #(105*PER1/2);
    duty_check(highs, lows, 1, clkout1_duty_cycle, duty_cycle_range);
  end
<: } else  { :>
  integer highs[1:7];
  integer lows[1:7];
  real duty_cycle[1:7];
  integer jj;
  initial begin
    for (jj = 1; jj <= 7; jj = jj + 1) begin
      highs[jj] = 0;
      lows[jj]  = 0;
    end
    duty_cycle[1] = clkout1_duty_cycle;
    duty_cycle[2] = clkout2_duty_cycle;
    duty_cycle[3] = clkout3_duty_cycle;
    duty_cycle[4] = clkout4_duty_cycle;
    duty_cycle[5] = clkout5_duty_cycle;
    duty_cycle[6] = clkout6_duty_cycle;
    duty_cycle[7] = clkout7_duty_cycle;
  end

  genvar jj_gen;
  generate for (jj_gen = 1; jj_gen <= <=: num_out_clks :>; jj_gen = jj_gen + 1) begin: duty
    always @(posedge oversample) begin
      if (dut.clk[jj_gen] == 0) begin
        lows[jj_gen]  = lows[jj_gen] + 1;
      end else begin
        highs[jj_gen] = highs[jj_gen] + 1;
      end
    end

    // wait until measurement period to done to make the checks
    initial begin
      `wait_lock;
      wait(oversample_done);
      duty_check(highs[jj_gen], lows[jj_gen], jj_gen, duty_cycle[jj_gen], duty_cycle_range);
    end
  end
  endgenerate
<: } :>

  // check that values are "good" for some value of good
  initial begin
    check_range("clkout1", "out_freq",   out_freq_offset,   clkout1_out_freq,   clkout1_requested_out_freq);
<: if { $use_phase_alignment}  {  :>
    check_notch("clkout1", "phase",      phase_offset,      clkout1_phase,      clkout1_requested_phase);
<: } :>
    check_notch("clkout1", "duty_cycle", duty_cycle_offset, clkout1_duty_cycle, clkout1_requested_duty_cycle);
<: if { $num_out_clks>= 2}  {  :>
    check_range("clkout2", "out_freq",   out_freq_offset,   clkout2_out_freq,   clkout2_requested_out_freq);
<: if { $use_phase_alignment}  {  :>
    check_notch("clkout2", "phase",      phase_offset,      clkout2_phase,      clkout2_requested_phase);
<: } :>
    check_notch("clkout2", "duty_cycle", duty_cycle_offset, clkout2_duty_cycle, clkout2_requested_duty_cycle);
<: } :>
<: if { (!$mmcm_ss_en) && ($num_out_clks>= 3)}  {  :>
    check_range("clkout3", "out_freq",   out_freq_offset,   clkout3_out_freq,   clkout3_requested_out_freq);
<: if { $use_phase_alignment}  {  :>
    check_notch("clkout3", "phase",      phase_offset,      clkout3_phase,      clkout3_requested_phase);
<: } :>
    check_notch("clkout3", "duty_cycle", duty_cycle_offset, clkout3_duty_cycle, clkout3_requested_duty_cycle);
<: } :>
<: if { (!$mmcm_ss_en) && ($num_out_clks>= 4)}  {  :>
    check_range("clkout4", "out_freq",   out_freq_offset,   clkout4_out_freq,   clkout4_requested_out_freq);
<: if { $use_phase_alignment}  {  :>
    check_notch("clkout4", "phase",      phase_offset,      clkout4_phase,      clkout4_requested_phase);
<: } :>
    check_notch("clkout4", "duty_cycle", duty_cycle_offset, clkout4_duty_cycle, clkout4_requested_duty_cycle);
<: } :>
<: if { $num_out_clks>= 5}  {  :>
    check_range("clkout5", "out_freq",   out_freq_offset,   clkout5_out_freq,   clkout5_requested_out_freq);
<: if { $use_phase_alignment}  {  :>
    check_notch("clkout5", "phase",      phase_offset,      clkout5_phase,      clkout5_requested_phase);
<: } :>
    check_notch("clkout5", "duty_cycle", duty_cycle_offset, clkout5_duty_cycle, clkout5_requested_duty_cycle);
<: } :>
<: if { $num_out_clks>= 6}  {  :>
