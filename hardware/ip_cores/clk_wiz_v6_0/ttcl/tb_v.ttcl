  localparam ref_period2_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*<=: mmcm_clkout1_divide_tb :>*1000/<=: mmcm_clkfbout_mult_f :>);
<: if {$use_inclk_switchover} { :>
  localparam ref_period2_clkin2 = (<=: mmcm_clkin2_period :>*<=: mmcm_divclk_divide :>*<=: mmcm_clkout1_divide_tb :>*1000/<=: mmcm_clkfbout_mult_f :>);
