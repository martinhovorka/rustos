<: if { $use_phase_alignment}  {  :>
  wire ref_clk = <=: PRIMARY_PORT :>;
<: } elseif  { $num_out_clks> 1}  { :>
  wire ref_clk = dut.clk[1];
<: } :>
<: if { $num_out_clks== 1}  {  :>
<: if { $use_phase_alignment}  {  :>
   // check that phase shifts are correct
   time phaseangle, phasetime, periodtime;
   time starttime = 0;
   time endtime   = 0;
   time gaptime   = 0;
   time phase_err = 0;
   integer multiple;
   initial
   begin
      phaseangle = clkout1_phase;
      periodtime = ONE_NS / count1_1ovrper;
      // compute phase angle in time units
      phasetime = (periodtime/360.0)*phaseangle;

      // wait for a lock
      `wait_lock;
      // measure the difference (if the two periods are the same)
      if ( periodtime == PER1) 
      begin
         // check phaseangle. if the output clock has requested phase of other than 0.0, then
         // ref_clk defines the starttime and output clock defines the endtime
         // else assume the output clock is ahead in phase wrt to clkin
         if ( phaseangle != 0.0 )
         begin
            @(posedge <=: PRIMARY_PORT :>);
            starttime = $time;
            @(posedge dut.clk);
            endtime   = $time;
         end
         else
         begin
            @(posedge dut.clk);
            starttime = $time;
            @(posedge <=: PRIMARY_PORT :>);
            endtime   = $time;
         end
         // compute gaptime
         gaptime    = ( endtime - starttime );
         multiple   = gaptime / periodtime;
         // get rid of excess periods
         gaptime    = gaptime - multiple*periodtime;
    
         // compute phase error in terms of timeunits
         if ( gaptime >= phasetime )
            phase_err = gaptime - phasetime;
         else
            phase_err = phasetime - gaptime;
    
         $display ("Debug clk_out1 : starttime %t, endtime %t, phasetime %t, gaptime %t, phase_err %t",
                          starttime, endtime, phasetime, gaptime, phase_err);
         // check if phase error is < error margin (100ps)
         if ( phase_err > ( PHASE_ERR_MARGIN + rounding_error ) )
         begin
            $display("ERROR: at time %t: Phase Error on Clock 1 %t / %t ",$time, phase_err, PHASE_ERR_MARGIN );
            // let simulation run a few more cycles.. helps debug
            @(posedge dut.clk);
            @(posedge dut.clk);
            @(posedge dut.clk);
            $finish;
         end
         else
         begin
            $display("Phase matches for clock 1");
         end
      end
      else
      begin
         $display("Phase skipped for clock 1");
      end
   end
<: } :>
<: } else  { :>
   // check that phase shifts are correct
   time phaseangle[1:7];
   time phasetime[1:7];
   time periodtime[1:7];
   initial 
   begin
      phaseangle[1] = clkout1_phase;
      phaseangle[2] = clkout2_phase;
      phaseangle[3] = clkout3_phase;
      phaseangle[4] = clkout4_phase;
      phaseangle[5] = clkout5_phase;
      phaseangle[6] = clkout6_phase;
      phaseangle[7] = clkout7_phase;
      periodtime[1] = ONE_NS / count1_1ovrper;
      periodtime[2] = ONE_NS / count3_3ovrper;
      periodtime[3] = ONE_NS / count3_3ovrper;
      periodtime[4] = ONE_NS / count4_1ovrper;
      periodtime[5] = ONE_NS / count5_1ovrper;
      periodtime[6] = ONE_NS / count6_1ovrper;
      periodtime[7] = ONE_NS / count7_1ovrper;
      // compute phase angle in time units
      phasetime[1] = (periodtime[1]/360.0)*clkout1_phase;
      phasetime[2] = (periodtime[2]/360.0)*clkout2_phase;
      phasetime[3] = (periodtime[3]/360.0)*clkout3_phase;
      phasetime[4] = (periodtime[4]/360.0)*clkout4_phase;
      phasetime[5] = (periodtime[5]/360.0)*clkout5_phase;
      phasetime[6] = (periodtime[6]/360.0)*clkout6_phase;
      phasetime[7] = (periodtime[7]/360.0)*clkout7_phase;
   end
   genvar ii_gen;
   generate for (ii_gen = 1; ii_gen <= <=: num_out_clks :>; ii_gen = ii_gen + 1) begin: phase
      time starttime = 0;
      time endtime   = 0;
      time gaptime   = 0;
      time phase_err = 0;
      integer multiple;

      initial begin
         // wait for a lock
         `wait_lock;
         // measure the difference (if the clock periods are the same)
<: if { $use_phase_alignment}  {  :>
         if (periodtime[ii_gen] == PER1) begin
<: } else  { :>
         if ((ii_gen != 1)  && (periodtime[ii_gen] == periodtime[1])) begin
<: } :>
            // check phaseangle. if the output clock has requested phase of other than 0.0, then
            // ref_clk defines the starttime and output clock defines the endtime
            // else assume the output clock is ahead in phase wrt to clkin
            if ( phaseangle[ii_gen] != 0.0 )
            begin
               @(posedge ref_clk);
               starttime = $time;
               @(posedge dut.clk[ii_gen]);
               endtime   = $time;
            end
            else
            begin
               @(posedge dut.clk[ii_gen]);
               starttime = $time;
               @(posedge ref_clk);
               endtime   = $time;
            end

            // compute gaptime
            gaptime    = ( endtime - starttime );
            multiple   = gaptime / periodtime[ii_gen];
            // get rid of excess periods
            gaptime    = gaptime - multiple*periodtime[ii_gen];

            // compute phase error in terms of timeunits
            if ( gaptime >= phasetime[ii_gen] )
               phase_err = gaptime - phasetime[ii_gen];
            else
               phase_err = phasetime[ii_gen] - gaptime;

            $display ("Debug CLKOUT%1d : starttime %t, endtime %t, phasetime %t, gaptime %t, phase_err %t",
                            ii_gen, starttime, endtime, phasetime[ii_gen],gaptime, phase_err);
            // check if phase error is < error margin (100ps)
            if ( phase_err > ( PHASE_ERR_MARGIN + rounding_error ) )
            begin
               $display("ERROR: at time %t: Phase Error on Clock %1d %t / %t ",$time, ii_gen, phase_err, PHASE_ERR_MARGIN );
               // let simulation run a few more cycles.. helps debug
               @(posedge dut.clk[ii_gen]);
               @(posedge dut.clk[ii_gen]);
               @(posedge dut.clk[ii_gen]);
               $finish;
            end
            else
            begin
               $display("Phase matches for clock %1d", ii_gen);
            end
         end
         else
         begin
            $display("Phase skipped for clock %1d", ii_gen);
         end
      end
   end
   endgenerate
<: } :>

<: } :>
  // Test sequence
  reg [15*8-1:0] test_phase = "";
  initial begin
    // Set up any display statements using time to be readable
    $timeformat(-12, 2, "ps", 10);
    $display ("Timing checks are not valid");
    COUNTER_RESET = 0;
<: if { $use_freeze}  {  :>
    FREEZE = 0;
<: } :>
<: if { $use_reset}  {  :>
    test_phase = "reset";
<: if { $reset_active_high}  {  :>
    s_axi_aresetn = 1'b0;
    #(PER1*200);
    s_axi_aresetn = 1'b1;
<: } else { :>
    s_axi_aresetn = 1'b0;
    #(PER1*200);
    s_axi_aresetn = 1'b1;
<: } :>
<: } :>
    test_phase = "wait lock";
<: if { $use_clk_valid}  {  :>
    `wait_lock;
<: } elseif  { $use_locked}  { :>
    `wait_lock;
<: } else  { :>
    #(PER1*50000);
<: } :>
    #(PER1*20);
    COUNTER_RESET = 1;
    #(PER1*19.2)
    COUNTER_RESET = 0;
    #(PER1*0.3)
<: if { $clock_sequencing && $max_seq_number>= 2}  {  :>
    #(PER1*225*<=: mmcm_divclk_divide :>)
<: } else { :>
    #(PER1*1)
<: } :>
    $display ("Timing checks are valid");
    test_phase = "counting";
<:   if {$mmcm_clkout4_cascade} { :>
<:   if {$num_out_clks >= 7 } { :>
    #(PER1*<=: mmcm_divclk_divide :>*<=: mmcm_clkout4_divide :>*<=: mmcm_clkout6_divide :>);
<: } :>
<: } :>
    #(PER1*COUNT_PHASE);
<: if {$use_inclk_switchover} { :>
    $display("Output Frequencies w.r.t Primary clock"); 
<: } :>
<:   if {$num_out_clks >= 1} { :>
    if ((period1 -ref_period1_clkin1) <= 100 && (period1 -ref_period1_clkin1) >= -100) begin
    $display("Freq of CLK_OUT[1] ( in MHz ) : %0f\n", 1000000/period1);
    end else 
    begin
    $display("ERROR: Freq of CLK_OUT[1] is not correct"); 
    $finish;
    end 
<: } :>
<:   if {$num_out_clks >= 2} { :>
    if ((period2 -ref_period2_clkin1) <= 100 && (period2 -ref_period2_clkin1) >= -100) begin
    $display("Freq of CLK_OUT[2] ( in MHz ) : %0f\n", 1000000/period2);
    end else 
    begin
    $display("ERROR: Freq of CLK_OUT[2] is not correct"); 
    $finish;
    end 
<: } :>
<:   if {(!$mmcm_ss_en) && ($num_out_clks >= 3)} { :>
    if ((period3 -ref_period3_clkin1) <= 100 && (period3 -ref_period3_clkin1) >= -100) begin
    $display("Freq of CLK_OUT[3] ( in MHz ) : %0f\n", 1000000/period3);
    end else 
    begin
    $display("ERROR: Freq of CLK_OUT[3] is not correct"); 
    $finish;
    end 
<: } :>
<:   if {(!$mmcm_ss_en) && ($num_out_clks >= 4)} { :>
    if ((period4 -ref_period4_clkin1) <= 100 && (period4 -ref_period4_clkin1) >= -100) begin
    $display("Freq of CLK_OUT[4] ( in MHz ) : %0f\n", 1000000/period4);
    end else 
    begin
    $display("ERROR: Freq of CLK_OUT[4] is not correct"); 
    $finish;
    end 
<: } :>
<:   if {$num_out_clks >= 5} { :>
    if ((period5 -ref_period5_clkin1) <= 100 && (period5 -ref_period5_clkin1) >= -100) begin
<:   if {$mmcm_clkout4_cascade} { :>
<:   if {$num_out_clks >= 7 } { :>
    $display("Freq of CLK_OUT[5] ( in KHz ) : %0f\n", 1000000000/period5);
<: } else { :>
    $display("Freq of CLK_OUT[5] ( in MHz ) : %0f\n", 1000000/period5);
<: } :>
<: } else { :>
    $display("Freq of CLK_OUT[5] ( in MHz ) : %0f\n", 1000000/period5);
<: } :>
    end else 
    begin
    $display("ERROR: Freq of CLK_OUT[5] is not correct"); 
    $finish;
    end 
<: } :>
<:   if {$num_out_clks >= 6} { :>
    if ((period6 -ref_period6_clkin1) <= 100 && (period6 -ref_period6_clkin1) >= -100) begin
    $display("Freq of CLK_OUT[6] ( in MHz ) : %0f\n", 1000000/period6);
    end else 
    begin
    $display("ERROR: Freq of CLK_OUT[6] is not correct"); 
    $finish;
    end 
<: } :>
<:   if {$num_out_clks >= 7} { :>
    if ((period7 -ref_period7_clkin1) <= 100 && (period7 -ref_period7_clkin1) >= -100) begin
    $display("Freq of CLK_OUT[7] ( in MHz ) : %0f\n", 1000000/period7);
    end else 
    begin
    $display("ERROR: Freq of CLK_OUT[7] is not correct"); 
    $finish;
    end 
<: } :>
<: if { $sv_test}  {  :>
<: if { $num_out_clks== 1}  {  :>
    if (dut.counter < (count1_exp1 - min_offset1)) begin
      $display("ERROR: %t: Count is too small for <=: PRIMARY_PORT :>: %1d, should be: %1d",
        $time, dut.counter, count1_exp1);
      $finish;
    end
    if (dut.counter > (count1_exp1 + max_offset1)) begin
      $display("ERROR: %t: Count is too large for <=: PRIMARY_PORT :>: %1d, should be: %1d",
        $time, dut.counter, count1_exp1);
      $finish;
    end
<: } else  { :>
    exp_count_min[1] = count1_exp1 - min_offset1;
    exp_count_max[1] = count1_exp1 + max_offset1;
    exp_count_min[2] = count2_exp1 - min_offset2;
    exp_count_max[2] = count2_exp1 + max_offset2;
    exp_count_min[3] = count3_exp1 - min_offset3;
    exp_count_max[3] = count3_exp1 + max_offset3;
    exp_count_min[4] = count4_exp1 - min_offset4;
    exp_count_max[4] = count4_exp1 + max_offset4;
    exp_count_min[5] = count5_exp1 - min_offset5;
    exp_count_max[5] = count5_exp1 + max_offset5;
    exp_count_min[6] = count6_exp1 - min_offset6;
    exp_count_max[6] = count6_exp1 + max_offset6;
    exp_count_min[7] = count7_exp1 - min_offset7;
    exp_count_max[7] = count7_exp1 + max_offset7;
    for (ii = 1; ii <= <=: num_out_clks :>; ii = ii + 1) begin
      if (dut.counter[ii] < exp_count_min[ii]) begin
        $display("ERROR: %t: Count%1d is too small for <=: PRIMARY_PORT :>: %1d, should be: %1d",
          $time, ii, dut.counter[ii], exp_count_min[ii]);
        $finish;
      end
      if (dut.counter[ii] > exp_count_max[ii]) begin
        $display("ERROR: %t: Count%1d is too large for <=: PRIMARY_PORT :>: %1d, should be: %1d",
          $time, ii, dut.counter[ii], exp_count_max[ii]);
        $finish;
      end
    end
    $display("%t, <=: PRIMARY_PORT :> count values check out", $time);
<: } :>
<: } :>
<: if { $sv_test}  {  :>
    wait(oversample_done);
    #(PER1*5);
<: } :>
    $display("SIMULATION PASSED");
    $display("Test Completed Successfully");
    $display("SYSTEM_CLOCK_COUNTER : %0d\n",$time/PER1);
    $finish;
  end
 <: if { $use_locked}  {  :>
   always@(posedge <=: PRIMARY_PORT :>) begin
      timeout_counter <= timeout_counter + 1'b1;
      if (timeout_counter == 16'b1100000000000000) begin
         if (locked != 1'b1) begin
            $display("ERROR : NO LOCK signal");
            $display("SYSTEM_CLOCK_COUNTER : %0d\n",$time/PER1);
            $finish;
         end
      end
   end
<: } :>

initial
begin
   s_axi_awaddr = 11'b00000000000; 
   s_axi_araddr = 11'b00000000000; 
   s_axi_wdata = 32'h00000000;
   s_axi_awvalid = 1'b0;
   s_axi_wvalid = 1'b0;
   s_axi_wstrb = 4'b1111;
   s_axi_arvalid = 1'b0; //EOC_TB;
end  


  // Instantiation of the example design containing the clock
  //    network and sampling counters
  //---------------------------------------------------------
  <=: ComponentName :>_exdes 
    dut
   (
<: if { $c_has_AXI } { :>
    .s_axi_aclk      (s_axi_aclk),                    
    .s_axi_aresetn   (s_axi_aresetn),                    
    .s_axi_awaddr    (s_axi_awaddr),                    
    .s_axi_awvalid   (s_axi_awvalid),                    
    .s_axi_awready   (s_axi_awready),                    
    .s_axi_wdata     (s_axi_wdata),                    
    .s_axi_wstrb     (s_axi_wstrb),                    
    .s_axi_wvalid    (s_axi_wvalid),                    
    .s_axi_wready    (s_axi_wready),                    
    .s_axi_bresp     (s_axi_bresp),                    
    .s_axi_bvalid    (s_axi_bvalid),                    
    .s_axi_bready    (s_axi_bready),                    
    .s_axi_araddr    (s_axi_araddr),                    
    .s_axi_arvalid   (s_axi_arvalid),                    
    .s_axi_arready   (s_axi_arready),                    
    .s_axi_rdata     (s_axi_rdata),                    
    .s_axi_rresp     (s_axi_rresp),                    
    .s_axi_rvalid    (s_axi_rvalid),                    
    .s_axi_rready    (s_axi_rready),                    
<: } :>
<: if { $C_ENABLE_CLOCK_MONITOR}  { :>
<: if { $sel_PRIMITIVE != "None"}  { :>
  .ref_clk      (ref_clk),
<: } else  { :>
<: } :>
<: if { $C_ENABLE_USER_CLOCK0 && !$C_Enable_PLL0 } { :>
  .user_clk0    (user_clk0),
<: } :>
<: if { $C_ENABLE_USER_CLOCK1 && !$C_Enable_PLL1 } { :>
  .user_clk1   (user_clk1),
<: } :>
<: if { $C_ENABLE_USER_CLOCK2 } { :>
  .user_clk2    (user_clk2),
<: } :>
<: if { $C_ENABLE_USER_CLOCK3 } { :>
  .user_clk3   (user_clk3),
<: } :>
  .clk_stop    (clk_stop),
  .clk_oor     (clk_oor),
  .clk_glitch  (clk_glitch),
  .interrupt  (interrupt),
<: } :>
<: if { $use_inclk_switchover}  {  :>
<: if { $clkin2_diff}  {  :>
    .<=: SECONDARY_PORT :>_p          (<=: SECONDARY_PORT :>_p),
    .<=: SECONDARY_PORT :>_n          (<=: SECONDARY_PORT :>_n),
<: } else  { :>
    .<=: SECONDARY_PORT :>            (<=: SECONDARY_PORT :>),
<: } :>
    .clk_in_sel         (clk_in_sel),
<: } :>
<: if { ($mmcm_compensation != "INTERNAL")} { :>
<: if {( $ext_feedback && !$exdes_connectfb)  || $auto_ext_feedback}  {  :>
<: if { $auto_diff_feedback}  {  :>
    .clkfb_in_p         (clkfb_in_p),
    .clkfb_in_n         (clkfb_in_n),
<: } else  { :>
    .clkfb_in           (clkfb_in),
<: } :>
<: } :>
<: } :>
    // Reset for logic in example design
    .COUNTER_RESET      (COUNTER_RESET),
<: if { $is_plle3}  {  :>
<: if { $enable_clkoutphy}  {  :>
   .clkoutphy(clkoutphy_TB),
<: } :>
<: } :>
<: if {$mmcm_ss_en} { :>
<: if {($num_out_clks > 2)} { :>
    .CLK_OUT            (CLK_OUT_int),
<: } else  { :>
    .CLK_OUT            (CLK_OUT),
<: } :>
<: } else  { :>
    .CLK_OUT            (CLK_OUT),
<: } :>
    // High bits of the counters
<: if { $clkout_last_nodyn ||( $clkfbout_last_nodyn && $exdes_connectfb) }  {  :>
    .COUNT              (COUNT));
<: } else  { :>
    .COUNT              (COUNT),
<: } :>
<: if { $use_clkout1_bar}  {  :>
    .COUNTB_1           (COUNTB_1),
<: } :>
<: if { $use_clkout2_bar}  {  :>
    .COUNTB_2           (COUNTB_2),
<: } :>
<: if { $use_clkout3_bar}  {  :>
    .COUNTB_3           (COUNTB_3),
<: } :>
<: if { $use_clkout4_bar}  {  :>
    .COUNTB_4           (COUNTB_4),
<: } :>
<: if { ($mmcm_compensation != "INTERNAL")} { :>
<: if {( $ext_feedback && !$exdes_connectfb)  || $auto_ext_feedback}  {  :>
<: if { $auto_diff_feedback}  {  :>
    .clkfb_out_p        (clkfb_out_p),
<: if { $clkfbout_last_nodyn}  {  :>
    .clkfb_out_n        (clkfb_out_n));
<: } else  { :>
    .clkfb_out_n        (clkfb_out_n),
<: } :>
<: } else  { :>
<: if { $clkfbout_last_nodyn}  {  :>
    .clkfb_out          (clkfb_out));
<: } else  { :>
    .clkfb_out          (clkfb_out),
<: } :>
<: } :>
<: } :>
<: } :>
<: if { $has_control}  {  :>
    // Status and control signals
<: } :>
<: if { $use_reset && !$c_has_AXI}  {  :>
<: if { $reset_last}  {  :>
<: if { $reset_active_high}  {  :>
    .reset              (reset));
<: } else { :>
    .resetn             (resetn));
<: } :>
<: } else  { :>
<: if { $reset_active_high}  {  :>
    .reset              (reset),
<: } else { :>
    .resetn             (resetn),
<: } :>
<: } :>
<: } :>
<: if { $use_power_down}  {  :>
<: if { $power_down_last}  {  :>
    .power_down         (power_down));
<: } else  { :>
    .power_down         (power_down),
<: } :>
<: } :>
<: if { $use_freeze}  {  :>
<: if { $freeze_last}  {  :>
    .FREEZE             (FREEZE));
<: } else  { :>
    .FREEZE             (FREEZE),
<: } :>
<: } :>
<: if { $use_status}  {  :>
<: if { $status_last}  {  :>
    .STATUS             (STATUS));
<: } else  { :>
    .STATUS             (STATUS),
<: } :>
<: } :>
<: if { $use_inclk_stopped}  {  :>
<: if { $inclk_stopped_last}  {  :>
    .input_clk_stopped  (input_clk_stopped));
<: } else  { :>
    .input_clk_stopped  (input_clk_stopped),
<: } :>
<: } :>
<: if { $use_clkfb_stopped}  {  :>
<: if { $clkfb_stopped_last}  {  :>
    .clkfb_stopped  (clkfb_stopped));
<: } else  { :>
    .clkfb_stopped  (clkfb_stopped),
<: } :>
<: } :>
<: if { $use_locked}  {  :>
<: if { $locked_last}  {  :>
    .locked             (locked));
<: } else  { :>
    .locked             (locked),
<: } :>
<: } :>
<: if { $has_cddc}  {  :>
<: if { !$is_plle3}  {  :>
    .<=: cddcdone_port :>           (), 
    .<=: cddcreq_port :>            (1'b0),
<: } :>
<: } :>
<: if { $use_clk_valid}  {  :>
    .CLK_VALID          (CLK_VALID),
<: } :>
   // Clock in ports
<: if { $sel_PRIMITIVE != "None"}  { :>
<: if { $clkin1_diff}  {  :>
    .<=: PRIMARY_PORT :>_p          (<=: PRIMARY_PORT :>_p),
    .<=: PRIMARY_PORT :>_n          (<=: PRIMARY_PORT :>_n)
<: } else  { :>
    .<=: PRIMARY_PORT :>            (<=: PRIMARY_PORT :>)
<: } :>
<: } else  { :>
  .ref_clk      (ref_clk)
<: } :>
);
<: if {$mmcm_ss_en} { :>
<: if {($num_out_clks > 2)} { :>
   assign CLK_OUT[2:1] = CLK_OUT_int[2:1];
<: if {($num_out_clks > 4)} { :>
   assign CLK_OUT[4:3] = 2'b00;
   assign CLK_OUT[<=: num_out_clks :>:5] = CLK_OUT_int[<=: num_out_clks :> -2:3];
<: } :>
<: } :>
<: } :>
// Freq Check 
<:   if {$num_out_clks >= 1} { :>
initial
  prev_rise1 = 0;

always @(posedge CLK_OUT[1])
begin
  if (prev_rise1 != 0)
    period1 = $time - prev_rise1;
  prev_rise1 = $time;
end
<:   } :>
<:   if {$num_out_clks >= 2} { :>
initial
  prev_rise2 = 0;

always @(posedge CLK_OUT[2])
begin
  if (prev_rise2 != 0)
    period2 = $time - prev_rise2;
  prev_rise2 = $time;
end
<:   } :>
<:   if {(!$mmcm_ss_en) && ($num_out_clks >= 3)} { :>
initial
  prev_rise3 = 0;

always @(posedge CLK_OUT[3])
begin
  if (prev_rise3 != 0)
    period3 = $time - prev_rise3;
  prev_rise3 = $time;
end
<:   } :>
<:   if {(!$mmcm_ss_en) && ($num_out_clks >= 4)} { :>
initial
  prev_rise4 = 0;

always @(posedge CLK_OUT[4])
begin
  if (prev_rise4 != 0)
    period4 = $time - prev_rise4;
  prev_rise4 = $time;
end
<:   } :>
<:   if {$num_out_clks >= 5} { :>
initial
  prev_rise5 = 0;

always @(posedge CLK_OUT[5])
begin
  if (prev_rise5 != 0)
    period5 = $time - prev_rise5;
  prev_rise5 = $time;
end
<:   } :>
<:   if {$num_out_clks >= 6} { :>
initial
  prev_rise6 = 0;

always @(posedge CLK_OUT[6])
begin
  if (prev_rise6 != 0)
    period6 = $time - prev_rise6;
  prev_rise6 = $time;
end
<:   } :>
<:   if {$num_out_clks >= 7} { :>
initial
  prev_rise7 = 0;

always @(posedge CLK_OUT[7])
begin
  if (prev_rise7 != 0)
    period7 = $time - prev_rise7;
  prev_rise7 = $time;
end
<:   } :>

<: } else  { :>
<: if { $sv_test}  {  :>
  // hack to throw "good" specific value when something is not calculated
  localparam  XXX         = -1;
  localparam  undefined   = 1;
  localparam  N           = 50; // N/A == 50, which is the default
  localparam  A           = 1;
  localparam  NA          = 50;
<: } :>
  // timescale is 1ps/1ps
  localparam  ONE_NS      = 1000;
  localparam  PHASE_ERR_MARGIN   = 100; // 100ps
  // how many cycles to run
  localparam  COUNT_PHASE = 1024;
<: if { !$use_inclk_switchover}  {  :>
  // we'll be using the period in many locations
  localparam time PER1    = <=: clkin1_period :>*ONE_NS;
  localparam time PER1_1  = PER1/2;
  localparam time PER1_2  = PER1 - PER1/2;
<: } else  { :>
  // we'll be using the periods in many locations
  localparam time PER1    = <=: clkin1_period :>*ONE_NS;
  localparam time PER1_1  = PER1/2;
  localparam time PER1_2  = PER1 - PER1/2;
  localparam time PER2    = <=: clkin2_period :>*ONE_NS;
  localparam time PER3_3  = PER2/2;
  localparam time PER2_2  = PER2 - PER2/2;
<: } :>
<: ;#check values for local testing is :>
<: if { $sv_test}  {  :>
  // check the requested vs actual values for some level of equivalence
  localparam real clkout1_requested_out_freq   = <=: clkout1_requested_out_freq :>;
  localparam real clkout2_requested_out_freq   = <=: clkout2_requested_out_freq :>;
  localparam real clkout3_requested_out_freq   = <=: clkout3_requested_out_freq :>;
  localparam real clkout4_requested_out_freq   = <=: clkout4_requested_out_freq :>;
  localparam real clkout5_requested_out_freq   = <=: clkout5_requested_out_freq :>;
  localparam real clkout6_requested_out_freq   = <=: clkout6_requested_out_freq :>;
  localparam real clkout7_requested_out_freq   = <=: clkout7_requested_out_freq :>;
  localparam real clkout1_requested_phase      = <=: clkout1_requested_phase :>;
  localparam real clkout2_requested_phase      = <=: clkout2_requested_phase :>;
  localparam real clkout3_requested_phase      = <=: clkout3_requested_phase :>;
  localparam real clkout4_requested_phase      = <=: clkout4_requested_phase :>;
  localparam real clkout5_requested_phase      = <=: clkout5_requested_phase :>;
  localparam real clkout6_requested_phase      = <=: clkout6_requested_phase :>;
  localparam real clkout7_requested_phase      = <=: clkout7_requested_phase :>;
  localparam real clkout1_requested_duty_cycle = <=: clkout1_requested_duty_cycle :>;
  localparam real clkout2_requested_duty_cycle = <=: clkout2_requested_duty_cycle :>;
  localparam real clkout3_requested_duty_cycle = <=: clkout3_requested_duty_cycle :>;
  localparam real clkout4_requested_duty_cycle = <=: clkout4_requested_duty_cycle :>;
  localparam real clkout5_requested_duty_cycle = <=: clkout5_requested_duty_cycle :>;
  localparam real clkout6_requested_duty_cycle = <=: clkout6_requested_duty_cycle :>;
  localparam real clkout7_requested_duty_cycle = <=: clkout7_requested_duty_cycle :>;
  localparam real clkout1_out_freq             = <=: clkout1_out_freq :>;
  localparam real clkout2_out_freq             = <=: clkout2_out_freq :>;
  localparam real clkout3_out_freq             = <=: clkout3_out_freq :>;
  localparam real clkout4_out_freq             = <=: clkout4_out_freq :>;
  localparam real clkout5_out_freq             = <=: clkout5_out_freq :>;
  localparam real clkout6_out_freq             = <=: clkout6_out_freq :>;
  localparam real clkout7_out_freq             = <=: clkout7_out_freq :>;
  localparam real clkout1_phase                = <=: clkout1_phase :>;
  localparam real clkout2_phase                = <=: clkout2_phase :>;
  localparam real clkout3_phase                = <=: clkout3_phase :>;
  localparam real clkout4_phase                = <=: clkout4_phase :>;
  localparam real clkout5_phase                = <=: clkout5_phase :>;
  localparam real clkout6_phase                = <=: clkout6_phase :>;
  localparam real clkout7_phase                = <=: clkout7_phase :>;
  localparam real clkout1_duty_cycle           = <=: clkout1_duty_cycle :>;
  localparam real clkout2_duty_cycle           = <=: clkout2_duty_cycle :>;
  localparam real clkout3_duty_cycle           = <=: clkout3_duty_cycle :>;
  localparam real clkout4_duty_cycle           = <=: clkout4_duty_cycle :>;
  localparam real clkout5_duty_cycle           = <=: clkout5_duty_cycle :>;
  localparam real clkout6_duty_cycle           = <=: clkout6_duty_cycle :>;
  localparam real clkout7_duty_cycle           = <=: clkout7_duty_cycle :>;
  // this is a percent
  localparam real out_freq_offset              = 0.03;
  // FIXME converted to offset for now
  localparam real duty_cycle_range             = 12.50;
  // these both get coverted from fractional values
  localparam real phase_offset                 = 11.250;
  localparam real duty_cycle_offset            = 12.50;
  // for those extraneous "1"s that creep in due to reals
  localparam time rounding_error               = 1;

  // expected count = per in * num cycles / per out
  //                = ns * num_cycle / ns   ns = 1000/MHz
  //                = ns * num_cycle * MHz/1000.0 (use real to force real conversion)
  localparam real    count1_1ovrper =  <=: clkout1_out_freq :> / 1000.0 ;
  localparam real    count1_ratio   = <=: clkin1_period :> * count1_1ovrper;
  localparam integer count1_exp1    = count1_ratio * COUNT_PHASE;
  localparam time    count1_delay   = ONE_NS * clkout1_phase / count1_1ovrper;
  localparam real    count3_3ovrper =  <=: clkout2_out_freq :> / 1000.0 ;
  localparam real    count2_ratio   = <=: clkin1_period :> * count3_3ovrper;
  localparam integer count2_exp1    = count2_ratio * COUNT_PHASE;
  localparam time    count2_delay   = ONE_NS * clkout2_phase / count3_3ovrper;
  localparam real    count3_3ovrper =  <=: clkout3_out_freq :> / 1000.0 ;
  localparam real    count3_ratio   = <=: clkin1_period :> * count3_3ovrper;
  localparam integer count3_exp1    = count3_ratio * COUNT_PHASE;
  localparam time    count3_delay   = ONE_NS * clkout3_phase / count3_3ovrper;
  localparam real    count4_1ovrper =  <=: clkout4_out_freq :> / 1000.0 ;
  localparam real    count4_ratio   = <=: clkin1_period :> * count4_1ovrper;
  localparam integer count4_exp1    = count4_ratio * COUNT_PHASE;
  localparam time    count4_delay   = ONE_NS * clkout4_phase / count4_1ovrper;
  localparam real    count5_1ovrper =  <=: clkout5_out_freq :> / 1000.0 ;
  localparam real    count5_ratio   = <=: clkin1_period :> * count5_1ovrper;
  localparam integer count5_exp1    = count5_ratio * COUNT_PHASE;
  localparam time    count5_delay   = ONE_NS * clkout5_phase / count5_1ovrper;
  localparam real    count6_1ovrper =  <=: clkout6_out_freq :> / 1000.0 ;
  localparam real    count6_ratio   = <=: clkin1_period :> * count6_1ovrper;
  localparam integer count6_exp1    = count6_ratio * COUNT_PHASE;
  localparam time    count6_delay   = ONE_NS * clkout6_phase / count6_1ovrper;
  localparam real    count7_1ovrper =  <=: clkout7_out_freq :> / 1000.0 ;
  localparam real    count7_ratio   = <=: clkin1_period :> * count7_1ovrper;
  localparam integer count7_exp1    = count7_ratio * COUNT_PHASE;
  localparam time    count7_delay   = ONE_NS * clkout7_phase / count7_1ovrper;
  localparam min_offset1 = 3;
  localparam min_offset2 = 3;
  localparam min_offset3 = 3;
  localparam min_offset4 = 3;
  localparam min_offset5 = 3;
  localparam min_offset6 = 3;
  localparam min_offset7 = 3;
