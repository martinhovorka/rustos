<: ;#Component and file information :>
<: set ComponentName [getComponentNameString] :>
<: setOutputDirectory [ttcl_string_concat $ComponentName "/simulation"] :>
<: setFileName [ttcl_string_concat $ComponentName "_tb"] :>
<: setFileExtension ".v" :>
<: ;#all other variables :>
<#: ttcl/variables.ttcl :>
<: set comment "//" :>
// file: <=: ComponentName :>_tb.v
<#: ttcl/disclaimer.ttcl :>

<#: ttcl/tb_comments.ttcl :>

`timescale 1ps/1ps

<: ;#clk_valid is the superset of lock, use it when present :>
<: if { $use_clk_valid}  {  :>
`define wait_lock @(posedge CLK_VALID)
<: } elseif  { $use_locked}  { :>
`define wait_lock @(posedge locked)
<: } else  { :>
<: } :>

module <=: ComponentName :>_tb ();

<: if { $c_has_AXI && $use_dyn_reprog } { :>
  // timescale is 1ps/1ps
  localparam  ONE_NS      = 1000;
  localparam  PHASE_ERR_MARGIN   = 100; // 100ps
  // how many cycles to run
  localparam  COUNT_PHASE = 1024;
  localparam time PER_AXI = 10*ONE_NS;
<: if { $sv_test}  {  :>
  // hack to throw "good" specific value when something is not calculated
  localparam  XXX         = -1;
  localparam  undefined   = 1;
  localparam  N           = 50; // N/A == 50, which is the default
  localparam  A           = 1;
  localparam  NA          = 50;
<: } :>
  // timescale is 1ps/1ps
  // how many cycles to run
<: if { !$use_inclk_switchover}  {  :>
  // we'll be using the period in many locations
  localparam time PER1    = <=: clkin1_period :>*ONE_NS;
  localparam time PER1_1  = PER1/2;
  localparam time PER1_2  = PER1 - PER1/2;
<: } else  { :>
  // we'll be using the periods in many locations
  localparam time PER1    = <=: clkin1_period :>*ONE_NS;
  localparam time PER1_1  = PER1/2;
  localparam time PER1_2  = PER1 - PER1/2;
  localparam time PER2    = <=: clkin2_period :>*ONE_NS;
  localparam time PER3_3  = PER2/2;
  localparam time PER2_2  = PER2 - PER2/2;
<: } :>
<: ;#check values for local testing is :>
<: if { $sv_test}  {  :>
  // check the requested vs actual values for some level of equivalence
  localparam real clkout1_requested_out_freq   = <=: clkout1_requested_out_freq :>;
  localparam real clkout2_requested_out_freq   = <=: clkout2_requested_out_freq :>;
  localparam real clkout3_requested_out_freq   = <=: clkout3_requested_out_freq :>;
  localparam real clkout4_requested_out_freq   = <=: clkout4_requested_out_freq :>;
  localparam real clkout5_requested_out_freq   = <=: clkout5_requested_out_freq :>;
  localparam real clkout6_requested_out_freq   = <=: clkout6_requested_out_freq :>;
  localparam real clkout7_requested_out_freq   = <=: clkout7_requested_out_freq :>;
  localparam real clkout1_requested_phase      = <=: clkout1_requested_phase :>;
  localparam real clkout2_requested_phase      = <=: clkout2_requested_phase :>;
  localparam real clkout3_requested_phase      = <=: clkout3_requested_phase :>;
  localparam real clkout4_requested_phase      = <=: clkout4_requested_phase :>;
  localparam real clkout5_requested_phase      = <=: clkout5_requested_phase :>;
  localparam real clkout6_requested_phase      = <=: clkout6_requested_phase :>;
  localparam real clkout7_requested_phase      = <=: clkout7_requested_phase :>;
  localparam real clkout1_requested_duty_cycle = <=: clkout1_requested_duty_cycle :>;
  localparam real clkout2_requested_duty_cycle = <=: clkout2_requested_duty_cycle :>;
  localparam real clkout3_requested_duty_cycle = <=: clkout3_requested_duty_cycle :>;
  localparam real clkout4_requested_duty_cycle = <=: clkout4_requested_duty_cycle :>;
  localparam real clkout5_requested_duty_cycle = <=: clkout5_requested_duty_cycle :>;
  localparam real clkout6_requested_duty_cycle = <=: clkout6_requested_duty_cycle :>;
  localparam real clkout7_requested_duty_cycle = <=: clkout7_requested_duty_cycle :>;
  localparam real clkout1_out_freq             = <=: clkout1_out_freq :>;
  localparam real clkout2_out_freq             = <=: clkout2_out_freq :>;
  localparam real clkout3_out_freq             = <=: clkout3_out_freq :>;
  localparam real clkout4_out_freq             = <=: clkout4_out_freq :>;
  localparam real clkout5_out_freq             = <=: clkout5_out_freq :>;
  localparam real clkout6_out_freq             = <=: clkout6_out_freq :>;
  localparam real clkout7_out_freq             = <=: clkout7_out_freq :>;
  localparam real clkout1_phase                = <=: clkout1_phase :>;
  localparam real clkout2_phase                = <=: clkout2_phase :>;
  localparam real clkout3_phase                = <=: clkout3_phase :>;
  localparam real clkout4_phase                = <=: clkout4_phase :>;
  localparam real clkout5_phase                = <=: clkout5_phase :>;
  localparam real clkout6_phase                = <=: clkout6_phase :>;
  localparam real clkout7_phase                = <=: clkout7_phase :>;
  localparam real clkout1_duty_cycle           = <=: clkout1_duty_cycle :>;
  localparam real clkout2_duty_cycle           = <=: clkout2_duty_cycle :>;
  localparam real clkout3_duty_cycle           = <=: clkout3_duty_cycle :>;
  localparam real clkout4_duty_cycle           = <=: clkout4_duty_cycle :>;
  localparam real clkout5_duty_cycle           = <=: clkout5_duty_cycle :>;
  localparam real clkout6_duty_cycle           = <=: clkout6_duty_cycle :>;
  localparam real clkout7_duty_cycle           = <=: clkout7_duty_cycle :>;
  // this is a percent
  localparam real out_freq_offset              = 0.03;
  // FIXME converted to offset for now
  localparam real duty_cycle_range             = 12.50;
  // these both get coverted from fractional values
  localparam real phase_offset                 = 11.250;
  localparam real duty_cycle_offset            = 12.50;
  // for those extraneous "1"s that creep in due to reals
  localparam time rounding_error               = 1;

  // expected count = per in * num cycles / per out
  //                = ns * num_cycle / ns   ns = 1000/MHz
  //                = ns * num_cycle * MHz/1000.0 (use real to force real conversion)
  localparam real    count1_1ovrper =  <=: clkout1_out_freq :> / 1000.0 ;
  localparam real    count1_ratio   = <=: clkin1_period :> * count1_1ovrper;
  localparam integer count1_exp1    = count1_ratio * COUNT_PHASE;
  localparam time    count1_delay   = ONE_NS * clkout1_phase / count1_1ovrper;
  localparam real    count3_3ovrper =  <=: clkout2_out_freq :> / 1000.0 ;
  localparam real    count2_ratio   = <=: clkin1_period :> * count3_3ovrper;
  localparam integer count2_exp1    = count2_ratio * COUNT_PHASE;
  localparam time    count2_delay   = ONE_NS * clkout2_phase / count3_3ovrper;
  localparam real    count3_3ovrper =  <=: clkout3_out_freq :> / 1000.0 ;
  localparam real    count3_ratio   = <=: clkin1_period :> * count3_3ovrper;
  localparam integer count3_exp1    = count3_ratio * COUNT_PHASE;
  localparam time    count3_delay   = ONE_NS * clkout3_phase / count3_3ovrper;
  localparam real    count4_1ovrper =  <=: clkout4_out_freq :> / 1000.0 ;
  localparam real    count4_ratio   = <=: clkin1_period :> * count4_1ovrper;
  localparam integer count4_exp1    = count4_ratio * COUNT_PHASE;
  localparam time    count4_delay   = ONE_NS * clkout4_phase / count4_1ovrper;
  localparam real    count5_1ovrper =  <=: clkout5_out_freq :> / 1000.0 ;
  localparam real    count5_ratio   = <=: clkin1_period :> * count5_1ovrper;
  localparam integer count5_exp1    = count5_ratio * COUNT_PHASE;
  localparam time    count5_delay   = ONE_NS * clkout5_phase / count5_1ovrper;
  localparam real    count6_1ovrper =  <=: clkout6_out_freq :> / 1000.0 ;
  localparam real    count6_ratio   = <=: clkin1_period :> * count6_1ovrper;
  localparam integer count6_exp1    = count6_ratio * COUNT_PHASE;
  localparam time    count6_delay   = ONE_NS * clkout6_phase / count6_1ovrper;
  localparam real    count7_1ovrper =  <=: clkout7_out_freq :> / 1000.0 ;
  localparam real    count7_ratio   = <=: clkin1_period :> * count7_1ovrper;
  localparam integer count7_exp1    = count7_ratio * COUNT_PHASE;
  localparam time    count7_delay   = ONE_NS * clkout7_phase / count7_1ovrper;
  localparam min_offset1 = 3;
  localparam min_offset2 = 3;
  localparam min_offset3 = 3;
  localparam min_offset4 = 3;
  localparam min_offset5 = 3;
  localparam min_offset6 = 3;
  localparam min_offset7 = 3;
  localparam max_offset1 = 3;
  localparam max_offset2 = 3;
  localparam max_offset3 = 3;
  localparam max_offset4 = 3;
  localparam max_offset5 = 3;
  localparam max_offset6 = 3;
  localparam max_offset7 = 3;
  // declare all, only use what we need
  integer exp_count_max[1:7];
  integer exp_count_min[1:7];
  integer ii;
<: } :>
<: if { $C_ENABLE_CLOCK_MONITOR}  { :>
  localparam time PER_CLK_MON = <=: REF_CLK_PERIOD :>*ONE_NS;
  localparam time PER_CLK_MON_1  = PER_CLK_MON/2;
  localparam time PER_USER_CLK0 = <=: C_USER_CLK0_PERIOD :>*ONE_NS;
  localparam time PER_USER_CLK0_1  = PER_USER_CLK0/2;
  localparam time PER_USER_CLK1 = <=: C_USER_CLK1_PERIOD :>*ONE_NS;
  localparam time PER_USER_CLK1_1  = PER_USER_CLK1/2;
  localparam time PER_USER_CLK2 = <=: C_USER_CLK2_PERIOD :>*ONE_NS;
  localparam time PER_USER_CLK2_1  = PER_USER_CLK2/2;
  localparam time PER_USER_CLK3 = <=: C_USER_CLK3_PERIOD :>*ONE_NS;
  localparam time PER_USER_CLK3_1  = PER_USER_CLK3/2;
<: } :>

  // Declare the input clock signals
  reg         <=: PRIMARY_PORT :>     = 1;
<: if { $clkin1_diff}  {  :>
  wire        <=: PRIMARY_PORT :>_p   =  <=: PRIMARY_PORT :>;
  wire        <=: PRIMARY_PORT :>_n   = ~<=: PRIMARY_PORT :>;
<: } :>
<: if { $use_inclk_switchover}  {  :>
  reg         <=: SECONDARY_PORT :>     = 0;
  reg         clk_in_sel  = 1;
<: if { $clkin2_diff}  {  :>
  wire        <=: SECONDARY_PORT :>_p   =  <=: SECONDARY_PORT :>;
  wire        <=: SECONDARY_PORT :>_n   = ~<=: SECONDARY_PORT :>;
<: } :>
<: } :>
<: if { $C_ENABLE_CLOCK_MONITOR}  { :>
  reg  ref_clk = 1;
<: if { $C_ENABLE_USER_CLOCK0 && !$C_Enable_PLL0 } { :>
  reg  user_clk0 = 1;
<: } :>
<: if { $C_ENABLE_USER_CLOCK1 && !$C_Enable_PLL1 } { :>
  reg  user_clk1 = 1;
<: } :>
<: if { $C_ENABLE_USER_CLOCK2 } { :>
  reg  user_clk2 = 1;
<: } :>
<: if { $C_ENABLE_USER_CLOCK3 } { :>
  reg  user_clk3 = 1;
<: } :>
  wire [3 : 0] clk_stop;
  wire [3 : 0] clk_oor;
  wire [3 : 0] clk_glitch;
  wire interrupt;
<: } :>
<: if { $num_out_clks== 1}  {  :>

  // The high bit of the sampling counter
  wire        COUNT;
<: } elseif { ($num_out_clks > 2) && $mmcm_ss_en}  { :>
  wire [<=: num_out_clks :> -2:1]  COUNT;
<: } else  { :>

  // The high bits of the sampling counters
  wire [<=: num_out_clks :>:1]  COUNT;
<: } :>
<: if { $use_clkout1_bar}  {  :>
  wire        COUNTB_1;
<: } :>
<: if { $use_clkout2_bar}  {  :>
  wire        COUNTB_2;
<: } :>
<: if { $use_clkout3_bar}  {  :>
  wire        COUNTB_3;
<: } :>
<: if { $use_clkout4_bar}  {  :>
  wire        COUNTB_4;
<: } :>
<: if { ($mmcm_compensation != "INTERNAL")} { :>
<: if {( $ext_feedback && !$exdes_connectfb)  || $auto_ext_feedback}  {  :>
<: if { $auto_diff_feedback}  {  :>
  // Connect the feedback
  wire        clkfb_out_p;
  wire        clkfb_out_n;
  wire        clkfb_in_p   = clkfb_out_p;
  wire        clkfb_in_n   = clkfb_out_n;
<: } else  { :>
  // Connect the feedback
  wire        clkfb_out;
  wire        clkfb_in    = clkfb_out;
<: } :>
<: } :>
<: } :>
<: if { $use_reset || $use_power_down || $use_locked || $use_inclk_stopped || $use_clk_valid}  {  :>
  // Status and control signals
<: } :>
<: if { $use_reset && !$c_has_AXI}  {  :>
<: if { $reset_active_high}  {  :>
  reg         reset      = 0;
<: } else { :>
  reg         resetn     = 0;
<: } :>
<: } :>
<: if { $use_power_down}  {  :>
  reg         power_down = 0;
<: } :>
<: if { $use_freeze}  {  :>
  reg         FREEZE;
<: } :>
<: if { $use_status}  {  :>
  wire [2:<=: status_low :>]  STATUS;
<: } :>
<: if { $use_inclk_stopped}  {  :>
  wire        input_clk_stopped;
<: } :>
<: if { $use_locked}  {  :>
  wire        locked;
<: } :>
<: if { $use_clk_valid}  {  :>
  wire        CLK_VALID;
<: } :>
  reg         COUNTER_RESET = 0;
<: if { $use_clkfb_stopped}  {  :>
  wire        clkfb_stopped;
<: } :>
  reg [13:0]  timeout_counter = 14'b00000000000000;
<: if {$mmcm_ss_en} { :>
<: if {($num_out_clks > 2)} { :>
  wire [(<=: num_out_clks :> - 2) :1]   CLK_OUT_int;
<: } :>
<: if {($num_out_clks == 4)} { :>
  wire [<=: num_out_clks :>-2:1]   CLK_OUT;
<: } else { :>
  wire [<=: num_out_clks :>:1]   CLK_OUT;
<: } :>
<: } else { :>
  wire [<=: num_out_clks :>:1]   CLK_OUT;
<: } :>
<: if { $is_plle3}  {  :>
<: if { $enable_clkoutphy}  {  :>
  wire clkoutphy_TB;
<: } :>
<: } :>

  //  Declare the input clock signals
  reg s_axi_aclk      = 1'b0;
  reg s_axi_aresetn;
  reg [10:0] s_axi_awaddr;
  reg [31:0] s_axi_wdata;
  reg [3:0] s_axi_wstrb;
  reg s_axi_wvalid;
  reg s_axi_awvalid;
  reg s_axi_bready = 1'b1;
  reg [10:0] s_axi_araddr;
  reg s_axi_arvalid;
  reg s_axi_rready = 1'b1;
  wire s_axi_awready;
  wire s_axi_wready;
  wire [1:0] s_axi_bresp;
  wire s_axi_bvalid;
  wire s_axi_arready;
  wire [31:0] s_axi_rdata;
  wire [1:0] s_axi_rresp;
  wire s_axi_rvalid;

//Freq Check using the M & D values setting and actual Frequency generated
<:   if {$num_out_clks >= 1} { :>
  real period1;
<: if {!$is_plle2} { :>
  localparam ref_period1_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*2*1000/<=: mmcm_clkfbout_mult_f :>);
<: if {$use_inclk_switchover} { :>
  localparam ref_period1_clkin2 = (<=: mmcm_clkin2_period :>*<=: mmcm_divclk_divide :>*2*1000/<=: mmcm_clkfbout_mult_f :>);
<: } :>
<: } else { :>
  localparam ref_period1_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*2*1000/<=: mmcm_clkfbout_mult :>);
<: if {$use_inclk_switchover} { :>
  localparam ref_period1_clkin2 = (<=: mmcm_clkin2_period :>*<=: mmcm_divclk_divide :>*2*1000/<=: mmcm_clkfbout_mult :>);
<: } :>
<: } :>
  time prev_rise1;
<:   } :>
<:   if {$num_out_clks >= 2} { :>
  real period2;
<: if {!$is_plle2} { :>
<: if {!($mmcm_clkout1_divide == $mmcm_clkout0_divide_f && ($mmcm_clkout1_phase - $mmcm_clkout0_phase) == 180 && $mmcm_clkout1_duty_cycle == $mmcm_clkout0_duty_cycle && $mmcm_clkout1_use_fine_ps == $mmcm_clkout0_use_fine_ps) || $is_plle2}  {  :>
  localparam ref_period2_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*4*1000/<=: mmcm_clkfbout_mult_f :>);
<: } else { :>
  localparam ref_period2_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*2*1000/<=: mmcm_clkfbout_mult_f :>);
<: } :>
<: if {$use_inclk_switchover} { :>
  localparam ref_period2_clkin2 = (<=: mmcm_clkin2_period :>*<=: mmcm_divclk_divide :>*4*1000/<=: mmcm_clkfbout_mult_f :>);
<: } :>
<: } else { :>
<: if {!($mmcm_clkout1_divide == $mmcm_clkout0_divide && ($mmcm_clkout1_phase - $mmcm_clkout0_phase) == 180 && $mmcm_clkout1_duty_cycle == $mmcm_clkout0_duty_cycle && $mmcm_clkout1_use_fine_ps == $mmcm_clkout0_use_fine_ps) || $is_plle2}  {  :>
  localparam ref_period2_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*4*1000/<=: mmcm_clkfbout_mult :>);
<: } else { :>
  localparam ref_period2_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*2*1000/<=: mmcm_clkfbout_mult :>);
<: } :>
<: if {$use_inclk_switchover} { :>
  localparam ref_period2_clkin2 = (<=: mmcm_clkin2_period :>*<=: mmcm_divclk_divide :>*4*1000/<=: mmcm_clkfbout_mult :>);
<: } :>
<: } :>
  time prev_rise2;
<:   } :>
<:   if {(!$mmcm_ss_en) && ($num_out_clks >= 3)} { :>
  real period3;
<: if {!$is_plle2} { :>
  localparam ref_period3_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*8*1000/<=: mmcm_clkfbout_mult_f :>);
<: if {$use_inclk_switchover} { :>
  localparam ref_period3_clkin2 = (<=: mmcm_clkin2_period :>*<=: mmcm_divclk_divide :>*8*1000/<=: mmcm_clkfbout_mult_f :>);
<: } :>
<: } else { :>
  localparam ref_period3_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*8*1000/<=: mmcm_clkfbout_mult :>);
<: if {$use_inclk_switchover} { :>
  localparam ref_period3_clkin2 = (<=: mmcm_clkin2_period :>*<=: mmcm_divclk_divide :>*8*1000/<=: mmcm_clkfbout_mult :>);
<: } :>
<: } :>
  time prev_rise3;
<:   } :>
<:   if {(!$mmcm_ss_en) && ($num_out_clks >= 4)} { :>
  real period4;
<: if {!$is_plle2} { :>
  localparam ref_period4_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*16*1000/<=: mmcm_clkfbout_mult_f :>);
<: if {$use_inclk_switchover} { :>
  localparam ref_period4_clkin2 = (<=: mmcm_clkin2_period :>*<=: mmcm_divclk_divide :>*16*1000/<=: mmcm_clkfbout_mult_f :>);
<: } :>
<: } else { :>
  localparam ref_period4_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*16*1000/<=: mmcm_clkfbout_mult :>);
<: if {$use_inclk_switchover} { :>
  localparam ref_period4_clkin2 = (<=: mmcm_clkin2_period :>*<=: mmcm_divclk_divide :>*16*1000/<=: mmcm_clkfbout_mult :>);
<: } :>
<: } :>
  time prev_rise4;
<:   } :>
<:   if {$num_out_clks >= 5} { :>
  real period5;
<: if {!$is_plle2} { :>
<:   if {$mmcm_clkout4_cascade} { :>
<:   if {$num_out_clks >= 7 } { :>
  localparam ref_period5_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*8*2*1000/<=: mmcm_clkfbout_mult_f :>);
<: if {$use_inclk_switchover} { :>
  localparam ref_period5_clkin2 = (<=: mmcm_clkin2_period :>*<=: mmcm_divclk_divide :>*8*2*1000/<=: mmcm_clkfbout_mult_f :>);
<: } :>
<: } :>
<: } else { :>
  localparam ref_period5_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*8*1000/<=: mmcm_clkfbout_mult_f :>);
<: if {$use_inclk_switchover} { :>
  localparam ref_period5_clkin2 = (<=: mmcm_clkin2_period :>*<=: mmcm_divclk_divide :>*8*1000/<=: mmcm_clkfbout_mult_f :>);
<: } :>
<: } :>
<: } else { :>
  localparam ref_period5_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*8*1000/<=: mmcm_clkfbout_mult :>);
<: if {$use_inclk_switchover} { :>
  localparam ref_period5_clkin2 = (<=: mmcm_clkin2_period :>*<=: mmcm_divclk_divide :>*8*1000/<=: mmcm_clkfbout_mult :>);
<: } :>
<: } :>
  time prev_rise5;
<:   } :>
<:   if {$num_out_clks >= 6} { :>
  real period6;
<: if {!$is_plle2} { :>
  localparam ref_period6_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*4*1000/<=: mmcm_clkfbout_mult_f :>);
<: if {$use_inclk_switchover} { :>
  localparam ref_period6_clkin2 = (<=: mmcm_clkin2_period :>*<=: mmcm_divclk_divide :>*4*1000/<=: mmcm_clkfbout_mult_f :>);
<: } :>
<: } else { :>
  localparam ref_period6_clkin1 = (<=: mmcm_clkin1_period :>*<=: mmcm_divclk_divide :>*4*1000/<=: mmcm_clkfbout_mult :>);
<: if {$use_inclk_switchover} { :>
