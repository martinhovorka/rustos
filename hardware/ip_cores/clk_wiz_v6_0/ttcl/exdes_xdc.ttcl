<: ;#Component and file information :>
<: set ComponentName [getComponentNameString] :>
<: setOutputDirectory [ttcl_string_concat $ComponentName "/example_design"] :>
<: setFileName [ttcl_string_concat $ComponentName "_exdes"] :>
<: setFileExtension ".xdc" :>
<: ;#all other variables :>
<#: ttcl/variables.ttcl :>
<: set comment "#" :>
# file: <=: ComponentName :>_exdes.xdc
<#: ttcl/disclaimer.ttcl :>
<: set c_num_out_clks [getIntValue "C_NUM_OUT_CLKS"] :>
<: set c_use_spread_spectrum [getIntValue "C_USE_SPREAD_SPECTRUM"] :>
<: set use_clkout1_bar [getIntValue "C_USE_CLKOUT1_BAR"] :>
<: set use_clkout2_bar [getIntValue "C_USE_CLKOUT2_BAR"] :>

# Input clock periods. These duplicate the values entered for the
#  input clocks. You can use these to time your system
#----------------------------------------------------------------
<: if {  [string equal -nocase $clkin1_buf "No_buffer"] || [string equal -nocase $clkin1_buf "Global_buffer"]}  {  :>
<: if { $clkin1_diff}  {  :>
# Differential clock only needs one constraint
create_clock -name <=: PRIMARY_PORT :>_p -period <=: clkin1_period :> [get_ports <=: PRIMARY_PORT :>_p]
set_input_jitter <=: PRIMARY_PORT :>_p <=: clkin1_jitter_ns :>
<: } else  { :>
create_clock -name <=: PRIMARY_PORT :> -period <=: clkin1_period :> [get_ports <=: PRIMARY_PORT :>]
set_input_jitter <=: PRIMARY_PORT :> <=: clkin1_jitter_ns :>
<: } :>
<: } :>
<: if { $use_inclk_switchover}  {  :>
<: if { $clkin2_diff}  {  :>
<: if { [string equal -nocase $clkin2_buf "No_buffer"] || [string equal -nocase $clkin2_buf "Global_buffer"]}  {  :>
# Differential clock only needs one constraint
create_clock -name <=: SECONDARY_PORT :>_p -period <=: clkin2_period :> [get_ports <=: SECONDARY_PORT :>_p]
set_input_jitter <=: SECONDARY_PORT :>_p <=: clkin2_jitter_ns :>
<: } :>
<: if { ![string equal -nocase $clkin2_buf "No_buffer"]}  {  :>

<: if { $clkin1_diff}  {  :>
set_clock_groups -physically_exclusive -group [get_clocks -include_generated_clocks  [get_clocks <=: PRIMARY_PORT :>_p]] -group [get_clocks -include_generated_clocks  [get_clocks <=: SECONDARY_PORT :>_p]]
<: } else  { :>
set_clock_groups -physically_exclusive -group [get_clocks -include_generated_clocks  [get_clocks <=: PRIMARY_PORT :>]] -group [get_clocks -include_generated_clocks  [get_clocks <=: SECONDARY_PORT :>_p]]
<: } :>

<: } :>

<: } else  { :>
<: if { [string equal -nocase $clkin2_buf "No_buffer"] || [string equal -nocase $clkin2_buf "Global_buffer"]}  {  :>
create_clock -name <=: SECONDARY_PORT :> -period <=: clkin2_period :> [get_ports <=: SECONDARY_PORT :>]
set_input_jitter <=: SECONDARY_PORT :> <=: clkin2_jitter_ns :>
<: } :>
<: if { ![string equal -nocase $clkin2_buf "No_buffer"]}  {  :>

<: if { $clkin1_diff}  {  :>
set_clock_groups -physically_exclusive -group [get_clocks -include_generated_clocks  [get_clocks <=: PRIMARY_PORT :>_p]] -group [get_clocks -include_generated_clocks  [get_clocks <=: SECONDARY_PORT :>]]
<: } else  { :>
set_clock_groups -physically_exclusive -group [get_clocks -include_generated_clocks  [get_clocks <=: PRIMARY_PORT :>]] -group [get_clocks -include_generated_clocks  [get_clocks <=: SECONDARY_PORT :>]]
<: } :>

<: } :>
<: } :>
<: } :>
<: if { ($mmcm_compensation != "INTERNAL")} { :>
<: if {( $ext_feedback && !$exdes_connectfb)  || $auto_ext_feedback}  {  :>
# external feedback constraints
# Change delay numbers as per requirement 
<: if { $auto_diff_feedback}  {  :>
set_external_delay -from [get_ports clkfb_out_p] -to [get_ports clkfb_in_p] -min 0.1 
set_external_delay -from [get_ports clkfb_out_p] -to [get_ports clkfb_in_p] -max 0.11 
set_external_delay -from [get_ports clkfb_out_n] -to [get_ports clkfb_in_n] -min 0.1 
set_external_delay -from [get_ports clkfb_out_n] -to [get_ports clkfb_in_n] -max 0.11 
<: } else  { :>
set_external_delay -from [get_ports clkfb_out] -to [get_ports clkfb_in] -min 0.1 
set_external_delay -from [get_ports clkfb_out] -to [get_ports clkfb_in] -max 0.11 
<: } :>
<: } :>
<: } :>
<: if { $c_has_AXI } { :>

create_clock -period 10 [get_ports s_axi_aclk]
<: if { $C_ENABLE_CLOCK_MONITOR } { :>
create_clock -period <=: REF_CLK_PERIOD :> [get_ports ref_clk]
<: if { $C_ENABLE_USER_CLOCK0 && !$C_Enable_PLL0 } { :>
create_clock -period <=: C_USER_CLK0_PERIOD :> [get_ports user_clk0]
<: } :>
<: if { $C_ENABLE_USER_CLOCK1 && !$C_Enable_PLL1 } { :>
create_clock -period <=: C_USER_CLK1_PERIOD :> [get_ports user_clk1]
 <: } :>
<: if { $C_ENABLE_USER_CLOCK2 } { :>
create_clock -period <=: C_USER_CLK2_PERIOD :> [get_ports user_clk2]
<: } :>
<: if { $C_ENABLE_USER_CLOCK3 } { :>
create_clock -period <=: C_USER_CLK3_PERIOD :> [get_ports user_clk3]
<: } :>
<: } :>

<: if { $c_num_out_clks == 7 } { :>

set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out1_port :>]]
set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out2_port :>]]
<: if { $c_use_spread_spectrum } { :>
<: } else  { :>
set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out3_port :>]]
set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out4_port :>]]
<: } :>
set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out5_port :>]]
set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out6_port :>]]
set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out7_port :>]]

<: } elseif { $c_num_out_clks == 6 }  { :>

set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out1_port :>]]
set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out2_port :>]]
<: if { $c_use_spread_spectrum } { :>
<: } else  { :>
set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out3_port :>]]
set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out4_port :>]]
<: } :>
set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out5_port :>]]
set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out6_port :>]]

<: } elseif { $c_num_out_clks == 5 }  { :>

set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out1_port :>]]
set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out2_port :>]]
<: if { $c_use_spread_spectrum } { :>
<: } else  { :>
set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out3_port :>]]
set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out4_port :>]]
<: } :>
set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out5_port :>]]

<: } elseif { $c_num_out_clks == 4 }  { :>

set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out1_port :>]]
set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out2_port :>]]
<: if { $c_use_spread_spectrum } { :>
<: } else  { :>
set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out3_port :>]]
set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out4_port :>]]
<: } :>

<: } elseif { $c_num_out_clks == 3 }  { :>

set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out1_port :>]]
set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out2_port :>]]
<: if { $c_use_spread_spectrum } { :>
<: } else  { :>
set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out3_port :>]]
<: } :>

<: } elseif { $c_num_out_clks == 2 }  { :>

set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out1_port :>]]
set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out2_port :>]]

<: } else  { :>

set_false_path -from [get_clocks s_axi_aclk] -to [get_clocks -of_objects [get_pins -hier CLK_CORE_DRP_I/<=: out1_port :>]]

<: } :>

<: } :>

