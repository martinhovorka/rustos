<: ;#Component and file information :>
<: set ComponentName [getComponentNameString] :>
<: setOutputDirectory "./" :>
<: set window [getIntValue "C_ENABLE_WINDOW_WDT"] :>
<: set sst_interval [getIntValue "C_SST_COUNT_WIDTH"] :>
<: setFileName [ttcl_string_concat "atg_addr"] :>
<: setFileExtension ".coe" :>
; SG initialization file for a
