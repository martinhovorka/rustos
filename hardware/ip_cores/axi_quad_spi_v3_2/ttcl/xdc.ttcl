<: ;#Component and file information :>
<: set ComponentName [getComponentNameString] :>
<: setOutputDirectory "./" :>
<: setFileName $ComponentName :>
<: setFileExtension ".xdc" :>
<: set c_family [getStringValue "C_FAMILY"] :>
<: set enable_sync [getIntValue "Async_Clk"] :>
<: set xip_mode [getIntValue "C_XIP_MODE"] :>
<: set sck_ratio [get_property PARAM_VALUE.C_SCK_RATIO ] :>
<: set spi_mode [get_property PARAM_VALUE.C_SPI_MODE ] :>
<: set uc_family [get_property PARAM_VALUE.UC_FAMILY ] :>
<: set enh_mode [getIntValue "C_TYPE_OF_AXI4_INTERFACE"] :>
<: set fifo_exists [get_property PARAM_VALUE.FIFO_INCLUDED ] :>
<: set start_up [get_property PARAM_VALUE.C_USE_STARTUP ] :>
<: set start_up_int [get_property PARAM_VALUE.C_USE_STARTUP_INT ] :>
<: set dual_mode [get_property PARAM_VALUE.C_DUAL_QUAD_MODE ] :>
<: set start_up_ext [get_property MODELPARAM_VALUE.C_USE_STARTUP_EXT ] :>
<: set axi4_intf [getIntValue "C_TYPE_OF_AXI4_INTERFACE"] :>
<: if {($c_family == "virtexuplus" || $c_family == "kintexuplus" || $c_family == "zynquplus" || $c_family == "zynquplusrfsoc" || $c_family == "virtexuplusHBM")} { :>
<: set is_usp_device 1 :>
<: } else { :>
<: set is_usp_device 0 :>
<: } :>
<: set enable_fifo_xdc 0 :>
