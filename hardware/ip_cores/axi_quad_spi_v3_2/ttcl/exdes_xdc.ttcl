<: set ComponentName [getComponentNameString] :>
<: setOutputDirectory [ttcl_string_concat $ComponentName "/example_design"] :>
<: setFileName "exdes" :>
<: set wd [ file dirname [ get_property xml_file_name [ current_ipbom ] ] ] :>
<: setFileExtension ".xdc" :>
<: set dev_family [getProjectFamily] :>
<: set dev_speed [getProjectSpeedGrade] :>
<: set c_family [getStringValue "c_family"] :>
<: set uc_family [get_property PARAM_VALUE.UC_FAMILY ] :>
<: set start_up [get_property PARAM_VALUE.C_USE_STARTUP] :>
<: set start_up_int [get_property PARAM_VALUE.C_USE_STARTUP_INT ] :>
<: if {($c_family == "virtexuplus" || $c_family == "kintexuplus" || $c_family == "zynquplus" || $c_family == "zynquplusrfsoc" || $c_family == "virtexuplusHBM")} { :>
<: set is_usp_device 1 :>
<: } else { :>
<: set is_usp_device 0 :>
<: } :>
<: if {$c_family == "kintex7" || $c_family == "virtex7" || $c_family == "zynq" || $c_family == "artix7" || $c_family == "spartan7"} { :> 
<: set is_7s_device 1 :>
<: } else { :>
<: set is_7s_device 0 :>
<: } :>
<: set C_SCK_RATIO  [get_property MODELPARAM_VALUE.C_SCK_RATIO ] :>
<: set Master_mode  [get_property PARAM_VALUE.Master_mode ] :>
<: set C_DUAL_QUAD_MODE  [get_property PARAM_VALUE.C_DUAL_QUAD_MODE ] :>
